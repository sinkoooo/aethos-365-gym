    function getDayPlan(day) {
      const month = Math.min(12, Math.floor((day - 1) / 30) + 1);
      const week = Math.floor((day - 1) / 7) + 1;
      const dayOfWeek = ((day - 1) % 7) + 1;

      let phaseNum = 1, phaseName = "Phase 1: Body Base", bpClass = "bp-1", equipText = "Zero Equipment ($0)";
      if (day >= 31 && day <= 60) {
        phaseNum = 2; phaseName = "Phase 2: Band Hypertrophy"; bpClass = "bp-2"; equipText = "Loop Bands + Anchor";
      } else if (day >= 61 && day <= 90) {
        phaseNum = 3; phaseName = "Phase 3: Rings & Calisthenics"; bpClass = "bp-3"; equipText = "Pull-Up Bar + Rings";
      } else if (day >= 91) {
        phaseNum = 4; phaseName = "Phase 4: Dumbbells & Bench"; bpClass = "bp-4"; equipText = "Dumbbells + Bench";
      }

      const isDeload = (week % 7 === 0);
      let setQty = isDeload ? 2 : 3;

      // Check Readiness Autoregulation
      const energyLevel = dailyReadiness[day] || 'norm';
      if (energyLevel === 'low') {
        setQty = Math.max(2, setQty - 1); // Auto-scale back by 1 set on low recovery days
      }

      if (dayOfWeek === 7) {
        return {
          day, month, week, phaseName, bpClass, equipText,
          workoutName: "Total Rest & Neuro-Muscular Regeneration",
          subtitle: `Month ${month} • Week ${week} • Sunday Rest Protocol`,
          isRest: true,
          exercises: []
        };
      } else if (dayOfWeek === 2 || dayOfWeek === 4) {
        return {
          day, month, week, phaseName, bpClass, equipText,
          workoutName: "Active Recovery: 35-Min Brisk Walk & Hip Mobility",
          subtitle: `Month ${month} • Week ${week} • Zone 2 Cardio & Synovial Fluid Flush`,
          isRecovery: true,
          exercises: []
        };
      } else if (dayOfWeek === 6) {
        return {
          day, month, week, phaseName, bpClass, equipText,
          workoutName: "Spine Decompression, Joint Alignment & Core Flow",
          subtitle: `Month ${month} • Week ${week} • Saturday Postural Reset`,
          exercises: [
            { key: 'dead_bug', sets: 3, reps: '8/side', defWt: '0' },
            { key: 'plank', sets: 3, reps: '30s hold', defWt: '0' },
            { key: 'glute_bridges', sets: 3, reps: '15 reps', defWt: '0' }
          ]
        };
      }

      let workoutName = "";
      let exercises = [];

      if (phaseNum === 1) {
        if (dayOfWeek === 1 || dayOfWeek === 5) {
          workoutName = "Workout A: Foundation Push, Squat & Core Stability";
          exercises = [
            { key: 'box_squats', sets: setQty, reps: '10–12', defWt: '0' },
            { key: 'incline_pushups', sets: setQty, reps: '8–10', defWt: '0' },
            { key: 'glute_bridges', sets: setQty, reps: '12–15', defWt: '0' },
            { key: 'doorframe_rows', sets: setQty, reps: '10–12', defWt: '0' },
            { key: 'dead_bug', sets: setQty, reps: '8/side', defWt: '0' }
          ];
        } else {
          workoutName = "Workout B: Hinge Mechanics & Single-Leg Balance";
          exercises = [
            { key: 'wall_hinge', sets: setQty, reps: '10–12', defWt: '0' },
            { key: 'reverse_lunge', sets: setQty, reps: '6–8/leg', defWt: '0' },
            { key: 'doorframe_rows', sets: setQty, reps: '10–12', defWt: '0' },
            { key: 'plank', sets: setQty, reps: '25–30s', defWt: '0' }
          ];
        }
      } else if (phaseNum === 2) {
        if (dayOfWeek === 1 || dayOfWeek === 5) {
          workoutName = "Workout A: Banded Hypertrophy & Upper Push-Pull";
          exercises = [
            { key: 'box_squats', sets: setQty, reps: '12–15', defWt: '0' },
            { key: 'incline_pushups', sets: setQty, reps: '10–12', defWt: '0' },
            { key: 'band_lat_pulldown', sets: setQty, reps: '10–12', defWt: 'Band' },
            { key: 'band_face_pull', sets: setQty, reps: '12–15', defWt: 'Band' },
            { key: 'dead_bug', sets: setQty, reps: '8/side', defWt: '0' }
          ];
        } else {
          workoutName = "Workout B: Banded Hinge & Unilateral Strength";
          exercises = [
            { key: 'wall_hinge', sets: setQty, reps: '12–15', defWt: '0' },
            { key: 'reverse_lunge', sets: setQty, reps: '8–10/leg', defWt: '0' },
            { key: 'band_face_pull', sets: setQty, reps: '15', defWt: 'Band' },
            { key: 'glute_bridges', sets: setQty, reps: '15', defWt: '0' },
            { key: 'plank', sets: setQty, reps: '35s', defWt: '0' }
          ];
        }
      } else if (phaseNum === 3) {
        if (dayOfWeek === 1 || dayOfWeek === 5) {
          workoutName = "Workout A: Ring Calisthenics & Squat Strength";
          exercises = [
            { key: 'box_squats', sets: setQty, reps: '15', defWt: '0' },
            { key: 'ring_inverted_rows', sets: setQty, reps: '8–10', defWt: 'Body' },
            { key: 'incline_pushups', sets: setQty, reps: '12', defWt: 'Body' },
            { key: 'dead_hang', sets: setQty, reps: '30s', defWt: 'Body' },
            { key: 'dead_bug', sets: setQty, reps: '10/side', defWt: '0' }
          ];
        } else {
          workoutName = "Workout B: Decompression & Lower Stability";
          exercises = [
            { key: 'reverse_lunge', sets: setQty, reps: '10/leg', defWt: '0' },
            { key: 'wall_hinge', sets: setQty, reps: '15', defWt: '0' },
            { key: 'ring_inverted_rows', sets: setQty, reps: '8–10', defWt: 'Body' },
            { key: 'dead_hang', sets: setQty, reps: '35s', defWt: 'Body' }
          ];
        }
      } else {
        if (dayOfWeek === 1 || dayOfWeek === 5) {
          workoutName = "Workout A: Loaded Dumbbell Compound Hypertrophy";
          exercises = [
            { key: 'goblet_squat', sets: setQty, reps: '8–10', defWt: '12kg' },
            { key: 'incline_db_press', sets: setQty, reps: '8–10', defWt: '10kg' },
            { key: 'chest_supported_row', sets: setQty, reps: '10–12', defWt: '10kg' },
            { key: 'dead_hang', sets: setQty, reps: '40s', defWt: 'Body' },
            { key: 'dead_bug', sets: setQty, reps: '10/side', defWt: '0' }
          ];
        } else {
          workoutName = "Workout B: Loaded Posterior & Unilateral Hypertrophy";
          exercises = [
            { key: 'db_rdl', sets: setQty, reps: '8–10', defWt: '14kg' },
            { key: 'reverse_lunge', sets: setQty, reps: '8/leg', defWt: '8kg' },
            { key: 'chest_supported_row', sets: setQty, reps: '10–12', defWt: '10kg' },
            { key: 'plank', sets: setQty, reps: '45s', defWt: '0' }
          ];
        }
      }

      if (isDeload) workoutName += " (Deload Active Recovery Week)";
      if (energyLevel === 'low') workoutName += " [Autoscaled Volume]";

      return {
        day, month, week, phaseName, bpClass, equipText,
        workoutName,
        subtitle: `Month ${month} • Week ${week} • Duration: 35–40 mins • Joint Priority: High`,
        exercises
      };
    }

    // ==========================================
    // RENDER FUNCTIONS
    // ==========================================

    function renderActiveDay(day) {
      currentDay = parseInt(day, 10);
      matrixViewMonth = Math.min(12, Math.floor((currentDay - 1) / 30) + 1);
      const plan = getDayPlan(currentDay);

      document.getElementById('dayInput').value = currentDay;
      document.getElementById('daySlider').value = currentDay;
      document.getElementById('dayTitlePrefix').innerText = `Day ${currentDay}`;
      document.getElementById('workoutTitle').innerText = plan.workoutName;
      document.getElementById('workoutMeta').innerText = plan.subtitle;

      const pTag = document.getElementById('phaseTag');
      pTag.className = `badge-phase ${plan.bpClass}`;
      pTag.innerText = plan.phaseName;

      const isDone = completedDays.has(currentDay);
      const btnMark = document.getElementById('btnMarkDay');
      const markText = document.getElementById('markText');
      const markIcon = document.getElementById('markIcon');

      if (isDone) {
        btnMark?.classList.add('completed');
        if (markText) markText.innerText = 'Completed! (Click to Undo)';
        if (markIcon) markIcon.innerText = '★';
      } else {
        btnMark?.classList.remove('completed');
        if (markText) markText.innerText = 'Complete Day';
        if (markIcon) markIcon.innerText = '✓';
      }

      // Sync floating quick action dock button
      const floatBtnMark = document.getElementById('floatBtnMarkDay');
      const floatMarkIcon = document.getElementById('floatMarkIcon');
      const floatMarkText = document.getElementById('floatMarkText');
      if (floatBtnMark) {
        if (isDone) {
          floatBtnMark.style.background = 'linear-gradient(135deg, #10b981, #059669)';
          if (floatMarkIcon) floatMarkIcon.innerText = '★';
          if (floatMarkText) floatMarkText.innerText = 'Completed!';
        } else {
          floatBtnMark.style.background = 'linear-gradient(135deg, #00f2fe, #0077ff)';
          if (floatMarkIcon) floatMarkIcon.innerText = '✓';
          if (floatMarkText) floatMarkText.innerText = 'Complete Day';
        }
      }

      checkAdvanceEquipmentAlert(currentDay);
      renderExerciseCards(plan);
      updateHeatmap(plan);
      updateStats(plan);
      renderWaterTracker();
      updateReadinessUI();
      renderHeatmapGrid();
    GymMusic.updateUI();
      updatePhotoUIForDay(currentDay);
      updateMissionChecklist();
      speakAnnouncement(`Day ${currentDay}. ${plan.workoutName}`);
    }

    function checkAdvanceEquipmentAlert(day) {
      const radar = document.getElementById('equipmentRadar');
      let active = null;
      let diff = 0;

      for (const m of MILESTONES) {
        if (day >= (m.startDay - 5) && day < m.startDay) {
          active = m;
          diff = m.startDay - day;
          break;
        }
      }

      if (active) {
        radar.style.display = 'block';
        document.getElementById('radarDaysLeft').innerText = `⚠️ ${diff} DAY${diff > 1 ? 'S' : ''} UNTIL MONTH ${Math.floor((active.startDay-1)/30)+1}`;
        document.getElementById('radarTitle').innerText = `Acquire: ${active.name}`;
        document.getElementById('radarDesc').innerHTML = `<strong>Why now?</strong> ${active.desc} (${active.cost})`;
        document.getElementById('radarSpecs').innerHTML = `<strong>Exact Specs:</strong> ${active.specs}`;
        document.getElementById('radarBuyLink').href = `https://www.amazon.in/s?k=${active.query}`;
      } else {
        radar.style.display = 'none';
      }
    }

    function renderExerciseCards(plan) {
      const flow = document.getElementById('exerciseCardsFlow');
      flow.innerHTML = '';

      if (plan.isRest) {
        flow.innerHTML = `
          <div style="background: var(--bg-card); padding: 36px; border-radius: var(--radius-lg); text-align: center;">
            <div style="font-size: 2.8rem; margin-bottom: 10px;">😴</div>
            <h3 style="color: #fff; margin-bottom: 8px;">Rest & Hypertrophy Supercompensation Day</h3>
            <p style="color: var(--text-muted); max-width: 620px; margin: 0 auto; font-size: 0.95rem;">
              Muscle protein synthesis and connective tissue rebuilding take place strictly during deep sleep and rest. Drink 3.5L of water, hit your 145g+ protein target, and prepare for tomorrow's session.
            </p>
          </div>
        `;
        return;
      }

      if (plan.isRecovery) {
        flow.innerHTML = `
          <div style="background: var(--bg-card); padding: 26px; border-radius: var(--radius-lg);">
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 14px;">
              <span style="font-size: 2.4rem;">🚶</span>
              <div>
                <h3 style="color: #fff;">Zone 2 Brisk Walk + Hip Capsule Decompression</h3>
                <p style="color: var(--text-muted); font-size: 0.88rem;">35 minutes of steady walking flushes lactic acid and keeps 6'0" knees fluid.</p>
              </div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-top: 14px;">
              <div style="background: rgba(0,0,0,0.3); padding: 14px; border-radius: var(--radius-sm); border: 1px solid var(--border);">
                <strong style="color: var(--cyan);">1. 7,500 Step Target</strong>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Pace where nasal breathing is comfortable.</p>
              </div>
              <div style="background: rgba(0,0,0,0.3); padding: 14px; border-radius: var(--radius-sm); border: 1px solid var(--border);">
                <strong style="color: var(--emerald);">2. 90/90 Hip Switches</strong>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">2 minutes on floor opening internal hip rotation.</p>
              </div>
            </div>
          </div>
        `;
        return;
      }

      plan.exercises.forEach((item, idx) => {
        const baseEx = CATALOG[item.key] || CATALOG['box_squats'];
        const progKey = `prog_${item.key}`;
        const currentProg = userProgressions[progKey] || 'std';

        let activeName = baseEx.name;
        let activeCues = baseEx.cues;
        let activeSearch = baseEx.searchQuery;

        if (currentProg === 'easy' && baseEx.easier) {
          activeName = baseEx.easier.name;
          activeCues = baseEx.easier.cues;
          activeSearch = baseEx.easier.searchQuery;
        } else if (currentProg === 'hard' && baseEx.harder) {
          activeName = baseEx.harder.name;
          activeCues = baseEx.harder.cues;
          activeSearch = baseEx.harder.searchQuery;
        }

        const card = document.createElement('div');
        card.className = 'pro-ex-card';

        let cuesList = '';
        for (const [title, cue] of Object.entries(activeCues)) {
          cuesList += `<div><strong>${title}:</strong> ${cue}</div>`;
        }

        let setRows = '';
        for (let s = 1; s <= item.sets; s++) {
          const logKey = `d${currentDay}_ex${item.key}_s${s}`;
          const defaultReps = item.reps || '10';
          const defaultWt = item.defWt || '0';
          let savedLog = loggedSetData[logKey];
          if (!savedLog) {
            savedLog = { wt: defaultWt, reps: defaultReps, done: false };
          } else if (!savedLog.userCustom && savedLog.reps === '10' && defaultReps !== '10') {
            // Heal legacy '10' default fallback so true target reps (e.g. '8/side') is displayed accurately
            savedLog.reps = defaultReps;
          }

          setRows += `
            <tr>
              <td style="font-weight: 600; color: #cbd5e1;">Set ${s}</td>
              <td>
                <input type="text" class="log-input log-input-wt" value="${savedLog.wt}" placeholder="${defaultWt}" onchange="saveSetLog('${logKey}', 'wt', this.value, '${defaultReps}', '${defaultWt}')" aria-label="Load for Set ${s}">
              </td>
              <td>
                <input type="text" class="log-input log-input-reps" value="${savedLog.reps}" placeholder="${defaultReps}" title="Target: ${defaultReps}" onchange="saveSetLog('${logKey}', 'reps', this.value, '${defaultReps}', '${defaultWt}')" aria-label="Reps for Set ${s}">
              </td>
              <td style="text-align: right;">
                <button class="btn-check-set ${savedLog.done ? 'done' : ''}" onclick="toggleSetDone(this, '${logKey}', '${defaultReps}', '${defaultWt}')">
                  ${savedLog.done ? '✓ Logged' : 'Log Set'}
                </button>
              </td>
            </tr>
          `;
        }

        card.innerHTML = `
          <div class="ex-header-row">
            <div class="ex-title-wrap">
              <span class="ex-title-text">${idx + 1}. ${activeName}</span>
              <span class="ex-target-pill">${baseEx.target}</span>
            </div>
            <div class="ex-target-badge">${item.sets} Sets × ${item.reps}</div>
          </div>

          <div class="progression-pills">
            <span class="prog-label">Difficulty:</span>
            <button class="prog-btn ${currentProg === 'std' ? 'active-std' : ''}" onclick="setProgression('${item.key}', 'std')">🟢 Standard</button>
            <button class="prog-btn ${currentProg === 'easy' ? 'active-easy' : ''}" onclick="setProgression('${item.key}', 'easy')">🟡 Easier (Joint Safe)</button>
            <button class="prog-btn ${currentProg === 'hard' ? 'active-hard' : ''}" onclick="setProgression('${item.key}', 'hard')">🔴 Harder (Advance)</button>
          </div>

          <div class="ex-visual-grid" style="margin-top: 14px;">
            <div class="ex-crop-viewport ${baseEx.cropClass}"></div>
            <div>
              <div class="ex-cues-panel">
                ${cuesList}
              </div>
              <div class="ex-video-dock">
                <button type="button" class="btn-inline-video" id="btnInlineVideo_${idx}" onclick="toggleInlineVideo(${idx}, '${EXERCISE_VIDEOS[item.key] || 'bEv6CCg2BC8'}', '${activeName.replace(/'/g, "\\'")}')">
                  ▶ Watch Video Guide Inline
                </button>
                <a href="https://www.youtube.com/results?search_query=${activeSearch}" target="_blank" rel="noopener noreferrer" style="color: var(--rose); font-size: 0.78rem; font-weight: 700; text-decoration: none; margin-left: 10px; display: inline-flex; align-items: center; gap: 4px;">
                  Open YouTube Tab ↗
                </a>
                <div id="inlineVideoWrap_${idx}" class="inline-video-wrap" style="display: none;"></div>
              </div>
            </div>
          </div>

          <table class="set-logging-table">
            <thead>
              <tr>
                <th>Set</th>
                <th>Load / Resistance</th>
                <th>Reps</th>
                <th style="text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody>
              ${setRows}
            </tbody>
          </table>
        `;

        flow.appendChild(card);
      });
    }

    function openVideoPopout(videoId, title) {
      const w = 840;
      const h = 480;
      const left = Math.max(0, Math.round((screen.width - w) / 2));
      const top = Math.max(0, Math.round((screen.height - h) / 2));
      const pop = window.open(
        `https://www.youtube.com/watch?v=${videoId}`,
        `yt_${videoId}`,
        `width=${w},height=${h},top=${top},left=${left},toolbar=no,menubar=no,location=no,status=no,resizable=yes`
      );
      if (pop) pop.focus();
    }

    function renderInlineVideoPlayerHTML(videoId, title, closeJsCall) {
      const safeTitle = (title || 'Exercise Form').replace(/"/g, '&quot;');
      const ytWatchUrl = `https://www.youtube.com/watch?v=${videoId}`;
      const ytSearchUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent((title || '') + ' proper form exercise tutorial')}`;
      const loc = (typeof window !== 'undefined' && window.location) ? window.location : (typeof location !== 'undefined' ? location : { protocol: 'http:', origin: 'http://localhost:3000' });
      const isFileProto = loc.protocol === 'file:';
      const hasHttpOrigin = loc.protocol === 'http:' || loc.protocol === 'https:';
      const originParam = hasHttpOrigin ? `&origin=${encodeURIComponent(loc.origin || 'http://localhost:3000')}` : '';
      const embedSrc = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1${originParam}`;

      return `
        <div class="inline-player-box">
          <div class="inline-player-header">
            <span class="inline-player-title">🎬 Form Guide: <strong>${safeTitle}</strong></span>
            <div class="inline-player-actions">
              <a href="${ytWatchUrl}" target="_blank" rel="noopener noreferrer" class="btn-player-link btn-player-primary" title="Open directly in YouTube (Guaranteed 100% playback)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -1px; margin-right: 3px;"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                YouTube Tab ↗
              </a>
              <button type="button" class="btn-player-link" onclick="openVideoPopout('${videoId}', '${safeTitle.replace(/'/g, "\\'")}')" title="Open in clean standalone popup player">
                🪟 Pop-Out
              </button>
              <a href="${ytSearchUrl}" target="_blank" rel="noopener noreferrer" class="btn-player-link" title="Search tutorials on YouTube">
                🔍 Search
              </a>
              <button type="button" class="btn-player-close" onclick="${closeJsCall}" title="Close Video Player">✕ Close</button>
            </div>
          </div>
          ${isFileProto ? `
            <div style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); padding: 8px 12px; margin: 6px; border-radius: 6px; font-size: 0.78rem; color: #fde68a; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
              <span>⚠️ <strong>Local file protocol (file://) detected:</strong> Browsers strip referrer headers on disk files (causing YouTube Error 153).</span>
              <div style="display: flex; gap: 6px;">
                <a href="${ytWatchUrl}" target="_blank" rel="noopener noreferrer" style="background: #e11d48; color: #fff; text-decoration: none; padding: 3px 8px; border-radius: 4px; font-weight: 700; font-size: 0.74rem;">▶ Watch Direct on YouTube</a>
                <a href="http://localhost:3000/home_gym_zero_to_hero.html" style="background: var(--cyan); color: #000; text-decoration: none; padding: 3px 8px; border-radius: 4px; font-weight: 700; font-size: 0.74rem;">Switch to http://localhost:3000</a>
              </div>
            </div>
          ` : ''}
          <div class="inline-player-viewport">
            <iframe 
              src="${embedSrc}" 
              title="${safeTitle} Form Video" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              referrerpolicy="strict-origin-when-cross-origin" 
              allowfullscreen>
            </iframe>
          </div>
          <div class="inline-player-footer">
            💡 Video blocked by browser adblocker or showing Error 153? Tap <a href="${ytWatchUrl}" target="_blank" rel="noopener noreferrer" style="color: var(--cyan); text-decoration: underline; font-weight: 700;">YouTube Tab ↗</a> to play directly in official YouTube without restrictions.
          </div>
        </div>
      `;
    }

    function toggleInlineVideo(idx, videoId, exName) {
      const wrap = document.getElementById(`inlineVideoWrap_${idx}`);
      const btn = document.getElementById(`btnInlineVideo_${idx}`);
      if (!wrap) return;

      if (wrap.style.display !== 'none' && wrap.innerHTML.trim() !== '') {
        wrap.style.display = 'none';
        wrap.innerHTML = '';
        if (btn) btn.innerHTML = '▶ Watch Video Guide Inline';
      } else {
        wrap.style.display = 'block';
        wrap.innerHTML = renderInlineVideoPlayerHTML(
          videoId, 
          exName, 
          `toggleInlineVideo(${idx}, '${videoId}', '${(exName || '').replace(/'/g, "\\'")}')`
        );
        if (btn) btn.innerHTML = '✕ Close Video';
      }
    }

    function setProgression(exKey, level) {
      userProgressions[`prog_${exKey}`] = level;
      localStorage.setItem('gym_progressions', JSON.stringify(userProgressions));
      renderActiveDay(currentDay);
      playAudioTone(440, 'triangle', 0.1);
    }

    function saveSetLog(key, field, val, defaultReps, defaultWt) {
      if (!loggedSetData[key]) loggedSetData[key] = { wt: defaultWt || '0', reps: defaultReps || '10', done: false };
      loggedSetData[key][field] = val;
      loggedSetData[key].userCustom = true;
      localStorage.setItem('gym_set_logs', JSON.stringify(loggedSetData));
      checkAchievements();
    }

    function toggleSetDone(btn, key, defaultReps, defaultWt) {
      if (!loggedSetData[key]) loggedSetData[key] = { wt: defaultWt || '0', reps: defaultReps || '10', done: false };
      loggedSetData[key].done = !loggedSetData[key].done;
      localStorage.setItem('gym_set_logs', JSON.stringify(loggedSetData));

      if (loggedSetData[key].done) {
        btn.classList.add('done');
        btn.innerText = '✓ Logged';
        playAudioTone(587.33, 'triangle', 0.25); // chime
        startTimer(60);
        speakAnnouncement("Set logged! 60 seconds rest timer started.");
      } else {
        btn.classList.remove('done');
        btn.innerText = 'Log Set';
      }
      checkAchievements();
      updateMissionChecklist();
    }

