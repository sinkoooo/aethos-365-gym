            <button type="button" class="btn-yt-preset" onclick="GymMusic.setYouTubeMusic('PL4fGSI1pDJn65V5aVdG0k2P9RzX4o3hKx', '🏆 Top Gym Playlist', 'playlist')">🏆 Gym Hits Playlist</button>
