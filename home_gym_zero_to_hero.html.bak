const WARMUP_ROUTINE = WARMUP_DETAILS.map(m => ({
  name: `${m.step}: ${m.shortName}`,
  desc: m.target
}));

const COOLDOWN_ROUTINE = COOLDOWN_DETAILS.map(m => ({
  name: `${m.step}: ${m.shortName}`,
  desc: m.target
}));

// Generates complete HTML card for a movement
function generateMovementCardHTML(m, isCooldown) {
  const accentColor = isCooldown ? 'var(--emerald)' : 'var(--cyan)';
  const calloutClass = isCooldown ? 'cooldown-callout' : '';
  const cardClass = isCooldown ? 'cooldown-card' : '';

  let phasesHTML = '';
  if (m.phases && m.phases.length > 0) {
    phasesHTML = `
      <div class="tech-phases-grid">
        ${m.phases.map(p => `
          <div class="tech-phase-box">
            <div class="tech-phase-title" style="color: ${accentColor};">${p.title}</div>
            <ul class="tech-cues-list">
              ${p.cues.map(c => `<li>${c}</li>`).join('')}
            </ul>
          </div>
        `).join('')}
      </div>
    `;
  }

  let setupHTML = '';
  if (m.setup && m.setup.length > 0) {
    setupHTML = `
      <div style="background: rgba(13, 21, 40, 0.65); padding: 12px 14px; border-radius: 8px; margin-bottom: 12px; border: 1px solid rgba(255,255,255,0.08);">
        <strong style="font-size: 0.82rem; color: #fff; text-transform: uppercase; letter-spacing: 0.5px;">📍 Tabletop Alignment & Setup:</strong>
        <ul style="margin: 6px 0 0 0; padding-left: 18px; font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">
          ${m.setup.map(s => `<li>${s}</li>`).join('')}
        </ul>
      </div>
    `;
  }

  let mistakesHTML = '';
  if (m.rookieMistakes && m.rookieMistakes.length > 0) {
    mistakesHTML = `
      <div class="tech-mistakes-box">
        <strong style="font-size: 0.78rem; color: #fda4af; text-transform: uppercase; letter-spacing: 0.5px;">⚠️ Beginner Mistakes & Form Fixes:</strong>
        <div style="margin-top: 6px; display: flex; flex-direction: column; gap: 6px;">
          ${m.rookieMistakes.map(rm => `
            <div style="font-size: 0.8rem; line-height: 1.45;">
              <span style="color: #f43f5e; font-weight: 700;">❌ Mistake:</span> <span style="color: #cbd5e1;">${rm.mistake}</span><br>
              <span style="color: #34d399; font-weight: 700;">✅ Direct Fix:</span> <span style="color: #94a3b8;">${rm.fix}</span>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  return `
    <div class="technique-card ${cardClass}" id="guideCard_${m.id}">
      <div class="tech-header-row">
        <div>
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
            <span class="tech-badge-pill" style="border-color: ${accentColor}; color: ${accentColor};">${m.step} MOVEMENT</span>
            <span style="font-size: 0.74rem; color: var(--amber); font-weight: 700;">⏱️ ${m.duration}</span>
            <span style="font-size: 0.74rem; color: #94a3b8;">🎯 ${m.target}</span>
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 800; color: #fff; margin: 0;">${m.name}</h3>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
          <button type="button" class="btn-inline-video" onclick="toggleMobilityVideo('${m.id}', '${m.videoId}', '${m.shortName.replace(/'/g, "\\'")}')" id="btnMobVideo_${m.id}">
            ▶ Watch Video Guide Inline
          </button>
          <a href="https://www.youtube.com/results?search_query=${m.searchQuery || ''}" target="_blank" rel="noopener noreferrer" style="color: var(--rose); font-size: 0.78rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
            YouTube ↗
          </a>
        </div>
      </div>

      <div id="mobVideoWrap_${m.id}" class="inline-video-wrap" style="display: none; margin-bottom: 14px;"></div>

      <div class="tech-why-callout ${calloutClass}">
        <strong>💡 Why This Movement Matters:</strong> ${m.why}
      </div>

      ${setupHTML}
      ${phasesHTML}

      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; background: rgba(255,255,255,0.04); padding: 8px 12px; border-radius: 6px; font-size: 0.78rem;">
        <span style="color: ${accentColor}; font-weight: 700;">🌬️ Breathing Cadence:</span>
        <span style="color: #fff; font-family: 'JetBrains Mono', monospace;">${m.breathing}</span>
      </div>

      ${mistakesHTML}
    </div>
  `;
}

function renderWarmupGuidesDrawer() {
  const container = document.getElementById('warmupGuidesDrawer');
  if (!container) return;
  container.innerHTML = WARMUP_DETAILS.map(m => generateMovementCardHTML(m, false)).join('');
}

function renderCooldownGuidesDrawer() {
  const container = document.getElementById('cooldownGuidesDrawer');
  if (!container) return;
  container.innerHTML = COOLDOWN_DETAILS.map(m => generateMovementCardHTML(m, true)).join('');
}

function toggleWarmupGuidesDrawer() {
  const drawer = document.getElementById('warmupGuidesDrawer');
  const chev = document.getElementById('warmupGuideChevron');
  if (!drawer) return;
  const isHidden = drawer.style.display === 'none' || !drawer.style.display;
  drawer.style.display = isHidden ? 'flex' : 'none';
  if (chev) chev.innerText = isHidden ? '▴' : '▾';
}

function toggleCooldownGuidesDrawer() {
  const drawer = document.getElementById('cooldownGuidesDrawer');
  const chev = document.getElementById('cooldownGuideChevron');
  if (!drawer) return;
  const isHidden = drawer.style.display === 'none' || !drawer.style.display;
  drawer.style.display = isHidden ? 'flex' : 'none';
  if (chev) chev.innerText = isHidden ? '▴' : '▾';
}

function showWarmupMovementDetail(index) {
  const m = WARMUP_DETAILS[index];
  if (!m) return;
  const drawer = document.getElementById('warmupGuidesDrawer');
  const chev = document.getElementById('warmupGuideChevron');
  if (drawer && (drawer.style.display === 'none' || !drawer.style.display)) {
    drawer.style.display = 'flex';
    if (chev) chev.innerText = '▴';
  }
  // highlight chip
  const chips = document.querySelectorAll('#warmupChipsRow .mobility-chip');
  chips.forEach((c, i) => {
    if (i === index) c.classList.add('active');
    else c.classList.remove('active');
  });
  // scroll into view
  const card = document.getElementById(`guideCard_${m.id}`);
  if (card && typeof card.scrollIntoView === 'function') {
    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
}

function showCooldownMovementDetail(index) {
  const m = COOLDOWN_DETAILS[index];
  if (!m) return;
  const drawer = document.getElementById('cooldownGuidesDrawer');
  const chev = document.getElementById('cooldownGuideChevron');
  if (drawer && (drawer.style.display === 'none' || !drawer.style.display)) {
    drawer.style.display = 'flex';
    if (chev) chev.innerText = '▴';
  }
  // highlight chip
  const chips = document.querySelectorAll('#cooldownChipsRow .mobility-chip');
  chips.forEach((c, i) => {
    if (i === index) c.classList.add('active');
    else c.classList.remove('active');
  });
  // scroll into view
  const card = document.getElementById(`guideCard_${m.id}`);
  if (card && typeof card.scrollIntoView === 'function') {
    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
}

function toggleMobilityVideo(id, videoId, name) {
  const wrap = document.getElementById(`mobVideoWrap_${id}`);
  const btn = document.getElementById(`btnMobVideo_${id}`);
  if (!wrap) return;

  if (wrap.style.display !== 'none' && wrap.innerHTML.trim() !== '') {
    wrap.style.display = 'none';
    wrap.innerHTML = '';
    if (btn) btn.innerText = '▶ Watch Video Guide Inline';
  } else {
    wrap.style.display = 'block';
    wrap.innerHTML = renderInlineVideoPlayerHTML(
      videoId, 
      name, 
      `toggleMobilityVideo('${id}', '${videoId}', '${(name || '').replace(/'/g, "\\'")}')`
    );
    if (btn) btn.innerText = '✕ Close Video';
  }
}

if (typeof window !== 'undefined') {
  window.WARMUP_DETAILS = WARMUP_DETAILS;
  window.COOLDOWN_DETAILS = COOLDOWN_DETAILS;
}

// ==========================================
// GUIDED DYNAMIC WARM-UP ENGINE (STATE & HUD)
// ==========================================
let warmupInterval = null;
let warmupSec = 60;
let warmupStep = 0;

function updateWarmupHUD(curr) {
  const activePlayer = document.getElementById('warmupActivePlayer');
  if (activePlayer) {
    activePlayer.style.display = 'block';
  }

  const pSec = document.getElementById('warmupPlayerSec');
  if (pSec) pSec.innerText = warmupSec;

  const pBadge = document.getElementById('warmupStepBadge');
  if (pBadge) pBadge.innerText = `STEP ${warmupStep + 1} OF ${WARMUP_DETAILS.length}`;

  const pTitle = document.getElementById('warmupPlayerTitle');
  if (pTitle) pTitle.innerText = curr.name;

  const pTarget = document.getElementById('warmupPlayerTarget');
  if (pTarget) pTarget.innerText = curr.target;

  // Breathing metronome logic (4s inhale / 4s exhale cycle)
  const breathCycleSec = warmupSec % 8;
  const isExhale = breathCycleSec < 4; // 0,1,2,3 is Exhale, 4,5,6,7 is Inhale
  const bPhase = document.getElementById('warmupBreathPhase');
  const bSec = document.getElementById('warmupBreathSec');
  const bFill = document.getElementById('warmupBreathFill');
  const lCue = document.getElementById('warmupLiveCue');

  if (isExhale) {
    if (bPhase) bPhase.innerText = "💨 EXHALE • DOMING SPINAL WAVE";
    if (bSec) bSec.innerText = `${(breathCycleSec % 4) + 1}s / 4s`;
    if (bFill) bFill.style.width = `${Math.max(15, (4 - (breathCycleSec % 4)) * 25)}%`;
    if (lCue) lCue.innerText = curr.liveCueExhale || "Exhale smoothly and complete contraction.";
  } else {
    if (bPhase) bPhase.innerText = "🫁 INHALE • EXTENDING SPINAL WAVE";
    const curBreath = 4 - (breathCycleSec - 4);
    if (bSec) bSec.innerText = `${curBreath}s / 4s`;
    if (bFill) bFill.style.width = `${Math.min(100, (breathCycleSec - 3) * 25)}%`;
    if (lCue) lCue.innerText = curr.liveCueInhale || "Inhale through nose and expand diaphragm.";
  }

  // Active chip sync
  const chips = document.querySelectorAll('#warmupChipsRow .mobility-chip');
  chips.forEach((c, i) => {
    if (i === warmupStep) c.classList.add('active');
    else c.classList.remove('active');
  });
}

function startGuidedWarmup() {
  const btn = document.getElementById('btnWarmupLaunch');
  const status = document.getElementById('warmupStatus');
  const playerPauseBtn = document.getElementById('btnWarmupPlayerPause');

  if (warmupInterval) {
    clearInterval(warmupInterval);
    warmupInterval = null;
    if (btn) btn.innerText = "▶ Resume Warm-Up";
    if (playerPauseBtn) playerPauseBtn.innerText = "▶ Resume";
    return;
  }

  if (btn) btn.innerText = `⏸ Pause (${warmupSec}s)`;
  if (playerPauseBtn) playerPauseBtn.innerText = "⏸ Pause";

  function tickWarmup() {
    if (warmupStep >= WARMUP_DETAILS.length) {
      clearInterval(warmupInterval);
      warmupInterval = null;
      if (status) status.innerText = "✓ Warm-Up Complete! Joints lubricated, spine mobilized & ready to lift.";
      if (btn) btn.innerText = "✓ Warm-Up Done";
      const activePlayer = document.getElementById('warmupActivePlayer');
      if (activePlayer) activePlayer.style.display = 'none';
      warmupDoneDays.add(currentDay);
      localStorage.setItem('gym_warmup_done', JSON.stringify(Array.from(warmupDoneDays)));
      updateMissionChecklist();
      speakAnnouncement("Warm up complete! Let's crush today's workout.");
      playAudioTone(880, 'sine', 0.5);
      return;
    }

    const curr = WARMUP_DETAILS[warmupStep];
    if (status) status.innerHTML = `<strong style="color:var(--cyan);">${curr.shortName} (${warmupSec}s left):</strong> ${curr.target}`;
    if (btn) btn.innerText = `⏸ Pause (${warmupSec}s)`;

    updateWarmupHUD(curr);

    if (warmupSec === 60) {
      speakAnnouncement(`Next warm-up: ${curr.shortName}. 60 seconds.`);
      playAudioTone(523.25, 'sine', 0.2);
    }

    warmupSec--;
    if (warmupSec < 0) {
      warmupStep++;
      warmupSec = 60;
    }
  }

  tickWarmup();
  warmupInterval = setInterval(tickWarmup, 1000);
}

function toggleWarmupPause() {
  startGuidedWarmup();
}

function skipWarmupStep() {
  warmupStep++;
  warmupSec = 60;
  if (warmupStep >= WARMUP_DETAILS.length) {
    startGuidedWarmup();
  } else {
    updateWarmupHUD(WARMUP_DETAILS[warmupStep]);
  }
}

function stopGuidedWarmup() {
  if (warmupInterval) {
    clearInterval(warmupInterval);
    warmupInterval = null;
  }
  warmupStep = 0;
  warmupSec = 60;
  const activePlayer = document.getElementById('warmupActivePlayer');
  if (activePlayer) activePlayer.style.display = 'none';
  const btn = document.getElementById('btnWarmupLaunch');
  if (btn) btn.innerText = "▶ Start Follow-Along Warm-Up";
  const chips = document.querySelectorAll('#warmupChipsRow .mobility-chip');
  chips.forEach(c => c.classList.remove('active'));
}

// ==========================================
// GUIDED POST-WORKOUT COOL-DOWN ENGINE (STATE & HUD)
// ==========================================
let cooldownInterval = null;
let cooldownSec = 60;
let cooldownStep = 0;

function updateCooldownHUD(curr) {
  const activePlayer = document.getElementById('cooldownActivePlayer');
  if (activePlayer) {
    activePlayer.style.display = 'block';
  }

  const pSec = document.getElementById('cooldownPlayerSec');
  if (pSec) pSec.innerText = cooldownSec;

  const pBadge = document.getElementById('cooldownStepBadge');
  if (pBadge) pBadge.innerText = `STEP ${cooldownStep + 1} OF ${COOLDOWN_DETAILS.length}`;

  const pTitle = document.getElementById('cooldownPlayerTitle');
  if (pTitle) pTitle.innerText = curr.name;

  const pTarget = document.getElementById('cooldownPlayerTarget');
  if (pTarget) pTarget.innerText = curr.target;

  // Breathing metronome logic for cooldown
  const breathCycleSec = cooldownSec % 8;
  const isExhale = breathCycleSec < 4;
  const bPhase = document.getElementById('cooldownBreathPhase');
  const bSec = document.getElementById('cooldownBreathSec');
  const bFill = document.getElementById('cooldownBreathFill');
  const lCue = document.getElementById('cooldownLiveCue');

  if (isExhale) {
    if (bPhase) bPhase.innerText = "💨 EXHALE • SINK INTO DECOMPRESSION";
    if (bSec) bSec.innerText = `${(breathCycleSec % 4) + 1}s / 4s`;
    if (bFill) bFill.style.width = `${Math.max(15, (4 - (breathCycleSec % 4)) * 25)}%`;
    if (lCue) lCue.innerText = curr.liveCueExhale || "Exhale long and slow; release muscle tension.";
  } else {
    if (bPhase) bPhase.innerText = "🫁 INHALE • EXPAND DIAPHRAGM";
    const curBreath = 4 - (breathCycleSec - 4);
    if (bSec) bSec.innerText = `${curBreath}s / 4s`;
    if (bFill) bFill.style.width = `${Math.min(100, (breathCycleSec - 3) * 25)}%`;
    if (lCue) lCue.innerText = curr.liveCueInhale || "Inhale deeply into belly; keep shoulders relaxed.";
  }

  // Active chip sync
  const chips = document.querySelectorAll('#cooldownChipsRow .mobility-chip');
  chips.forEach((c, i) => {
    if (i === cooldownStep) c.classList.add('active');
    else c.classList.remove('active');
  });
}

function startGuidedCooldown() {
  const btn = document.getElementById('btnCooldownLaunch');
  const status = document.getElementById('cooldownStatus');
  const playerPauseBtn = document.getElementById('btnCooldownPlayerPause');

  if (cooldownInterval) {
    clearInterval(cooldownInterval);
    cooldownInterval = null;
    if (btn) btn.innerText = "▶ Resume Cool-Down";
    if (playerPauseBtn) playerPauseBtn.innerText = "▶ Resume";
    return;
  }

  if (btn) btn.innerText = `⏸ Pause (${cooldownSec}s)`;
  if (playerPauseBtn) playerPauseBtn.innerText = "⏸ Pause";

  function tickCooldown() {
    if (cooldownStep >= COOLDOWN_DETAILS.length) {
      clearInterval(cooldownInterval);
      cooldownInterval = null;
      if (status) status.innerText = "✓ Cool-Down Complete! Heart rate normalized & joints protected.";
      if (btn) btn.innerText = "✓ Cool-Down Done";
      const activePlayer = document.getElementById('cooldownActivePlayer');
      if (activePlayer) activePlayer.style.display = 'none';
      cooldownDoneDays.add(currentDay);
      localStorage.setItem('gym_cooldown_done', JSON.stringify(Array.from(cooldownDoneDays)));
      updateMissionChecklist();
      speakAnnouncement("Cool down complete! Fantastic effort today. Refuel with protein and hydrate.");
      playAudioTone(880, 'sine', 0.5);
      return;
    }

    const curr = COOLDOWN_DETAILS[cooldownStep];
    if (status) status.innerHTML = `<strong style="color:var(--emerald);">${curr.shortName} (${cooldownSec}s left):</strong> ${curr.target}`;
    if (btn) btn.innerText = `⏸ Pause (${cooldownSec}s)`;

    updateCooldownHUD(curr);

    if (cooldownSec === 60) {
      speakAnnouncement(`Next cool-down: ${curr.shortName}. 60 seconds.`);
      playAudioTone(440, 'sine', 0.2);
    }

    cooldownSec--;
    if (cooldownSec < 0) {
      cooldownStep++;
      cooldownSec = 60;
    }
  }

  tickCooldown();
  cooldownInterval = setInterval(tickCooldown, 1000);
}

function toggleCooldownPause() {
  startGuidedCooldown();
}

function skipCooldownStep() {
  cooldownStep++;
  cooldownSec = 60;
  if (cooldownStep >= COOLDOWN_DETAILS.length) {
    startGuidedCooldown();
  } else {
    updateCooldownHUD(COOLDOWN_DETAILS[cooldownStep]);
  }
}

function stopGuidedCooldown() {
  if (cooldownInterval) {
    clearInterval(cooldownInterval);
    cooldownInterval = null;
  }
  cooldownStep = 0;
  cooldownSec = 60;
  const activePlayer = document.getElementById('cooldownActivePlayer');
  if (activePlayer) activePlayer.style.display = 'none';
  const btn = document.getElementById('btnCooldownLaunch');
  if (btn) btn.innerText = "▶ Start Follow-Along Cool-Down";
  const chips = document.querySelectorAll('#cooldownChipsRow .mobility-chip');
  chips.forEach(c => c.classList.remove('active'));
}


    // ==========================================
    // TEMPO PACER ENGINE (3-1-1 CADENCE)
    // ==========================================
    let tempoInterval = null;
    let tempoState = 0; // 0: down (3s), 1: hold (1s), 2: up (1s)
    let tempoTimer = 3;

    function toggleTempoPacer() {
      const btn = document.getElementById('btnTempo');
      const circle = document.getElementById('tempoCircle');
      const action = document.getElementById('tempoAction');
      const sec = document.getElementById('tempoSec');

      if (tempoInterval) {
        clearInterval(tempoInterval);
        tempoInterval = null;
        circle.className = 'tempo-circle';
        action.innerText = "READY";
        sec.innerText = "0s";
        btn.innerText = "Start 3-1-1 Tempo Guide";
        return;
      }

      btn.innerText = "⏹ Stop Pacer";
      tempoState = 0;
      tempoTimer = 3;

      tempoInterval = setInterval(() => {
        if (tempoState === 0) { // Lowering (Eccentric)
          circle.className = 'tempo-circle down';
          action.innerText = "DOWN";
          action.style.color = "var(--amber)";
          sec.innerText = `${tempoTimer}s`;
          playAudioTone(220, 'sine', 0.08);
          tempoTimer--;
          if (tempoTimer < 1) {
            tempoState = 1;
            tempoTimer = 1;
          }
        } else if (tempoState === 1) { // Pause (Isometric)
          circle.className = 'tempo-circle hold';
          action.innerText = "PAUSE";
          action.style.color = "var(--rose)";
          sec.innerText = "1s";
          playAudioTone(330, 'triangle', 0.08);
          tempoState = 2;
          tempoTimer = 1;
        } else if (tempoState === 2) { // Drive Up (Concentric)
          circle.className = 'tempo-circle up';
          action.innerText = "DRIVE UP!";
          action.style.color = "var(--emerald)";
          sec.innerText = "1s";
          playAudioTone(587.33, 'triangle', 0.15);
          tempoState = 0;
          tempoTimer = 3;
        }
      }, 1000);
    }

    // ==========================================
    // READINESS AUTOREGULATION & WATER TRACKER
    // ==========================================
    function setReadiness(level) {
      dailyReadiness[currentDay] = level;
      localStorage.setItem('gym_readiness_log', JSON.stringify(dailyReadiness));
      updateReadinessUI();
      renderActiveDay(currentDay); // Re-renders plan with autoscaled sets if low
    }

    function updateReadinessUI() {
      const level = dailyReadiness[currentDay] || 'norm';
      document.getElementById('btnEnergyHigh').className = `btn-energy ${level === 'high' ? 'active-high' : ''}`;
      document.getElementById('btnEnergyNorm').className = `btn-energy ${level === 'norm' ? 'active-norm' : ''}`;
      document.getElementById('btnEnergyLow').className = `btn-energy ${level === 'low' ? 'active-low' : ''}`;
    }

    function renderWaterTracker() {
      const row = document.getElementById('waterTrackerRow');
      if (!row) return;
      row.innerHTML = '';
      const cupsFilled = waterLog[currentDay] || 0;

      for (let i = 1; i <= 8; i++) {
        const isFilled = i <= cupsFilled;
        const cup = document.createElement('div');
        cup.className = `water-cup ${isFilled ? 'filled' : ''}`;
        cup.innerText = '💧';
        cup.title = `Glass ${i} (400ml)`;
        cup.onclick = () => {
          waterLog[currentDay] = (cupsFilled === i) ? i - 1 : i;
          localStorage.setItem('gym_water_log', JSON.stringify(waterLog));
          renderWaterTracker();
          updateMissionChecklist();
          playAudioTone(440, 'sine', 0.1);
        };
        row.appendChild(cup);
      }
      updateMissionChecklist();
    }

    // ==========================================
    // WEEKLY BODYWEIGHT & METRICS LOG
    // ==========================================
    function saveMetricEntry() {
      const wt = parseFloat(document.getElementById('logWeightInput').value);
      const waist = parseFloat(document.getElementById('logWaistInput').value);
      if (!wt || !waist) return;

      const dateStr = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      const ratio = (waist / 183).toFixed(2); // Waist to height ratio for 6'0" (183cm)

      loggedMetrics.unshift({ date: dateStr, wt, waist, ratio });
      localStorage.setItem('gym_metrics_logs', JSON.stringify(loggedMetrics));
      renderMetricsTable();
      playAudioTone(523.25, 'triangle', 0.2);
    }

    function renderMetricsTable() {
      const tbody = document.getElementById('metricsTableBody');
      tbody.innerHTML = '';

      if (loggedMetrics.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding: 14px; color: var(--text-dim);">No logs yet. Record your baseline today!</td></tr>`;
        return;
      }

      loggedMetrics.forEach(m => {
        const ratioColor = m.ratio <= 0.50 ? 'var(--emerald)' : 'var(--amber)';
        tbody.innerHTML += `
          <tr style="border-top: 1px solid rgba(255,255,255,0.05);">
            <td style="padding: 10px; color: #fff;">${m.date}</td>
            <td style="padding: 10px; font-family:'JetBrains Mono'; font-weight:700;">${m.wt} kg</td>
            <td style="padding: 10px; font-family:'JetBrains Mono'; font-weight:700;">${m.waist} cm</td>
            <td style="padding: 10px; font-family:'JetBrains Mono'; font-weight:700; color:${ratioColor};">${m.ratio} ${m.ratio <= 0.50 ? '(Healthy)' : '(Focus)'}</td>
          </tr>
        `;
      });
    }

    // ==========================================
    // HEATMAP, MIRROR, AUDIO & STATS
    // ==========================================
    function updateHeatmap(plan) {
      const activeMuscles = new Set();
      if (plan.exercises) {
        plan.exercises.forEach(item => {
          const ex = CATALOG[item.key];
          if (ex && ex.muscles) ex.muscles.forEach(m => activeMuscles.add(m));
        });
      }

      const parts = ['chest', 'lats', 'abs', 'glutes', 'quads', 'quads-r', 'calves', 'calves-r', 'delts-l', 'delts-r'];
      parts.forEach(p => {
        const el = document.getElementById(`heat-${p}`);
        if (el) el.setAttribute('fill', '#1e293b');
      });

      activeMuscles.forEach(m => {
        if (m === 'chest') document.getElementById('heat-chest')?.setAttribute('fill', 'var(--cyan)');
        if (m === 'lats') document.getElementById('heat-lats')?.setAttribute('fill', 'var(--purple)');
        if (m === 'abs') document.getElementById('heat-abs')?.setAttribute('fill', 'var(--emerald)');
        if (m === 'glutes') document.getElementById('heat-glutes')?.setAttribute('fill', 'var(--amber)');
        if (m === 'quads') {
          document.getElementById('heat-quads')?.setAttribute('fill', 'var(--cyan)');
          document.getElementById('heat-quads-r')?.setAttribute('fill', 'var(--cyan)');
        }
        if (m === 'delts') {
          document.getElementById('heat-delts-l')?.setAttribute('fill', 'var(--cyan)');
          document.getElementById('heat-delts-r')?.setAttribute('fill', 'var(--cyan)');
        }
      });

      const tagContainer = document.getElementById('heatmapTagsContainer');
      tagContainer.innerHTML = '';
      if (activeMuscles.size === 0) {
        tagContainer.innerHTML = `<span class="muscle-tag mt-secondary">Rest & Recovery</span>`;
      } else {
        activeMuscles.forEach(m => {
          tagContainer.innerHTML += `<span class="muscle-tag mt-active">${m}</span>`;
        });
      }
    }

    async function toggleWebcam() {
      const video = document.getElementById('webcamVideo');
      const placeholder = document.getElementById('mirrorPlaceholder');

      if (webcamStream) {
        webcamStream.getTracks().forEach(track => track.stop());
        webcamStream = null;
        video.srcObject = null;
        video.style.display = 'none';
        placeholder.style.display = 'block';
      } else {
        try {
          webcamStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
          video.srcObject = webcamStream;
          video.style.display = 'block';
          placeholder.style.display = 'none';
        } catch (err) {
          alert("Webcam access not permitted or camera unavailable.");
        }
      }
    }

    function speakAnnouncement(text) {
      const toggle = document.getElementById('voiceCoachToggle');
      if (!toggle || !toggle.checked) return;
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.rate = voiceSettings.rate || 1.05;
        utter.pitch = voiceSettings.pitch || 1.0;
        if (voiceSettings.voiceURI && availableVoices.length > 0) {
          const match = availableVoices.find(v => v.voiceURI === voiceSettings.voiceURI);
          if (match) utter.voice = match;
        }

        // Auto-duck gym music beats during coach instruction
        if (typeof GymMusic !== 'undefined' && GymMusic.isPlaying) {
          GymMusic.duckVolume();
          utter.onend = () => { GymMusic.restoreVolume(); };
          utter.onerror = () => { GymMusic.restoreVolume(); };
        }

        window.speechSynthesis.speak(utter);
      }
    }

    function updateStats(plan) {
      const count = completedDays.size;
      document.getElementById('statCompleted').innerText = `${count} / 365`;
      document.getElementById('pctCompleted').innerText = `${((count / 365) * 100).toFixed(1)}%`;

      document.getElementById('statPhase').innerText = plan.phaseName.split(':')[0];
      document.getElementById('statPhaseDesc').innerText = plan.phaseName.split(':')[1] || '';
      document.getElementById('statEquip').innerText = plan.equipText;

      let streak = 0;
      let check = currentDay;
      while (completedDays.has(check) && check > 0) {
        streak++;
        check--;
      }
      document.getElementById('statStreak').innerText = `${streak} Day${streak === 1 ? '' : 's'}`;
      document.getElementById('streakSub').innerText = streak > 0 ? "Momentum is building!" : "Log today to keep streak";

      checkAchievements();
    }

    // ==========================================
    // 28-MILESTONE & 20-LEVEL PROGRESSION ENGINE
    // ==========================================
    function calculateTotalVolume() {
      let vol = 0;
      for (const [key, val] of Object.entries(loggedSetData)) {
        if (val && val.done) {
          let wt = parseFloat(String(val.wt || '0').replace(/[^0-9.]/g, '')) || 0;
          let reps = parseFloat(String(val.reps || '10').replace(/[^0-9.]/g, '')) || 10;
          if (wt === 0) wt = (userProfile?.weight || 82) * 0.65;
          vol += wt * reps;
        }
      }
      const explicitDays = new Set(Object.keys(loggedSetData).map(k => parseInt(k.replace(/^d(\d+)_.*$/, '$1'), 10)));
      completedDays.forEach(d => {
        if (!explicitDays.has(d)) {
          vol += (userProfile?.weight || 82) * 0.65 * 10 * 12;
        }
      });
      return Math.round(vol);
    }

    function calculateXPAndLevel() {
      const totalVolume = calculateTotalVolume();
      const completedCount = completedDays.size;
      const photosCount = photosLoggedDays.size;

      let unlockedCount = 0;
      let milestoneXP = 0;
      let newlyUnlocked = [];

      ACHIEVEMENTS.forEach(a => {
        let isUnlocked = false;
        if (a.category === 'streak') {
          isUnlocked = completedCount >= a.target;
        } else if (a.category === 'volume') {
          isUnlocked = totalVolume >= a.target;
        } else if (a.category === 'photo') {
          isUnlocked = photosCount >= a.target;
        } else if (a.category === 'mastery') {
          if (a.id === 'mastery_form') isUnlocked = completedCount >= 5;
          else if (a.id === 'mastery_hydration') isUnlocked = Object.values(waterLog).filter(v => v >= 8).length >= 7;
          else if (a.id === 'mastery_rings') isUnlocked = completedCount >= 61;
          else if (a.id === 'mastery_progressive') isUnlocked = Object.values(loggedSetData).filter(s => s && s.done).length >= 20;
          else if (a.id === 'mastery_recovery') isUnlocked = completedCount >= 30;
          else if (a.id === 'mastery_tempo') isUnlocked = completedCount >= 50;
          else if (a.id === 'mastery_apex') isUnlocked = completedCount >= 200;
        }

        if (isUnlocked) {
          unlockedCount++;
          milestoneXP += a.xp;
          if (!unlockedMilestones.has(a.id)) {
            unlockedMilestones.add(a.id);
            newlyUnlocked.push(a);
          }
        }
      });

      localStorage.setItem('gym_unlocked_milestones', JSON.stringify(Array.from(unlockedMilestones)));

      const setsLoggedCount = Object.values(loggedSetData).filter(s => s && s.done).length;
      const totalXP = (completedCount * 50) + (photosCount * 75) + (setsLoggedCount * 10) + milestoneXP;

      let currentLevel = LEVELS[0];
      let nextLevel = LEVELS[1];
      let prevXp = 0;

      for (let i = 0; i < LEVELS.length; i++) {
        if (totalXP >= LEVELS[i].xpNeeded) {
          currentLevel = LEVELS[i];
          prevXp = LEVELS[i].xpNeeded;
          nextLevel = LEVELS[i + 1] || null;
        } else {
          nextLevel = LEVELS[i];
          break;
        }
      }

      let xpInTier = totalXP - prevXp;
      let xpNeededForNext = nextLevel ? (nextLevel.xpNeeded - prevXp) : 1000;
      let pct = nextLevel ? Math.min(100, Math.round((xpInTier / xpNeededForNext) * 100)) : 100;

      return {
        totalXP,
        totalVolume,
        completedCount,
        photosCount,
        unlockedCount,
        currentLevel,
        nextLevel,
        xpInTier,
        xpNeededForNext,
        pct,
        newlyUnlocked
      };
    }

    function checkAchievements() {
      const stats = calculateXPAndLevel();

      const headerLvlBadge = document.getElementById('headerLvlBadge');
      const headerLvlTitle = document.getElementById('headerLvlTitle');
      const headerXpVal = document.getElementById('headerXpVal');
      const headerXpFill = document.getElementById('headerXpFill');
      const unlockedBadgesCount = document.getElementById('unlockedBadgesCount');
      const loggedPhotosCount = document.getElementById('loggedPhotosCount');

      if (headerLvlBadge) headerLvlBadge.innerText = `LVL ${stats.currentLevel.lvl}`;
      if (headerLvlTitle) headerLvlTitle.innerText = stats.currentLevel.title;
      if (headerXpVal) headerXpVal.innerText = `${stats.xpInTier} / ${stats.xpNeededForNext} XP`;
      if (headerXpFill) headerXpFill.style.width = `${stats.pct}%`;
      if (unlockedBadgesCount) unlockedBadgesCount.innerText = `${stats.unlockedCount}/28`;
      if (loggedPhotosCount) loggedPhotosCount.innerText = `${stats.photosCount}`;

      const hubRankLvl = document.getElementById('hubRankLvl');
      const hubRankTitle = document.getElementById('hubRankTitle');
      const hubXpFraction = document.getElementById('hubXpFraction');
      const hubXpFill = document.getElementById('hubXpFill');
      const hubUnlockedCount = document.getElementById('hubUnlockedCount');
      const hubNextLvlNeeded = document.getElementById('hubNextLvlNeeded');

      if (hubRankLvl) hubRankLvl.innerText = `LVL ${stats.currentLevel.lvl}`;
      if (hubRankTitle) hubRankTitle.innerText = stats.currentLevel.title;
      if (hubXpFraction) hubXpFraction.innerText = `${stats.totalXP.toLocaleString()} XP (${stats.xpInTier}/${stats.xpNeededForNext} Tier)`;
      if (hubXpFill) hubXpFill.style.width = `${stats.pct}%`;
      if (hubUnlockedCount) hubUnlockedCount.innerText = `${stats.unlockedCount} / 28`;
      if (hubNextLvlNeeded) {
        hubNextLvlNeeded.innerText = stats.nextLevel ? `${stats.xpNeededForNext - stats.xpInTier} XP to LVL ${stats.nextLevel.lvl} (${stats.nextLevel.title})` : "Max Rank Achieved";
      }

      updateActiveQuestBanner(stats);

      const grid = document.getElementById('badgeGridWrap');
      if (grid) {
        grid.innerHTML = '';
        ACHIEVEMENTS.forEach(a => {
          const isUnlocked = unlockedMilestones.has(a.id);
          grid.innerHTML += `
            <div class="trophy-card ${isUnlocked ? 'unlocked' : ''}">
              <div class="trophy-icon">${a.icon}</div>
              <div>
                <strong style="color: #fff; display: block;">${a.title}</strong>
                <span style="font-size: 0.8rem; color: var(--text-muted);">${a.desc}</span>
                <div style="font-size: 0.72rem; color: ${isUnlocked ? 'var(--emerald)' : 'var(--text-dim)'}; margin-top: 4px; font-weight: 700;">
                  ${isUnlocked ? '✓ UNLOCKED (+ ' + a.xp + ' XP)' : `Target: ${a.target.toLocaleString()} ${a.unit}`}
                </div>
              </div>
            </div>
          `;
        });
      }

      if (document.getElementById('milestonesView')?.classList.contains('active')) {
        renderMilestonesHub(currentMilestoneFilter);
      }

      if (stats.newlyUnlocked && stats.newlyUnlocked.length > 0) {
        triggerMilestoneCelebration(stats.newlyUnlocked[0]);
      }
    }

    function updateActiveQuestBanner(stats) {
      const quest = ACHIEVEMENTS.find(a => !unlockedMilestones.has(a.id)) || ACHIEVEMENTS[ACHIEVEMENTS.length - 1];
      if (!quest) return;

      const iconEl = document.getElementById('questIcon');
      const titleEl = document.getElementById('questTitle');
      const rarityEl = document.getElementById('questRarity');
      const descEl = document.getElementById('questDesc');
      const progressEl = document.getElementById('questProgressText');
      const xpEl = document.getElementById('questXpReward');
      const barEl = document.getElementById('questProgressBar');

      if (iconEl) iconEl.innerText = quest.icon;
      if (titleEl) titleEl.innerText = quest.title;
      if (rarityEl) {
        rarityEl.className = `rarity-pill rarity-${quest.rarity}`;
        rarityEl.innerText = quest.rarity.toUpperCase();
      }
      if (descEl) descEl.innerText = quest.desc;
      if (xpEl) xpEl.innerText = `+${quest.xp} XP`;

      let currentVal = 0;
      if (quest.category === 'streak') currentVal = stats.completedCount;
      else if (quest.category === 'volume') currentVal = stats.totalVolume;
      else if (quest.category === 'photo') currentVal = stats.photosCount;
      else if (quest.category === 'mastery') currentVal = stats.completedCount;

      const targetVal = quest.target;
      const qPct = Math.min(100, Math.round((currentVal / targetVal) * 100));

      if (progressEl) progressEl.innerText = `${currentVal.toLocaleString()} / ${targetVal.toLocaleString()} ${quest.unit}`;
      if (barEl) barEl.style.width = `${qPct}%`;
    }

    function triggerMilestoneCelebration(m) {
      const icon = document.getElementById('celebIcon');
      const rarity = document.getElementById('celebRarity');
      const title = document.getElementById('celebTitle');
      const desc = document.getElementById('celebDesc');
      const xp = document.getElementById('celebXp');

      if (icon) icon.innerText = m.icon;
      if (rarity) {
        rarity.className = `rarity-pill rarity-${m.rarity}`;
        rarity.innerText = `${m.rarity.toUpperCase()} MILESTONE UNLOCKED`;
      }
      if (title) title.innerText = m.title;
      if (desc) desc.innerText = m.desc;
      if (xp) xp.innerText = `+${m.xp} XP Claimed!`;

      playAudioTone(523.25, 'triangle', 0.2);
      setTimeout(() => playAudioTone(659.25, 'triangle', 0.25), 150);
      setTimeout(() => playAudioTone(783.99, 'triangle', 0.4), 300);
      triggerHaptic([80, 40, 80, 40, 120]);

      openModal('milestoneCelebrationModal');
    }

    function filterMilestones(category, btn) {
      currentMilestoneFilter = category;
      if (btn) {
        document.querySelectorAll('.milestone-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
      renderMilestonesHub(category);
    }

    function renderMilestonesHub(filter) {
      const container = document.getElementById('milestonesGridContainer');
      if (!container) return;

      const cat = filter || currentMilestoneFilter || 'all';
      const filtered = (cat === 'all') ? ACHIEVEMENTS : ACHIEVEMENTS.filter(a => a.category === cat);

      const stats = calculateXPAndLevel();
      container.innerHTML = '';

      filtered.forEach(m => {
        const isUnlocked = unlockedMilestones.has(m.id);
        let curVal = 0;
        if (m.category === 'streak') curVal = stats.completedCount;
        else if (m.category === 'volume') curVal = stats.totalVolume;
        else if (m.category === 'photo') curVal = stats.photosCount;
        else if (m.category === 'mastery') curVal = stats.completedCount;

        const pct = isUnlocked ? 100 : Math.min(100, Math.round((curVal / m.target) * 100));

        const card = document.createElement('div');
        card.className = `milestone-holo-card ${isUnlocked ? 'unlocked' : ''}`;
        card.innerHTML = `
          <div>
            <div class="holo-header-row">
              <div class="holo-icon-wrap">${m.icon}</div>
              <span class="rarity-pill rarity-${m.rarity}">${m.rarity.toUpperCase()}</span>
            </div>
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #fff; margin: 0 0 4px;">${m.title}</h3>
            <p style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.4; margin: 0 0 14px;">${m.desc}</p>
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: 700; margin-bottom: 6px;">
              <span style="color: ${isUnlocked ? 'var(--emerald)' : 'var(--cyan)'};">
                ${isUnlocked ? '✓ UNLOCKED' : `${curVal.toLocaleString()} / ${m.target.toLocaleString()} ${m.unit}`}
              </span>
              <span style="color: var(--amber);">+${m.xp} XP</span>
            </div>
            <div class="quest-progress-track" style="height: 6px; margin-bottom: 8px;">
              <div class="quest-progress-bar" style="width: ${pct}%; background: ${isUnlocked ? 'linear-gradient(90deg, var(--emerald), #059669)' : 'linear-gradient(90deg, var(--purple), var(--cyan))'};"></div>
            </div>
            <div style="font-size: 0.72rem; color: var(--text-dim); text-align: right; text-transform: uppercase; font-weight: 700;">
              ${m.category} Milestone
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // ==========================================
    // INDEXEDDB OFFLINE PHOTO VAULT & ENGINE
    // ==========================================
    function initPhotoDB() {
      return new Promise((resolve) => {
        if (photoDB) return resolve(photoDB);
        try {
          const req = indexedDB.open('AethosPhotoVaultDB', 1);
          req.onupgradeneeded = (e) => {
            const db = e.target.result;
            if (!db.objectStoreNames.contains('daily_photos')) {
              db.createObjectStore('daily_photos', { keyPath: 'day' });
            }
          };
          req.onsuccess = (e) => {
            photoDB = e.target.result;
            resolve(photoDB);
          };
          req.onerror = () => resolve(null);
        } catch (err) {
          resolve(null);
        }
      });
    }

    async function getPhotoFromDB(day) {
      try {
        const db = await initPhotoDB();
        if (!db) {
          const fallback = localStorage.getItem(`gym_photo_${day}`);
          return fallback ? JSON.parse(fallback) : null;
        }
        return new Promise((resolve) => {
          const tx = db.transaction('daily_photos', 'readonly');
          const store = tx.objectStore('daily_photos');
          const req = store.get(day);
          req.onsuccess = () => resolve(req.result || null);
          req.onerror = () => {
            const fallback = localStorage.getItem(`gym_photo_${day}`);
            resolve(fallback ? JSON.parse(fallback) : null);
          };
        });
      } catch (err) {
        const fallback = localStorage.getItem(`gym_photo_${day}`);
        return fallback ? JSON.parse(fallback) : null;
      }
    }

    async function getAllPhotosFromDB() {
      try {
        const db = await initPhotoDB();
        if (!db) {
          const results = [];
          photosLoggedDays.forEach(d => {
            const item = localStorage.getItem(`gym_photo_${d}`);
            if (item) {
              try { results.push(JSON.parse(item)); } catch(e) {}
            }
          });
          results.sort((a, b) => a.day - b.day);
          return results;
        }
        return new Promise((resolve) => {
          const tx = db.transaction('daily_photos', 'readonly');
          const store = tx.objectStore('daily_photos');
          const req = store.getAll();
          req.onsuccess = () => {
            const results = req.result || [];
            results.sort((a, b) => a.day - b.day);
            resolve(results);
          };
          req.onerror = () => resolve([]);
        });
      } catch (err) {
        return [];
      }
    }

    async function savePhotoToDB(day, dataUrl, note) {
      const record = {
        day: parseInt(day, 10),
        dataUrl,
        note: note || '',
        timestamp: Date.now(),
        dateStr: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
      };
      try {
        const db = await initPhotoDB();
        if (!db) {
          try { localStorage.setItem(`gym_photo_${day}`, JSON.stringify(record)); } catch(e) {}
          photosLoggedDays.add(parseInt(day, 10));
          localStorage.setItem('gym_photos_logged_days', JSON.stringify(Array.from(photosLoggedDays)));
          return true;
        }
        return new Promise((resolve) => {
          const tx = db.transaction('daily_photos', 'readwrite');
          const store = tx.objectStore('daily_photos');
          const req = store.put(record);
          req.onsuccess = () => {
            photosLoggedDays.add(parseInt(day, 10));
            localStorage.setItem('gym_photos_logged_days', JSON.stringify(Array.from(photosLoggedDays)));
            resolve(true);
          };
          req.onerror = () => {
            try { localStorage.setItem(`gym_photo_${day}`, JSON.stringify(record)); } catch(e) {}
            photosLoggedDays.add(parseInt(day, 10));
            localStorage.setItem('gym_photos_logged_days', JSON.stringify(Array.from(photosLoggedDays)));
            resolve(true);
          };
        });
      } catch (err) {
        try { localStorage.setItem(`gym_photo_${day}`, JSON.stringify(record)); } catch(e) {}
        photosLoggedDays.add(parseInt(day, 10));
        localStorage.setItem('gym_photos_logged_days', JSON.stringify(Array.from(photosLoggedDays)));
        return true;
      }
    }

    function openPhotoModal(day) {
      const targetDay = day || currentDay;
      const titleEl = document.getElementById('photoModalDayTitle');
      const wmEl = document.getElementById('watermarkDay');
      const saveNum = document.getElementById('btnSaveDayNum');

      if (titleEl) titleEl.innerText = `Day ${targetDay}`;
      if (wmEl) wmEl.innerText = `${targetDay}`;
      if (saveNum) saveNum.innerText = `${targetDay}`;

      const preview = document.getElementById('photoModalImgPreview');
      const watermark = document.getElementById('photoWatermarkTag');
      const placeholder = document.getElementById('photoPlaceholderText');
      const saveBtn = document.getElementById('btnSaveDayPhoto');
      const noteInput = document.getElementById('photoNoteInput');

      getPhotoFromDB(targetDay).then(existing => {
        if (existing) {
          if (preview) { preview.src = existing.dataUrl; preview.style.display = 'block'; }
          if (watermark) watermark.style.display = 'block';
          if (placeholder) placeholder.style.display = 'none';
          if (saveBtn) { saveBtn.style.display = 'block'; saveBtn.innerText = `Update Day ${targetDay} Photo`; }
          if (noteInput) noteInput.value = existing.note || '';
          selectedPhotoDataUrl = existing.dataUrl;
        } else {
          if (preview) { preview.src = ''; preview.style.display = 'none'; }
          if (watermark) watermark.style.display = 'none';
          if (placeholder) placeholder.style.display = 'block';
          if (saveBtn) { saveBtn.style.display = 'none'; saveBtn.innerText = `💾 Save For Day ${targetDay} (+75 XP)`; }
          if (noteInput) noteInput.value = '';
          selectedPhotoDataUrl = null;
        }
      });

      openModal('photoModal');
    }

    function triggerCameraInput() {
      document.getElementById('photoCameraInput')?.click();
    }

    function triggerGalleryInput() {
      document.getElementById('photoGalleryInput')?.click();
    }

    function handlePhotoSelected(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const maxDim = 1280;
          let w = img.width;
          let h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) {
              h = Math.round((h * maxDim) / w);
              w = maxDim;
            } else {
              w = Math.round((w * maxDim) / h);
              h = maxDim;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          selectedPhotoDataUrl = canvas.toDataURL('image/jpeg', 0.85);

          const preview = document.getElementById('photoModalImgPreview');
          const watermark = document.getElementById('photoWatermarkTag');
          const placeholder = document.getElementById('photoPlaceholderText');
          const saveBtn = document.getElementById('btnSaveDayPhoto');

          if (preview) { preview.src = selectedPhotoDataUrl; preview.style.display = 'block'; }
          if (watermark) watermark.style.display = 'block';
          if (placeholder) placeholder.style.display = 'none';
          if (saveBtn) saveBtn.style.display = 'block';
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
      if (event.target) event.target.value = '';
    }

    async function saveDayPhoto() {
      if (!selectedPhotoDataUrl) return;
      const day = currentDay;
      const note = document.getElementById('photoNoteInput')?.value || '';

      await savePhotoToDB(day, selectedPhotoDataUrl, note);
      photosLoggedDays.add(day);
      playAudioTone(659.25, 'triangle', 0.2);
      triggerHaptic([50, 30, 50]);
      closeModal('photoModal');

      updatePhotoUIForDay(day);
      checkAchievements();
      updateMissionChecklist();
      if (document.getElementById('photosView')?.classList.contains('active')) {
        renderPhotoGallery();
      }
    }

    async function updatePhotoUIForDay(day) {
      const thumb = document.getElementById('dayPhotoThumb');
      const status = document.getElementById('photoDockStatus');
      const dayNum = document.getElementById('photoDockDay');
      const heroDay = document.getElementById('photoHeroDay');
      const loggedPhotosBadge = document.getElementById('loggedPhotosCount');

      if (dayNum) dayNum.innerText = `${day}`;
      if (heroDay) heroDay.innerText = `${day}`;
      if (loggedPhotosBadge) loggedPhotosBadge.innerText = `${photosLoggedDays.size}`;

      const photo = await getPhotoFromDB(day);
      if (photo && thumb) {
        photosLoggedDays.add(day);
        thumb.src = photo.dataUrl;
        if (status) {
          status.innerText = "✓ Photo Saved";
          status.style.background = "rgba(16, 185, 129, 0.2)";
          status.style.color = "var(--emerald)";
        }
      } else if (thumb) {
        photosLoggedDays.delete(day);
        thumb.src = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='50' height='50' viewBox='0 0 50 50'><rect width='50' height='50' fill='%23131d36'/><text x='50%25' y='55%25' text-anchor='middle' fill='%2364748b' font-size='20'>📸</text></svg>";
        if (status) {
          status.innerText = "Pending Photo";
          status.style.background = "rgba(148, 163, 184, 0.15)";
          status.style.color = "#94a3b8";
        }
      }
      updateMissionChecklist();
    }

    async function renderPhotoGallery() {
      const grid = document.getElementById('photoGalleryGrid');
      const countEl = document.getElementById('galleryCount');
      if (!grid) return;

      const photos = await getAllPhotosFromDB();
      if (countEl) countEl.innerText = `${photos.length} Photo${photos.length === 1 ? '' : 's'}`;

      if (photos.length === 0) {
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: var(--bg-card); border-radius: var(--radius-md); border: 1px dashed var(--border);">
            <div style="font-size: 3rem; margin-bottom: 8px;">📸</div>
            <h4 style="color: #fff; margin-bottom: 6px;">No Transformation Photos Logged Yet</h4>
            <p style="color: var(--text-muted); font-size: 0.88rem; max-width: 480px; margin: 0 auto 16px;">
              Log today's workout photo to establish your baseline. Every photo earns +75 XP and unlocks visual milestone badges.
            </p>
            <button class="btn-photo-action" onclick="openPhotoModal(currentDay)">
              📸 Take Day ${currentDay} Photo Now
            </button>
          </div>
        `;
        return;
      }

      grid.innerHTML = '';
      photos.forEach(p => {
        const card = document.createElement('div');
        card.className = 'photo-gallery-card';
        card.innerHTML = `
          <img src="${p.dataUrl}" class="photo-gallery-img" alt="Day ${p.day} Photo" onclick="openPhotoModal(${p.day})" title="Click to view/edit">
          <div class="photo-card-info">
            <div>
              <strong style="color: #fff; font-size: 0.88rem; display: block;">Day ${p.day}</strong>
              <span style="font-size: 0.74rem; color: var(--text-dim);">${p.dateStr}</span>
            </div>
            <button onclick="setAsSliderTarget(${p.day})" class="nav-pill-btn" style="padding: 3px 8px; font-size: 0.72rem; border-color: var(--cyan); color: var(--cyan);" title="Compare in Split Slider">
              Compare ⇄
            </button>
          </div>
          ${p.note ? `<div style="padding: 6px 12px; font-size: 0.75rem; color: var(--text-muted); background: rgba(0,0,0,0.3); border-top: 1px solid rgba(255,255,255,0.04); font-style: italic;">"${p.note}"</div>` : ''}
        `;
        grid.appendChild(card);
      });

      updateBeforeAfterSlider(photos);
    }

    async function updateBeforeAfterSlider(photos) {
      if (!photos) photos = await getAllPhotosFromDB();
      const imgBefore = document.getElementById('baImgBefore');
      const imgAfter = document.getElementById('baImgAfter');
      const labelBefore = document.getElementById('baLabelBefore');
      const labelAfter = document.getElementById('baLabelAfter');

      if (!imgBefore || !imgAfter) return;

      if (photos.length === 0) {
        labelBefore.innerText = "Day 1 Baseline";
        labelAfter.innerText = "Pending";
        return;
      }

      if (photos.length === 1) {
        imgBefore.src = photos[0].dataUrl;
        imgAfter.src = photos[0].dataUrl;
        labelBefore.innerText = `Day ${photos[0].day} Baseline`;
        labelAfter.innerText = `Day ${photos[0].day} (Take Day 2+ to compare)`;
        return;
      }

      const firstPhoto = photos[0];
      const lastPhoto = photos[photos.length - 1];

      imgBefore.src = firstPhoto.dataUrl;
      imgAfter.src = lastPhoto.dataUrl;
      labelBefore.innerText = `Day ${firstPhoto.day} (${firstPhoto.dateStr})`;
      labelAfter.innerText = `Day ${lastPhoto.day} (${lastPhoto.dateStr})`;
    }

    async function setAsSliderTarget(day) {
      const photo = await getPhotoFromDB(day);
      if (!photo) return;
      const imgAfter = document.getElementById('baImgAfter');
      const labelAfter = document.getElementById('baLabelAfter');
      if (imgAfter && labelAfter) {
        imgAfter.src = photo.dataUrl;
        labelAfter.innerText = `Day ${photo.day} (${photo.dateStr})`;
        document.getElementById('baSliderContainer')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function setupBeforeAfterSlider() {
      const container = document.getElementById('baSliderContainer');
      const bar = document.getElementById('baSliderBar');
      const wrap = document.getElementById('baBeforeWrap');
      if (!container || !bar || !wrap) return;

      let isDragging = false;

      const moveSlider = (clientX) => {
        const rect = container.getBoundingClientRect();
        let x = clientX - rect.left;
        if (x < 0) x = 0;
        if (x > rect.width) x = rect.width;
        const pct = (x / rect.width) * 100;
        wrap.style.width = `${pct}%`;
        bar.style.left = `${pct}%`;
      };

      container.addEventListener('mousedown', (e) => {
        isDragging = true;
        moveSlider(e.clientX);
      });
      window.addEventListener('mouseup', () => { isDragging = false; });
      window.addEventListener('mousemove', (e) => {
        if (isDragging) moveSlider(e.clientX);
      });

      container.addEventListener('touchstart', (e) => {
        isDragging = true;
        moveSlider(e.touches[0].clientX);
      }, { passive: true });
      window.addEventListener('touchend', () => { isDragging = false; });
      window.addEventListener('touchmove', (e) => {
        if (isDragging) moveSlider(e.touches[0].clientX);
      }, { passive: true });
    }

    function toggleCurrentDayCompletion() {
      if (completedDays.has(currentDay)) {
        completedDays.delete(currentDay);
        triggerHaptic(25);
      } else {
        completedDays.add(currentDay);
        playAudioTone(523.25, 'triangle', 0.3);
        triggerHaptic([60, 40, 60]);
        speakAnnouncement(`Congratulations on completing Day ${currentDay}! Keep going!`);
      }
      localStorage.setItem('gym_365_completed', JSON.stringify(Array.from(completedDays)));
      renderActiveDay(currentDay);
    }

    function changeDay(delta) {
      let next = currentDay + delta;
      if (next < 1) next = 1;
      if (next > 365) next = 365;
      renderActiveDay(next);
      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    function onDayInputChange(val) {
      let d = parseInt(val, 10);
      if (isNaN(d) || d < 1) d = 1;
      if (d > 365) d = 365;
      renderActiveDay(d);
    }

    function onSliderChange(val) {
      renderActiveDay(val);
    }

    let timerInt = null;
    let secLeft = 60;

    function startTimer(s) {
      clearInterval(timerInt);
      secLeft = s;
      updateTimerUI();
      timerInt = setInterval(() => {
        secLeft--;
        updateTimerUI();
        if (secLeft <= 0) {
          clearInterval(timerInt);
          if (typeof SoundFX !== 'undefined' && SoundFX.playRestTimerAlert) {
            SoundFX.playRestTimerAlert();
          } else {
            playAudioTone(880, 'sine', 0.5);
          }
          triggerHaptic([100, 50, 100]);
          speakAnnouncement("Rest period complete. Begin next set!");
        }
      }, 1000);
    }

    function resetTimer() {
      clearInterval(timerInt);
      secLeft = 60;
      updateTimerUI();
    }

    function updateTimerUI() {
      const m = Math.floor(secLeft / 60).toString().padStart(2, '0');
      const s = (secLeft % 60).toString().padStart(2, '0');
      document.getElementById('timerDigits').innerText = `${m}:${s}`;
    }

    function renderCalendarGrid() {
      const body = document.getElementById('calendarBody');
      body.innerHTML = '';

      for (let m = 1; m <= 12; m++) {
        const title = document.createElement('div');
        title.style.color = 'var(--cyan)';
        title.style.fontWeight = '800';
        title.style.fontSize = '0.95rem';
        title.style.margin = '16px 0 8px';
        title.innerText = `MONTH ${m} (Days ${(m - 1) * 30 + 1} – ${Math.min(365, m * 30)})`;
        body.appendChild(title);

        const grid = document.createElement('div');
        grid.className = 'cal-grid-365';

        const sDay = (m - 1) * 30 + 1;
        const eDay = (m === 12) ? 365 : m * 30;

        for (let d = sDay; d <= eDay; d++) {
          const cell = document.createElement('div');
          cell.className = 'cal-cell';
          cell.innerText = d;

          if (d === currentDay) cell.classList.add('selected');
          if (completedDays.has(d)) cell.classList.add('completed');

          for (const alertM of MILESTONES) {
            if (d >= (alertM.startDay - 5) && d < alertM.startDay) {
              cell.classList.add('has-alert');
              break;
            }
          }

          cell.onclick = () => {
            closeModal('calendarModal');
            switchView('workoutView');
            renderActiveDay(d);
          };

          grid.appendChild(cell);
        }
        body.appendChild(grid);
      }
    }

    function openModal(id) {
      if (id === 'calendarModal') renderCalendarGrid();
      if (id === 'metricsModal') renderMetricsTable();
      document.getElementById(id).classList.add('active');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    function closeModalOnBackdrop(e, id) {
      if (e.target.id === id) closeModal(id);
    }

    function exportDataJSON() {
      const data = {
        completedDays: Array.from(completedDays),
        loggedSets: loggedSetData,
        metricsLogs: loggedMetrics,
        waterLog: waterLog,
        progressions: userProgressions,
        photosLoggedDays: Array.from(photosLoggedDays),
        unlockedMilestones: Array.from(unlockedMilestones),
        exportedAt: new Date().toISOString()
      };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `Aethos365Pro_Backup_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
    }

    function triggerImportJSON() {
      document.getElementById('importFileInput')?.click();
    }

    function handleFileImport(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const data = JSON.parse(evt.target.result);
          if (data.completedDays) {
            completedDays = new Set(data.completedDays);
            localStorage.setItem('gym_365_completed', JSON.stringify(data.completedDays));
          }
          if (data.loggedSets) {
            loggedSetData = data.loggedSets;
            localStorage.setItem('gym_set_logs', JSON.stringify(loggedSetData));
          }
          if (data.metricsLogs) {
            loggedMetrics = data.metricsLogs;
            localStorage.setItem('gym_metrics_logs', JSON.stringify(loggedMetrics));
          }
          if (data.waterLog) {
            waterLog = data.waterLog;
            localStorage.setItem('gym_water_log', JSON.stringify(waterLog));
          }
          if (data.progressions) {
            userProgressions = data.progressions;
            localStorage.setItem('gym_progressions', JSON.stringify(userProgressions));
          }
          if (data.photosLoggedDays) {
            photosLoggedDays = new Set(data.photosLoggedDays);
            localStorage.setItem('gym_photos_logged_days', JSON.stringify(Array.from(photosLoggedDays)));
          }
          if (data.unlockedMilestones) {
            unlockedMilestones = new Set(data.unlockedMilestones);
            localStorage.setItem('gym_unlocked_milestones', JSON.stringify(Array.from(unlockedMilestones)));
          }
          renderActiveDay(currentDay);
          renderMetricsTable();
          renderHeatmapGrid();
          checkAchievements();
          updateMissionChecklist();
          playAudioTone(587.33, 'triangle', 0.3);
          alert("Backup successfully restored! All workout logs, metrics, photos, and milestone data are now loaded.");
        } catch (err) {
          alert("Invalid backup file format. Please ensure you select a valid JSON backup exported from AETHOS 365.");
        }
      };
      reader.readAsText(file);
    }

    function jumpToMonthDay(day) {
      switchView('workoutView');
      renderActiveDay(day);
      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    function printWorkoutSheet() {
      window.print();
    }

    // ==========================================
    // 365-DAY CONSISTENCY MATRIX ENGINE
    // ==========================================
    function renderHeatmapGrid() {
      const fullGrid = document.getElementById('heatmapGrid52');
      if (!fullGrid) return;
      fullGrid.innerHTML = '';

      const doneCount = completedDays.size;
      const streakSummary = document.getElementById('heatmapStreakSummary');
      if (streakSummary) {
        streakSummary.innerText = `${doneCount} / 365 Days Logged (${((doneCount / 365) * 100).toFixed(1)}%)`;
      }

      let activeCell = null;

      for (let d = 1; d <= 365; d++) {
        const dayOfWeek = ((d - 1) % 7) + 1;
        const isRecovery = (dayOfWeek === 2 || dayOfWeek === 4);
        const isDone = completedDays.has(d);
        const isToday = (d === currentDay);

        let hasAlert = false;
        for (const m of MILESTONES) {
          if (d >= (m.startDay - 5) && d < m.startDay) {
            hasAlert = true;
            break;
          }
        }

        const cell = document.createElement('div');
        cell.className = 'h-cell';
        if (isToday) {
          cell.classList.add('active-day');
          activeCell = cell;
        }
        if (isDone) cell.classList.add('done');
        else if (hasAlert) cell.classList.add('alert');
        else if (isRecovery) cell.classList.add('rec');

        cell.title = `Day ${d}: ${isDone ? '✓ Completed' : (isRecovery ? 'Active Recovery' : 'Workout Day')}`;
        cell.onclick = () => {
          if (!document.getElementById('workoutView')?.classList.contains('active')) {
            switchView('workoutView');
          }
          renderActiveDay(d);
        };

        fullGrid.appendChild(cell);
      }

      // Auto-scroll heatmap smoothly to center the active day on mobile or narrow viewports
      if (activeCell) {
        const scrollArea = document.getElementById('heatmapScrollArea');
        if (scrollArea && scrollArea.scrollWidth > scrollArea.clientWidth) {
          const cellLeft = activeCell.offsetLeft;
          scrollArea.scrollTo({
            left: Math.max(0, cellLeft - (scrollArea.clientWidth / 2) + 15),
            behavior: 'smooth'
          });
        }
      }
    }

    // ==========================================
    // TDEE & MACRO PRECISION ENGINE
    // ==========================================
    function selectQuickGoal(goalKey) {
      const sel = document.getElementById('calcGoal');
      if (sel) {
        sel.value = goalKey;
        syncQuickGoal();
        calculateMacros();
      }
    }

    function syncQuickGoal() {
      const goal = document.getElementById('calcGoal')?.value || 'recomp';
      document.getElementById('chipGoalRecomp')?.classList.toggle('active', goal === 'recomp');
      document.getElementById('chipGoalBulk')?.classList.toggle('active', goal === 'bulk');
      document.getElementById('chipGoalCut')?.classList.toggle('active', goal === 'cut');
    }

    function calculateMacros() {
      syncQuickGoal();
      const wt = parseFloat(document.getElementById('calcWeight')?.value) || 82.0;
      const goal = document.getElementById('calcGoal')?.value || 'recomp';
      const activity = parseFloat(document.getElementById('calcActivity')?.value) || 1.35;

      // Mifflin-St Jeor Formula for 35yo 183cm (6'0") Male:
      const bmr = (10 * wt) + (6.25 * 183) - (5 * 35) + 5;
      const tdee = Math.round(bmr * activity);

      let targetCals = tdee;
      let proteinPerKg = 2.0;

      if (goal === 'bulk') {
        targetCals = tdee + 250;
        proteinPerKg = 2.0;
      } else if (goal === 'cut') {
        targetCals = tdee - 500;
        proteinPerKg = 2.2;
      } else {
        targetCals = tdee;
        proteinPerKg = 2.0;
      }

      const proteinGrams = Math.round(wt * proteinPerKg);
      const fatGrams = Math.round((targetCals * 0.25) / 9);
      const carbGrams = Math.max(50, Math.round((targetCals - (proteinGrams * 4) - (fatGrams * 9)) / 4));
      const waterLiters = ((wt * 0.035) + 0.5).toFixed(1);

      const pCals = proteinGrams * 4;
      const cCals = carbGrams * 4;
      const fCals = fatGrams * 9;
      const totalMacroCals = pCals + cCals + fCals;

      const pPct = Math.round((pCals / totalMacroCals) * 100);
      const cPct = Math.round((cCals / totalMacroCals) * 100);
      const fPct = 100 - pPct - cPct;

      if (document.getElementById('calcCalories')) document.getElementById('calcCalories').innerText = targetCals.toLocaleString();
      if (document.getElementById('calcProtein')) document.getElementById('calcProtein').innerText = `${proteinGrams}g`;
      if (document.getElementById('calcCarbs')) document.getElementById('calcCarbs').innerText = `${carbGrams}g`;
      if (document.getElementById('calcFats')) document.getElementById('calcFats').innerText = `${fatGrams}g`;
      if (document.getElementById('calcWater')) document.getElementById('calcWater').innerText = `${waterLiters}L`;

      if (document.getElementById('macroRatioSummary')) {
        document.getElementById('macroRatioSummary').innerText = `Protein ${pPct}% • Carbs ${cPct}% • Fats ${fPct}%`;
      }
      if (document.getElementById('macroBarP')) document.getElementById('macroBarP').style.width = `${pPct}%`;
      if (document.getElementById('macroBarC')) document.getElementById('macroBarC').style.width = `${cPct}%`;
      if (document.getElementById('macroBarF')) document.getElementById('macroBarF').style.width = `${fPct}%`;
    }

    // ==========================================
    // VOICE COACH SETUP ENGINE
    // ==========================================
    function initVoices() {
      if (!('speechSynthesis' in window)) return;
      function populate() {
        availableVoices = window.speechSynthesis.getVoices();
        const select = document.getElementById('voiceSelect');
        if (!select || availableVoices.length === 0) return;
        select.innerHTML = '<option value="">Default System Voice</option>';
        availableVoices.forEach(v => {
          const opt = document.createElement('option');
          opt.value = v.voiceURI;
          opt.innerText = `${v.name} (${v.lang})`;
          if (v.voiceURI === voiceSettings.voiceURI) opt.selected = true;
          select.appendChild(opt);
        });
      }
      populate();
      if (window.speechSynthesis && window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = populate;
      }

      const rateInput = document.getElementById('voiceRateInput');
      const pitchInput = document.getElementById('voicePitchInput');
      if (rateInput) rateInput.value = voiceSettings.rate || 1.05;
      if (pitchInput) pitchInput.value = voiceSettings.pitch || 1.0;
      if (document.getElementById('voiceRateVal')) document.getElementById('voiceRateVal').innerText = `${rateInput?.value}x`;
      if (document.getElementById('voicePitchVal')) document.getElementById('voicePitchVal').innerText = `${pitchInput?.value}`;
    }

    function saveVoiceSettings() {
      const select = document.getElementById('voiceSelect');
      const rateInput = document.getElementById('voiceRateInput');
      const pitchInput = document.getElementById('voicePitchInput');

      voiceSettings.voiceURI = select ? select.value : '';
      voiceSettings.rate = rateInput ? parseFloat(rateInput.value) : 1.05;
      voiceSettings.pitch = pitchInput ? parseFloat(pitchInput.value) : 1.0;

      if (document.getElementById('voiceRateVal')) document.getElementById('voiceRateVal').innerText = `${voiceSettings.rate}x`;
      if (document.getElementById('voicePitchVal')) document.getElementById('voicePitchVal').innerText = `${voiceSettings.pitch}`;

      localStorage.setItem('gym_voice_settings', JSON.stringify(voiceSettings));
    }

    function testVoiceCoach() {
      speakAnnouncement("Voice coach configured! Ready to power your 365-day transformation.");
    }

    // ==========================================
    // ANDROID PWA & HAPTIC FEEDBACK ENGINE
    // ==========================================
    let deferredInstallPrompt = null;
    const isStandalone = (typeof window.matchMedia === 'function' && window.matchMedia('(display-mode: standalone)')?.matches) || window.navigator?.standalone === true;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredInstallPrompt = e;
      const btn = document.getElementById('btnInstallApp');
      if (btn && !isStandalone) {
        btn.innerHTML = '📲 Install App (Ready)';
        btn.style.borderColor = 'var(--emerald)';
        btn.style.color = '#34d399';
      }
    });

    window.addEventListener('appinstalled', () => {
      console.log('AETHOS 365 installed successfully as native Android WebAPK!');
      deferredInstallPrompt = null;
      const btn = document.getElementById('btnInstallApp');
      if (btn) {
        btn.innerHTML = '✅ Installed';
        btn.style.color = '#a7f3d0';
      }
    });

    function triggerPWAInstall() {
      if (isStandalone) {
        alert("🎉 AETHOS 365 is already running as an installed standalone app on your Google Pixel!");
        return;
      }

      if (deferredInstallPrompt) {
        deferredInstallPrompt.prompt();
        deferredInstallPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            console.log('User accepted the AETHOS 365 install prompt');
          }
          deferredInstallPrompt = null;
        });
      } else {
        alert("📲 To install on your Google Pixel:\n\n1. In Google Chrome, tap the 3 dots menu (⋮) in the top-right corner.\n2. Tap 'Install app' (or 'Add to Home screen').\n3. Tap 'Install' in the Android popup dialog.\n\n✨ The app icon will appear right in your Pixel app drawer and home screen!");
      }
    }

    function triggerHaptic(duration = 30) {
      try {
        if ('vibrate' in navigator) {
          navigator.vibrate(duration);
        }
      } catch (e) {}
    }

    // Register Service Worker for 100% Offline Capability
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js').then((reg) => {
          console.log('[PWA] Service Worker registered successfully', reg.scope);
        }).catch((err) => {
          console.log('[PWA] Service Worker registration failed', err);
        });
      });
    }

    if (isStandalone) {
      const btn = document.getElementById('btnInstallApp');
      if (btn) btn.innerHTML = '📱 Pixel App';
    }

// ==========================================
// ZENITH BEATS & WORKOUT SOUNDTRACK ENGINE
// ==========================================

const GymMusic = {
  ctx: null,
  masterGain: null,
  duckGain: null,
  analyser: null,
  isPlaying: false,
  isDucked: false,
  currentTrackId: 'cyber_pump',
  volume: 0.75,
  tempoBpm: 128,
  timerId: null,
  current16thNote: 0,
  nextNoteTime: 0.0,
  lookahead: 25.0, // ms
  scheduleAheadTime: 0.1, // seconds
  localAudio: null,
  localFiles: [],
  currentFileIdx: 0,
  ytMusicUrl: (typeof localStorage !== 'undefined' ? localStorage.getItem('gym_yt_music_url') : null) || 's5kD4xohZtM',
  ytMusicName: (typeof localStorage !== 'undefined' ? localStorage.getItem('gym_yt_music_name') : null) || '🔥 Gym Phonk & Shred',
  ytMusicType: (typeof localStorage !== 'undefined' ? localStorage.getItem('gym_yt_music_type') : null) || 'video',

  tracks: [
    { id: 'cyber_pump', name: '⚡ Cyber Heavy Pump', bpm: 128, genre: 'High-BPM Hardstyle & Sub-Bass', tag: 'HEAVY LIFTS', desc: 'Heavy 4-on-the-floor kick, rolling 16th acid bassline, and punchy claps. Fuels max-effort sets.' },
    { id: 'synthwave', name: '🌌 Synthwave Drive', bpm: 114, genre: '80s Retro Cyberpunk Arps', tag: 'TEMPO FLOW', desc: 'Nostalgic 80s sawtooth arpeggios, analog snare, and melodic chords for steady rep cadences.' },
    { id: 'lofi_focus', name: '🎧 Lo-Fi Deep Focus', bpm: 84, genre: 'Chillhop Rhodes & Boom-Bap', tag: 'MOBILITY', desc: 'Warm Rhodes electric piano chords and laidback boom-bap rhythm. Perfect for warm-ups and calisthenics.' },
    { id: 'zen_432', name: '🧘 432Hz Zen Recovery', bpm: 60, genre: 'Alpha Waves & Harmonic Drone', tag: 'COOL-DOWN', desc: '432Hz healing harmonic drones and binaural pulsations for post-workout decompression and box breathing.' },
    { id: 'local_mp3', name: '📁 My Local MP3 Files', bpm: 0, genre: 'Custom User Playlist', tag: 'CUSTOM', desc: 'Load your personal workout playlist MP3 / WAV files directly from your phone or laptop.' },
    { id: 'youtube_music', name: '🔴 YouTube Music', bpm: 0, genre: 'Personal Playlist & Gym Radio', tag: 'YT MUSIC', desc: 'Stream your personal YouTube Music playlist or curated gym radio with smart Voice Coach ducking.' }
  ],

  init() {
    if (this.ctx) return;
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (AudioCtx) {
      this.ctx = new AudioCtx();
      this.masterGain = this.ctx.createGain();
      this.duckGain = this.ctx.createGain();
      if (this.ctx.createAnalyser) {
        this.analyser = this.ctx.createAnalyser();
      }

      if (this.masterGain.gain.setValueAtTime) {
        this.masterGain.gain.setValueAtTime(this.volume, this.ctx.currentTime);
        this.duckGain.gain.setValueAtTime(1.0, this.ctx.currentTime);
      }

      // Audio Graph: Synth / Audio -> duckGain -> masterGain -> analyser -> destination
      this.duckGain.connect(this.masterGain);
      if (this.analyser && this.analyser.connect) {
        this.masterGain.connect(this.analyser);
        this.analyser.connect(this.ctx.destination);
      } else {
        this.masterGain.connect(this.ctx.destination);
      }
    }

    // Initialize YouTube Music label & open app link from saved preference
    const ytLabel = document.getElementById('ytMusicCurrentLabel');
    if (ytLabel && this.ytMusicName) ytLabel.innerText = this.ytMusicName;
    const openBtn = document.getElementById('btnYtMusicOpenApp');
    if (openBtn && this.ytMusicUrl) {
      openBtn.href = this.ytMusicType === 'playlist'
        ? `https://music.youtube.com/playlist?list=${this.ytMusicUrl}`
        : `https://music.youtube.com/watch?v=${this.ytMusicUrl}`;
    }
    const ytTrack = this.tracks.find(t => t.id === 'youtube_music');
    if (ytTrack && this.ytMusicName) {
      ytTrack.name = '🔴 ' + this.ytMusicName;
    }
  },

  parseYouTubeMusicInput(input) {
    if (!input || typeof input !== 'string') return null;
    input = input.trim();
    const listMatch = input.match(/[?&]list=([a-zA-Z0-9_-]+)/);
    if (listMatch) return { type: 'playlist', id: listMatch[1] };
    const vMatch = input.match(/(?:v=|\/embed\/|youtu\.be\/|\/v\/|\/e\/|watch\?v=)([a-zA-Z0-9_-]{11})/);
    if (vMatch) return { type: 'video', id: vMatch[1] };
    if (/^[a-zA-Z0-9_-]{12,}$/.test(input)) return { type: 'playlist', id: input };
    if (/^[a-zA-Z0-9_-]{11}$/.test(input)) return { type: 'video', id: input };
    return null;
  },

  connectYouTubeMusicFromInput() {
    const inputEl = document.getElementById('ytMusicUrlInput');
    const val = inputEl ? inputEl.value : '';
    if (!val || !val.trim()) {
      alert('Please enter or paste a YouTube Music playlist or track URL!');
      return;
    }
    const parsed = this.parseYouTubeMusicInput(val);
    if (!parsed) {
      alert('Could not detect a valid YouTube playlist or track ID. Please paste a link from YouTube Music (e.g., https://music.youtube.com/playlist?list=...)');
      return;
    }
    const friendlyName = parsed.type === 'playlist' ? '🎧 Connected Playlist' : '🎧 Connected YouTube Track';
    this.setYouTubeMusic(parsed.id, friendlyName, parsed.type);
    if (inputEl) inputEl.value = '';
  },

  setYouTubeMusic(idOrUrl, name, type = 'video') {
    let finalId = idOrUrl;
    let finalType = type;
    const parsed = this.parseYouTubeMusicInput(idOrUrl);
    if (parsed) {
      finalId = parsed.id;
      finalType = parsed.type;
    }

    this.ytMusicUrl = finalId;
    this.ytMusicName = name || 'YouTube Music Stream';
    this.ytMusicType = finalType;

    try {
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('gym_yt_music_url', finalId);
        localStorage.setItem('gym_yt_music_name', this.ytMusicName);
        localStorage.setItem('gym_yt_music_type', finalType);
      }
    } catch (e) {}

    const iframe = document.getElementById('gymYtMusicPlayerIframe');
    if (iframe) {
      const loc = (typeof window !== 'undefined' && window.location) ? window.location : (typeof location !== 'undefined' ? location : { protocol: 'http:', origin: 'http://localhost:3000' });
      const hasHttpOrigin = loc.protocol === 'http:' || loc.protocol === 'https:';
      const originParam = hasHttpOrigin ? `&origin=${encodeURIComponent(loc.origin || 'http://localhost:3000')}` : '';
      const embedSrc = finalType === 'playlist'
        ? `https://www.youtube-nocookie.com/embed/videoseries?list=${finalId}&enablejsapi=1&autoplay=1&rel=0&modestbranding=1${originParam}`
        : `https://www.youtube-nocookie.com/embed/${finalId}?enablejsapi=1&autoplay=1&rel=0&modestbranding=1${originParam}`;
      iframe.src = embedSrc;
    }

    // Update label & external link
    const label = document.getElementById('ytMusicCurrentLabel');
    if (label) label.innerText = this.ytMusicName;

    const openBtn = document.getElementById('btnYtMusicOpenApp');
    if (openBtn) {
      openBtn.href = finalType === 'playlist'
        ? `https://music.youtube.com/playlist?list=${finalId}`
        : `https://music.youtube.com/watch?v=${finalId}`;
    }

    const ytTrack = this.tracks.find(t => t.id === 'youtube_music');
    if (ytTrack) ytTrack.name = '🔴 ' + this.ytMusicName;

    this.selectTrack('youtube_music');
  },

  postMessageToYtPlayer(command, args = []) {
    const iframe = document.getElementById('gymYtMusicPlayerIframe');
    if (iframe && iframe.contentWindow) {
      try {
        iframe.contentWindow.postMessage(JSON.stringify({
          event: 'command',
          func: command,
          args: args
        }), '*');
      } catch (e) {}
    }
  },

  setVolume(val) {
    this.volume = Math.max(0, Math.min(1, parseFloat(val)));
    if (this.masterGain && this.ctx) {
      if (this.masterGain.gain.setTargetAtTime) {
        this.masterGain.gain.setTargetAtTime(this.volume, this.ctx.currentTime, 0.05);
      } else {
        this.masterGain.gain.value = this.volume;
      }
    }
    this.postMessageToYtPlayer('setVolume', [Math.round(this.volume * 100)]);
    const slider = document.getElementById('musicVolSlider');
    if (slider) slider.value = this.volume;
    const valText = document.getElementById('musicVolVal');
    if (valText) valText.innerText = Math.round(this.volume * 100) + '%';
  },

  duckVolume() {
    if (this.ctx && this.duckGain) {
      this.isDucked = true;
      if (this.duckGain.gain.cancelScheduledValues) {
        this.duckGain.gain.cancelScheduledValues(this.ctx.currentTime);
      }
      if (this.duckGain.gain.setTargetAtTime) {
        this.duckGain.gain.setTargetAtTime(0.18, this.ctx.currentTime, 0.05);
      } else {
        this.duckGain.gain.value = 0.18;
      }
    }
    this.postMessageToYtPlayer('setVolume', [18]);
    const badge = document.getElementById('musicDuckingBadge');
    if (badge) badge.style.display = 'inline-flex';
    const hudBadge = document.getElementById('hudMusicDuckingBadge');
    if (hudBadge) hudBadge.style.display = 'inline-flex';
  },

  restoreVolume() {
    if (this.ctx && this.duckGain) {
      this.isDucked = false;
      if (this.duckGain.gain.cancelScheduledValues) {
        this.duckGain.gain.cancelScheduledValues(this.ctx.currentTime);
      }
      if (this.duckGain.gain.setTargetAtTime) {
        this.duckGain.gain.setTargetAtTime(1.0, this.ctx.currentTime, 0.25);
      } else {
        this.duckGain.gain.value = 1.0;
      }
    }
    this.postMessageToYtPlayer('setVolume', [Math.round(this.volume * 100)]);
    const badge = document.getElementById('musicDuckingBadge');
    if (badge) badge.style.display = 'none';
    const hudBadge = document.getElementById('hudMusicDuckingBadge');
    if (hudBadge) hudBadge.style.display = 'none';
  },

  togglePlay() {
    this.init();
    if (this.ctx && this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
    if (this.isPlaying) {
      this.pause();
    } else {
      this.play();
    }
  },

  play() {
    this.init();
    if (this.ctx && this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
    this.isPlaying = true;
    this.updateUI();

    if (this.currentTrackId === 'youtube_music') {
      if (this.timerId) {
        clearTimeout(this.timerId);
        this.timerId = null;
      }
      this.postMessageToYtPlayer('playVideo');
      return;
    }

    if (this.currentTrackId === 'local_mp3') {
      if (this.localAudio && this.localFiles.length > 0) {
        this.localAudio.play().catch(() => {});
      }
      return;
    }

    const tObj = this.tracks.find(t => t.id === this.currentTrackId);
    if (tObj && tObj.bpm) this.tempoBpm = tObj.bpm;

    this.current16thNote = 0;
    this.nextNoteTime = (this.ctx ? this.ctx.currentTime : 0) + 0.05;
    this.scheduler();
  },

  pause() {
    this.isPlaying = false;
    if (this.timerId) {
      clearTimeout(this.timerId);
      this.timerId = null;
    }
    if (this.localAudio) {
      this.localAudio.pause();
    }
    this.postMessageToYtPlayer('pauseVideo');
    this.updateUI();
  },

  selectTrack(trackId) {
    const wasPlaying = this.isPlaying;
    if (wasPlaying) this.pause();
    this.currentTrackId = trackId;
    const tObj = this.tracks.find(t => t.id === trackId);
    if (tObj && tObj.bpm) this.tempoBpm = tObj.bpm;

    if (trackId !== 'youtube_music') {
      this.postMessageToYtPlayer('pauseVideo');
    }

    this.updateUI();
    if (wasPlaying || trackId === 'youtube_music') {
      this.play();
    }
  },

  nextTrack() {
    const idx = this.tracks.findIndex(t => t.id === this.currentTrackId);
    const nextIdx = (idx + 1) % this.tracks.length;
    this.selectTrack(this.tracks[nextIdx].id);
  },

  prevTrack() {
    const idx = this.tracks.findIndex(t => t.id === this.currentTrackId);
    const prevIdx = (idx - 1 + this.tracks.length) % this.tracks.length;
    this.selectTrack(this.tracks[prevIdx].id);
  },

  scheduler() {
    if (!this.isPlaying) return;
    while (this.nextNoteTime < this.ctx.currentTime + this.scheduleAheadTime) {
      this.scheduleNote(this.current16thNote, this.nextNoteTime);
      this.advanceNote();
    }
    this.timerId = setTimeout(() => this.scheduler(), this.lookahead);
  },

  advanceNote() {
    const secondsPerBeat = 60.0 / this.tempoBpm;
    this.nextNoteTime += 0.25 * secondsPerBeat; // 16th note
    this.current16thNote = (this.current16thNote + 1) % 16;
  },

  // Procedural Drum & Synth Oscillators
  playKick(time, punch = 1.0) {
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.connect(gain);
    gain.connect(this.duckGain);

    osc.frequency.setValueAtTime(140 * punch, time);
    if (osc.frequency.exponentialRampToValueAtTime) {
      osc.frequency.exponentialRampToValueAtTime(38, time + 0.08);
    }

    gain.gain.setValueAtTime(0.85, time);
    if (gain.gain.exponentialRampToValueAtTime) {
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.25);
    }

    osc.start(time);
    osc.stop(time + 0.25);
  },

  playSnare(time) {
    if (!this.ctx) return;
    // Tonal body
    const osc = this.ctx.createOscillator();
    const oscGain = this.ctx.createGain();
    osc.type = 'triangle';
    osc.connect(oscGain);
    oscGain.connect(this.duckGain);
    osc.frequency.setValueAtTime(180, time);
    if (osc.frequency.exponentialRampToValueAtTime) {
      osc.frequency.exponentialRampToValueAtTime(80, time + 0.1);
    }
    oscGain.gain.setValueAtTime(0.4, time);
    if (oscGain.gain.exponentialRampToValueAtTime) {
      oscGain.gain.exponentialRampToValueAtTime(0.01, time + 0.12);
    }
    osc.start(time);
    osc.stop(time + 0.12);

    // Noise snap
    try {
      const bufferSize = Math.floor(this.ctx.sampleRate * 0.15);
      const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
      const noise = this.ctx.createBufferSource();
      noise.buffer = buffer;
      const filter = this.ctx.createBiquadFilter();
      filter.type = 'highpass';
      filter.frequency.value = 1000;
      const noiseGain = this.ctx.createGain();
      noiseGain.gain.setValueAtTime(0.45, time);
      if (noiseGain.gain.exponentialRampToValueAtTime) {
        noiseGain.gain.exponentialRampToValueAtTime(0.01, time + 0.15);
      }
      noise.connect(filter);
      filter.connect(noiseGain);
      noiseGain.connect(this.duckGain);
      noise.start(time);
      noise.stop(time + 0.15);
    } catch (e) {}
  },

  playHiHat(time, open = false) {
    if (!this.ctx) return;
    try {
      const dur = open ? 0.2 : 0.04;
      const bufferSize = Math.floor(this.ctx.sampleRate * dur);
      const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
      const noise = this.ctx.createBufferSource();
      noise.buffer = buffer;
      const filter = this.ctx.createBiquadFilter();
      filter.type = 'highpass';
      filter.frequency.value = 7500;
      const gain = this.ctx.createGain();
      gain.gain.setValueAtTime(open ? 0.25 : 0.18, time);
      if (gain.gain.exponentialRampToValueAtTime) {
        gain.gain.exponentialRampToValueAtTime(0.001, time + dur);
      }
      noise.connect(filter);
      filter.connect(gain);
      gain.connect(this.duckGain);
      noise.start(time);
      noise.stop(time + dur);
    } catch (e) {}
  },

  playBassNote(freq, time, dur = 0.12, type = 'sawtooth') {
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const filter = this.ctx.createBiquadFilter();
    const gain = this.ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, time);

    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(1400, time);
    if (filter.frequency.exponentialRampToValueAtTime) {
      filter.frequency.exponentialRampToValueAtTime(250, time + dur);
    }
    filter.Q.value = 4;

    gain.gain.setValueAtTime(0.45, time);
    if (gain.gain.exponentialRampToValueAtTime) {
      gain.gain.exponentialRampToValueAtTime(0.001, time + dur);
    }

    osc.connect(filter);
    filter.connect(gain);
    gain.connect(this.duckGain);

    osc.start(time);
    osc.stop(time + dur);
  },

  playChordTone(freq, time, dur = 1.0, type = 'sine') {
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, time);
    gain.gain.setValueAtTime(0.12, time);
    if (gain.gain.exponentialRampToValueAtTime) {
      gain.gain.exponentialRampToValueAtTime(0.001, time + dur);
    }
    osc.connect(gain);
    gain.connect(this.duckGain);
    osc.start(time);
    osc.stop(time + dur);
  },

  scheduleNote(step, time) {
    if (this.currentTrackId === 'cyber_pump') {
      // 4-on-the-floor kick
      if (step === 0 || step === 4 || step === 8 || step === 12) {
        this.playKick(time, 1.1);
      }
      // Claps/snare on 4 and 12
      if (step === 4 || step === 12) {
        this.playSnare(time);
      }
      // Offbeat open hi-hat
      if (step % 2 === 0) {
        this.playHiHat(time, step % 4 === 2);
      }
      // 16th rolling acid synth bass
      const bassNotes = [55, 55, 65.41, 55, 73.42, 55, 65.41, 82.41, 55, 55, 65.41, 55, 98, 82.41, 73.42, 65.41];
      this.playBassNote(bassNotes[step], time, 0.1, 'sawtooth');
    }
    else if (this.currentTrackId === 'synthwave') {
      if (step === 0 || step === 8) this.playKick(time, 1.0);
      if (step === 4 || step === 12) this.playSnare(time);
      if (step % 2 === 0) this.playHiHat(time, false);
      const synthArp = [65.41, 98, 130.81, 98, 77.78, 116.54, 155.56, 116.54, 87.31, 130.81, 174.61, 130.81, 98, 146.83, 196, 146.83];
      this.playBassNote(synthArp[step], time, 0.14, 'square');
      if (step === 0) {
        this.playChordTone(261.63, time, 1.8, 'triangle');
        this.playChordTone(329.63, time, 1.8, 'triangle');
        this.playChordTone(392.00, time, 1.8, 'triangle');
      }
    }
    else if (this.currentTrackId === 'lofi_focus') {
      if (step === 0 || step === 10) this.playKick(time, 0.7);
      if (step === 4 || step === 12) this.playSnare(time);
      if (step % 4 === 0) this.playHiHat(time, false);
      if (step === 0 || step === 8) {
        const root = step === 0 ? 220 : 174.61;
        this.playChordTone(root, time, 1.5, 'sine');
        this.playChordTone(root * 1.25, time, 1.5, 'triangle');
        this.playChordTone(root * 1.5, time, 1.5, 'sine');
        this.playChordTone(root * 1.875, time, 1.5, 'triangle');
      }
    }
    else if (this.currentTrackId === 'zen_432') {
      if (step === 0) {
        this.playChordTone(216, time, 3.8, 'sine');
        this.playChordTone(432, time, 3.8, 'sine');
        this.playChordTone(432 * 1.5, time, 3.8, 'sine');
      }
    }
  },

  handleLocalFiles(event) {
    const files = Array.from(event.target.files || []);
    if (files.length === 0) return;
    this.localFiles = files;
    this.currentFileIdx = 0;
    this.playLocalFile(0);
  },

  playLocalFile(idx) {
    if (!this.localFiles[idx]) return;
    const file = this.localFiles[idx];
    const url = URL.createObjectURL(file);
    if (!this.localAudio) {
      this.localAudio = new Audio();
      this.localAudio.addEventListener('ended', () => {
        this.currentFileIdx = (this.currentFileIdx + 1) % this.localFiles.length;
        this.playLocalFile(this.currentFileIdx);
      });
      this.init();
      if (this.ctx && this.ctx.createMediaElementSource) {
        try {
          const src = this.ctx.createMediaElementSource(this.localAudio);
          src.connect(this.duckGain);
        } catch (e) {}
      }
    }
    this.localAudio.src = url;
    this.currentTrackId = 'local_mp3';
    const localTrack = this.tracks.find(t => t.id === 'local_mp3');
    if (localTrack) localTrack.name = '🎵 ' + file.name.replace(/\.[^/.]+$/, "");
    this.play();
  },

  updateUI() {
    // Header mini pill
    const pillTitle = document.getElementById('musicPillTitle');
    const pillStatus = document.getElementById('musicPillStatus');
    const miniToggle = document.getElementById('btnMusicMiniToggle');
    const headerPill = document.getElementById('headerMusicPill');

    const tObj = this.tracks.find(t => t.id === this.currentTrackId) || this.tracks[0];

    if (pillTitle) pillTitle.innerText = tObj.name;
    if (pillStatus) pillStatus.innerText = this.isPlaying ? `${tObj.bpm ? tObj.bpm + ' BPM • ' : ''}PLAYING` : 'WORKOUT BEATS';
    if (miniToggle) {
      miniToggle.innerText = this.isPlaying ? '⏸' : '▶';
      miniToggle.classList.toggle('playing', this.isPlaying);
    }
    if (headerPill) {
      headerPill.classList.toggle('playing', this.isPlaying);
    }

    // Modal UI elements
    const tagEl = document.getElementById('musicTrackTag');
    if (tagEl) tagEl.innerText = tObj.tag || 'BEATS';
    const modalTitle = document.getElementById('musicModalTrackTitle');
    if (modalTitle) modalTitle.innerText = tObj.name;
    const modalDesc = document.getElementById('musicModalTrackDesc');
    if (modalDesc) modalDesc.innerText = tObj.desc;
    const modalPlayBtn = document.getElementById('btnMusicModalPlay');
    if (modalPlayBtn) {
      if (this.currentTrackId === 'youtube_music') {
        modalPlayBtn.innerHTML = this.isPlaying ? '⏸ Pause YT Music' : '▶ Play YT Music';
      } else {
        modalPlayBtn.innerHTML = this.isPlaying ? '⏸ Pause Beats' : '▶ Play Workout Beats';
      }
    }
    const ytLabel = document.getElementById('ytMusicCurrentLabel');
    if (ytLabel && this.ytMusicName) ytLabel.innerText = this.ytMusicName;

    // Live Workout HUD mini music pill
    const hudMusicTitle = document.getElementById('hudMusicTitle');
    if (hudMusicTitle) hudMusicTitle.innerText = tObj.name;
    const hudMusicToggle = document.getElementById('btnHudMusicToggle');
    if (hudMusicToggle) hudMusicToggle.innerText = this.isPlaying ? '⏸' : '▶';

    // Channel selection cards
    const cards = document.querySelectorAll('.music-genre-card');
    cards.forEach(c => {
      const tid = c.getAttribute('data-track');
      if (tid === this.currentTrackId) c.classList.add('active');
      else c.classList.remove('active');
    });

    // Equalizer wave animation
    const bars = document.querySelectorAll('.audio-bar');
    bars.forEach(b => {
      if (this.isPlaying) b.classList.add('animating');
      else b.classList.remove('animating');
    });
  }
};

if (typeof window !== 'undefined') {
  window.GymMusic = GymMusic;
}


    // ==========================================
    // ZERO-DEPENDENCY WEB AUDIO API SOUND ENGINE
    // ==========================================
    const SoundFX = {
      ctx: null,
      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },
      playBeep(freq = 440, type = 'sine', duration = 0.12, gainVal = 0.15) {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          gain.gain.setValueAtTime(gainVal, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch(e) {}
      },
      playSetComplete() {
        setTimeout(() => this.playBeep(523.25, 'triangle', 0.12, 0.2), 0);
        setTimeout(() => this.playBeep(659.25, 'triangle', 0.12, 0.2), 110);
        setTimeout(() => this.playBeep(783.99, 'triangle', 0.25, 0.25), 220);
      },
      playRestTimerAlert() {
        this.playBeep(880, 'sine', 0.15, 0.3);
        setTimeout(() => this.playBeep(880, 'sine', 0.25, 0.3), 180);
      },
      playFanfare() {
        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((f, i) => setTimeout(() => this.playBeep(f, 'triangle', 0.25, 0.25), i * 140));
      },
      playTempoTick(isHigh = false) {
        this.playBeep(isHigh ? 880 : 440, 'sine', 0.05, 0.08);
      }
    };

    // ==========================================
    // TRAINEE PROFILE & PERSONALIZATION ENGINE
    // ==========================================
    let userProfile = JSON.parse(localStorage.getItem('gym_user_profile') || JSON.stringify({
      name: "Shiva",
      age: 35,
      height: 183,
      weight: 82.0,
      goal: "recomp",
      isPro: true
    }));

    function saveUserProfile() {
      const name = document.getElementById('profNameInput')?.value || "Shiva";
      const age = parseInt(document.getElementById('profAgeInput')?.value) || 35;
      const height = parseInt(document.getElementById('profHeightInput')?.value) || 183;
      const weight = parseFloat(document.getElementById('profWeightInput')?.value) || 82.0;
      const goal = document.getElementById('profGoalSelect')?.value || "recomp";

      userProfile.name = name;
      userProfile.age = age;
      userProfile.height = height;
      userProfile.weight = weight;
      userProfile.goal = goal;

      localStorage.setItem('gym_user_profile', JSON.stringify(userProfile));
      
      if (document.getElementById('calcWeight')) document.getElementById('calcWeight').value = weight;
      if (document.getElementById('calcGoal')) document.getElementById('calcGoal').value = goal;
      calculateMacros();
      calculate1RM();
    }

    // ==========================================
    // LIVE ACTIVE WORKOUT SESSION HUD PLAYER
    // ==========================================
    let liveSessionActive = false;
    let liveSessionSecs = 0;
    let liveSessionInterval = null;
    let liveCurrentExIdx = 0;
    let liveTempoActive = false;
    let liveTempoInterval = null;
    let liveTempoStep = 0;

    function getActiveDayData(day) {
      const plan = getDayPlan(day);
      const enrichedExercises = (plan.exercises || []).map(item => {
        const cat = CATALOG[item.key] || {};
        return {
          id: item.key,
          key: item.key,
          name: cat.name || item.key,
          sets: item.sets,
          reps: item.reps,
          targetWeight: parseFloat(String(item.defWt || '0').replace(/[^0-9.]/g, '')) || 0,
          rest: '60s',
          cue: cat.cue || "Focus on strict joint alignment and controlled eccentric tempo."
        };
      });
      return {
        title: plan.workoutName,
        subtitle: plan.subtitle,
        phase: plan.phaseName,
        exercises: enrichedExercises
      };
    }

    function startLiveWorkoutSession() {
      openModal('liveSessionModal');
      liveSessionActive = true;
      liveCurrentExIdx = 0;
      
      if (!liveSessionInterval) {
        liveSessionInterval = setInterval(() => {
          liveSessionSecs++;
          const m = String(Math.floor(liveSessionSecs / 60)).padStart(2, '0');
          const s = String(liveSessionSecs % 60).padStart(2, '0');
          if (document.getElementById('liveSessionClock')) document.getElementById('liveSessionClock').innerText = `${m}:${s}`;
          const cals = Math.round(liveSessionSecs * 0.12);
          if (document.getElementById('liveSessionBurn')) document.getElementById('liveSessionBurn').innerText = `${cals} kcal`;
        }, 1000);
      }

      const curData = getActiveDayData(currentDay);
      if (document.getElementById('liveModalHeading')) {
        document.getElementById('liveModalHeading').innerText = `Day ${currentDay}: ${curData.title}`;
      }

      renderLiveExercise();
      SoundFX.playBeep(659.25, 'triangle', 0.2, 0.2);
      speakAnnouncement(`Live workout session started. Day ${currentDay}. Let's crush this.`);
    }

    function closeLiveSession() {
      closeModal('liveSessionModal');
      stopLiveTempo();
    }

    function renderLiveExercise() {
      const curData = getActiveDayData(currentDay);
      const exercises = curData.exercises || [];
      if (exercises.length === 0) return;

      const ex = exercises[liveCurrentExIdx] || exercises[0];
      if (document.getElementById('liveExerciseCounter')) {
        document.getElementById('liveExerciseCounter').innerText = `Exercise ${liveCurrentExIdx + 1} of ${exercises.length}`;
      }
      if (document.getElementById('liveExName')) document.getElementById('liveExName').innerText = ex.name;
      if (document.getElementById('liveExTarget')) document.getElementById('liveExTarget').innerText = `${ex.sets} Sets • ${ex.reps} Reps • ${ex.rest || '60s'} Rest`;
      if (document.getElementById('liveExCue')) document.getElementById('liveExCue').innerText = ex.cue || "Focus on strict form and controlled cadence.";

      const tbody = document.getElementById('liveSetRows');
      if (!tbody) return;
      tbody.innerHTML = '';

      const loggedSets = loggedSetData[currentDay]?.[ex.id] || [];
      const numSets = parseInt(ex.sets) || 3;

      for (let s = 1; s <= numSets; s++) {
        const isDone = loggedSets.includes(s);
        const tr = document.createElement('tr');
        tr.className = `hud-set-row ${isDone ? 'done' : ''}`;
        tr.id = `liveSetRow_${s}`;

        const defRepsNum = parseInt(ex.reps) || 10;

        tr.innerHTML = `
          <td style="font-weight: 700; color: #fff;">Set ${s}</td>
          <td style="color: var(--cyan); font-weight: 700; white-space: nowrap;">${ex.reps}</td>
          <td>
            <input type="number" id="liveWeight_${s}" value="${ex.targetWeight || 0}" step="0.5" style="width: 65px; background: rgba(255,255,255,0.08); border: 1px solid var(--border); color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; text-align: center;">
          </td>
          <td>
            <input type="number" id="liveReps_${s}" value="${defRepsNum}" min="1" max="100" style="width: 58px; background: rgba(255,255,255,0.08); border: 1px solid var(--border); color: #fff; padding: 4px 6px; border-radius: 4px; font-size: 0.8rem; text-align: center;">
          </td>
          <td>
            <select id="liveRpe_${s}" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border); color: #fff; padding: 4px 6px; border-radius: 4px; font-size: 0.78rem;">
              <option value="7">RPE 7 (3 reps left)</option>
              <option value="8" selected>RPE 8 (2 reps left)</option>
              <option value="9">RPE 9 (1 rep left)</option>
              <option value="10">RPE 10 (Max effort)</option>
            </select>
          </td>
          <td>
            <button class="btn-hud-set ${isDone ? 'completed' : ''}" onclick="completeLiveSet(${s})" id="btnLiveSet_${s}">
              ${isDone ? '✓ Completed' : 'Complete Set'}
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      }

      const btnPrev = document.getElementById('btnPrevLiveEx');
      const btnNext = document.getElementById('btnNextLiveEx');
      if (btnPrev) btnPrev.style.visibility = liveCurrentExIdx === 0 ? 'hidden' : 'visible';
      if (btnNext) btnNext.innerText = liveCurrentExIdx === exercises.length - 1 ? 'Finish Movements 🏁' : 'Next Movement ▶';
    }

    function completeLiveSet(setNum) {
      const curData = getActiveDayData(currentDay);
      const ex = curData.exercises[liveCurrentExIdx];
      if (!ex) return;

      if (!loggedSetData[currentDay]) loggedSetData[currentDay] = {};
      if (!loggedSetData[currentDay][ex.id]) loggedSetData[currentDay][ex.id] = [];
      
      if (!loggedSetData[currentDay][ex.id].includes(setNum)) {
        loggedSetData[currentDay][ex.id].push(setNum);
      }
      localStorage.setItem('gym_set_logs', JSON.stringify(loggedSetData));

      SoundFX.playSetComplete();
      triggerHaptic(60);

      const row = document.getElementById(`liveSetRow_${setNum}`);
      if (row) row.classList.add('done');
      const btn = document.getElementById(`btnLiveSet_${setNum}`);
      if (btn) {
        btn.classList.add('completed');
        btn.innerText = '✓ Completed';
      }

      startTimer(60);
      speakAnnouncement(`Set ${setNum} done! Resting 60 seconds.`);

      const wt = parseFloat(document.getElementById(`liveWeight_${setNum}`)?.value) || ((userProfile?.weight || 82) * 0.6);
      const reps = parseInt(document.getElementById(`liveReps_${setNum}`)?.value) || 10;
      recordVolumeEntry(wt * reps);
    }

    function nextLiveExercise() {
      const curData = getActiveDayData(currentDay);
      const exercises = curData.exercises || [];
      if (liveCurrentExIdx < exercises.length - 1) {
        liveCurrentExIdx++;
        renderLiveExercise();
        SoundFX.playBeep(523.25, 'triangle', 0.15, 0.15);
      } else {
        finishLiveWorkoutSession();
      }
    }

    function prevLiveExercise() {
      if (liveCurrentExIdx > 0) {
        liveCurrentExIdx--;
        renderLiveExercise();
        SoundFX.playBeep(440, 'triangle', 0.15, 0.15);
      }
    }

    function toggleLiveTempo() {
      if (liveTempoActive) {
        stopLiveTempo();
      } else {
        startLiveTempo();
      }
    }

    function startLiveTempo() {
      liveTempoActive = true;
      const btn = document.getElementById('btnLiveTempo');
      if (btn) {
        btn.innerText = '⏹ Stop Audio Tempo';
        btn.style.borderColor = 'var(--rose)';
        btn.style.color = '#fda4af';
      }
      liveTempoStep = 0;
      liveTempoInterval = setInterval(() => {
        liveTempoStep = (liveTempoStep + 1) % 5;
        const fill = document.getElementById('liveTempoFill');
        const label = document.getElementById('liveTempoLabel');
        if (fill) fill.style.width = `${((liveTempoStep + 1) / 5) * 100}%`;
        if (liveTempoStep === 0) {
          SoundFX.playTempoTick(true);
          if (label) label.innerHTML = '<strong style="color:var(--cyan);">LOWERING (3s)...</strong>';
        } else if (liveTempoStep === 3) {
          SoundFX.playTempoTick(false);
          if (label) label.innerHTML = '<strong style="color:var(--emerald);">EXPLODE UP (1s)!</strong>';
        } else {
          SoundFX.playTempoTick(false);
        }
      }, 1000);
    }

    function stopLiveTempo() {
      liveTempoActive = false;
      clearInterval(liveTempoInterval);
      liveTempoInterval = null;
      const btn = document.getElementById('btnLiveTempo');
      if (btn) {
        btn.innerText = '▶ Start Tempo Audio';
        btn.style.borderColor = 'var(--border)';
        btn.style.color = '#fff';
      }
      const fill = document.getElementById('liveTempoFill');
      if (fill) fill.style.width = '0%';
    }

    function finishLiveWorkoutSession() {
      stopLiveTempo();
      clearInterval(liveSessionInterval);
      liveSessionInterval = null;
      closeLiveSession();

      completedDays.add(currentDay);
      localStorage.setItem('gym_365_completed', JSON.stringify(Array.from(completedDays)));

      SoundFX.playFanfare();
      triggerHaptic(150);

      renderActiveDay(currentDay);
      renderHeatmapGrid();
      renderVolumeChart();
      updateMissionChecklist();

      const cals = Math.round(liveSessionSecs * 0.12);
      alert(`🏆 WORKOUT COMPLETED!\n\nFantastic work! You crushed Day ${currentDay}.\n\n⏱️ Duration: ${Math.round(liveSessionSecs/60)} mins\n🔥 Est. Burn: ${cals} kcal\n\nDay ${currentDay} marked complete in your 365-day journey!`);
      speakAnnouncement(`Workout complete! Incredible discipline today. Keep the streak alive!`);
      liveSessionSecs = 0;
    }

    // ==========================================
    // 1RM STRENGTH INTELLIGENCE & STANDARDS ENGINE
    // ==========================================
    function calculate1RM() {
      const wt = parseFloat(document.getElementById('calc1rmWeight')?.value) || 0;
      const reps = parseInt(document.getElementById('calc1rmReps')?.value) || 1;
      const exercise = document.getElementById('calc1rmExercise')?.value || 'pushup';

      const epley = wt * (1 + (reps / 30));
      const brzycki = reps < 37 ? wt * (36 / (37 - reps)) : epley;
      const e1rm = Math.round(((epley + brzycki) / 2) * 10) / 10;

      if (document.getElementById('calc1rmResult')) {
        document.getElementById('calc1rmResult').innerText = `${e1rm} kg`;
      }

      const bw = userProfile?.weight || 82.0;
      let ratio = e1rm / bw;
      let tier = 'Novice';
      let badgeClass = 'tier-novice';
      let pct = 35;
      let nextRequirement = '';

      if (ratio < 0.7) {
        tier = 'Novice';
        badgeClass = 'tier-novice';
        pct = Math.round((ratio / 0.7) * 40);
        nextRequirement = `+${Math.round((0.7 * bw - e1rm)*10)/10} kg to Intermediate`;
      } else if (ratio < 1.0) {
        tier = 'Intermediate';
        badgeClass = 'tier-intermediate';
        pct = 40 + Math.round(((ratio - 0.7) / 0.3) * 30);
        nextRequirement = `+${Math.round((1.0 * bw - e1rm)*10)/10} kg to Advanced`;
      } else if (ratio < 1.35) {
        tier = 'Advanced';
        badgeClass = 'tier-advanced';
        pct = 70 + Math.round(((ratio - 1.0) / 0.35) * 20);
        nextRequirement = `+${Math.round((1.35 * bw - e1rm)*10)/10} kg to Elite`;
      } else {
        tier = 'Elite';
        badgeClass = 'tier-elite';
        pct = 95;
        nextRequirement = 'Peak Athletic Standard Achieved!';
      }

      const badge = document.getElementById('calc1rmBadge');
      if (badge) {
        badge.className = `tier-badge-pill ${badgeClass}`;
        badge.innerText = `${tier} (${ratio.toFixed(2)}x Bodyweight)`;
      }
      const meter = document.getElementById('calc1rmMeter');
      if (meter) meter.style.width = `${Math.min(100, Math.max(10, pct))}%`;

      const nextEl = document.getElementById('calc1rmNextTier');
      if (nextEl) nextEl.innerText = nextRequirement;

      if (document.getElementById('statOverallTier')) {
        document.getElementById('statOverallTier').innerText = tier;
      }
    }

    function recordVolumeEntry(volumeKg) {
      let volumeLogs = JSON.parse(localStorage.getItem('gym_volume_logs') || '[]');
      volumeLogs.push({ date: new Date().toISOString(), vol: Math.round(volumeKg) });
      localStorage.setItem('gym_volume_logs', JSON.stringify(volumeLogs));
    }

    function renderVolumeChart() {
      const container = document.getElementById('volumeChartContainer');
      if (!container) return;

      const totalCompleted = completedDays.size;
      const baseTonnagePerSession = Math.round((userProfile?.weight || 82) * 10 * 12);
      const totalVolume = totalCompleted * baseTonnagePerSession;

      if (document.getElementById('statTotalVolume')) {
        document.getElementById('statTotalVolume').innerText = `${totalVolume.toLocaleString()} kg`;
      }
      if (document.getElementById('statCompletedSessions')) {
        document.getElementById('statCompletedSessions').innerText = totalCompleted;
      }

      const weeks = 8;
      const points = [];
      const startVol = Math.max(1200, (userProfile?.weight || 82) * 35);
      for (let w = 1; w <= weeks; w++) {
        const projected = Math.round(startVol * Math.pow(1.035, w - 1));
        points.push({ week: `W${w}`, vol: projected });
      }

      const maxV = Math.max(...points.map(p => p.vol)) * 1.15;
      const wWidth = 600;
      const wHeight = 160;
      const stepX = wWidth / (weeks - 1);

      let pathD = '';
      let dots = '';
      points.forEach((p, idx) => {
        const x = idx * stepX;
        const y = wHeight - ((p.vol / maxV) * (wHeight - 30)) - 15;
        if (idx === 0) pathD += `M ${x} ${y} `;
        else pathD += `L ${x} ${y} `;
        dots += `<circle cx="${x}" cy="${y}" r="4" fill="#38bdf8" /><text x="${x}" y="${y - 8}" fill="#94a3b8" font-size="10" text-anchor="middle">${p.vol}kg</text>`;
      });

      container.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <span style="font-size: 0.8rem; color: var(--text-dim);">8-Week Progressive Mechanical Tonnage Trend</span>
          <span style="font-size: 0.8rem; color: var(--emerald); font-weight: 700;">+3.5% Progressive Overload Rate</span>
        </div>
        <div style="width: 100%; overflow: hidden;">
          <svg viewBox="0 0 ${wWidth} ${wHeight}" style="width: 100%; height: auto; display: block;">
            <defs>
              <linearGradient id="volGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.0"/>
              </linearGradient>
            </defs>
            <path d="${pathD} L ${wWidth} ${wHeight} L 0 ${wHeight} Z" fill="url(#volGrad)" />
            <path d="${pathD}" fill="none" stroke="#38bdf8" stroke-width="2.5" />
            ${dots}
          </svg>
        </div>
      `;
    }

    // ==========================================
    // 7-DAY SMART SUPERMARKET GROCERY GENERATOR
    // ==========================================
    const GROCERY_DATA = {
      omnivore: [
        { cat: "🥩 High-Yield Lean Proteins", items: [
          { name: "Chicken Breast (Boneless/Skinless)", qty: "2.1 kg", tip: "Meal prep in 300g daily portions" },
          { name: "Fresh Grade-A Eggs", qty: "42 Eggs", tip: "6 eggs/day (3 whole + 3 whites)" },
          { name: "Low-Fat Greek Yogurt / Hung Curd", qty: "1.4 kg", tip: "Rich in slow-release casein protein" },
          { name: "Fish Fillet (Salmon or Whitefish)", qty: "800g", tip: "High in natural EPA/DHA omega-3s" }
        ]},
        { cat: "🍚 Low-GI Complex Carbohydrates", items: [
          { name: "Rolled Whole Oats", qty: "1.2 kg", tip: "Beta-glucan fiber supports heart health" },
          { name: "Brown / Basmati Rice", qty: "2.0 kg", tip: "Clean muscle glycogen replenishment" },
          { name: "Sweet Potatoes / Yams", qty: "1.5 kg", tip: "Rich in potassium to prevent muscle cramps" }
        ]},
        { cat: "🥑 Essential Lipids & Healthy Fats", items: [
          { name: "Raw Almonds & Walnuts", qty: "400g", tip: "Magnesium and brain-healthy fats" },
          { name: "Cold-Pressed Extra Virgin Olive Oil", qty: "500 ml", tip: "Anti-inflammatory oleocanthal" },
          { name: "Natural Peanut Butter (100% Peanuts)", qty: "1 Jar (500g)", tip: "Zero hydrogenated oils or sugars" }
        ]},
        { cat: "🥦 Anti-Inflammatory Produce & Greens", items: [
          { name: "Fresh Baby Spinach (Palak)", qty: "1.0 kg", tip: "Nitrates boost nitric oxide & blood flow" },
          { name: "Fresh Broccoli", qty: "1.2 kg", tip: "Sulforaphane lowers joint inflammation" },
          { name: "Bananas & Mixed Berries", qty: "1.5 kg", tip: "Antioxidants reduce DOMS muscle soreness" }
        ]},
        { cat: "💊 Ergogenic Longevity Stack", items: [
          { name: "Creatine Monohydrate (Micronized)", qty: "250g Tub", tip: "5g daily for ATP power & brain clarity" },
          { name: "Whey Protein Isolate", qty: "1 kg Tub", tip: "Rapid post-workout leucine spike" },
          { name: "Vitamin D3 (60k IU) + K2", qty: "1 Strip", tip: "Crucial for 35yo testosterone & bones" },
          { name: "Magnesium Glycinate (300mg)", qty: "1 Bottle", tip: "Deep slow-wave recovery before bed" }
        ]}
      ],
      vegetarian: [
        { cat: "🌱 High-Bioavailability Vegetarian Proteins", items: [
          { name: "Fresh Low-Fat Paneer / Organic Tofu", qty: "2.5 kg", tip: "350g daily portioned across meals" },
          { name: "Greek Yogurt / Fresh Homemade Curd", qty: "2.0 kg", tip: "Essential probiotics and slow casein" },
          { name: "Yellow Moong Dal & Chickpeas (Kabuli Chana)", qty: "1.5 kg", tip: "Sprout chickpeas for 30% higher bioavailability" },
          { name: "Green Edamame / Soya Chunks", qty: "800g", tip: "Complete amino acid profile (52g protein/100g)" }
        ]},
        { cat: "🍚 Complex Carbohydrates & Fiber", items: [
          { name: "Rolled Whole Oats", qty: "1.2 kg", tip: "Sustained morning mental focus" },
          { name: "Brown Rice / Quinoa", qty: "2.0 kg", tip: "Low-glycemic endurance fuel" },
          { name: "Sweet Potatoes", qty: "1.5 kg", tip: "Alkaline complex carbohydrate" }
        ]},
        { cat: "🥑 Healthy Fats & Omega-3s", items: [
          { name: "Raw Walnuts & Flaxseeds", qty: "400g", tip: "Rich in plant ALA omega-3 fatty acids" },
          { name: "Desi Gir Cow A2 Ghee (Cold-Clarified)", qty: "250g", tip: "Butyric acid for intestinal gut barrier" },
          { name: "Natural Peanut / Almond Butter", qty: "500g", tip: "Calorie-dense clean fats" }
        ]},
        { cat: "🥦 Anti-Inflammatory Produce", items: [
          { name: "Spinach / Methi / Palak Leaves", qty: "1.5 kg", tip: "Plant iron and lutein" },
          { name: "Broccoli & Bell Peppers", qty: "1.5 kg", tip: "High vitamin C aids collagen synthesis" },
          { name: "Fresh Indian Amla / Oranges", qty: "1.0 kg", tip: "Potent natural vitamin C antioxidant" }
        ]},
        { cat: "💊 Essential Vegetarian Longevity Stack", items: [
          { name: "Creatine Monohydrate (100% Plant-Safe)", qty: "250g Tub", tip: "Non-meat eaters see largest cognitive & strength leap" },
          { name: "Whey Isolate or Pea/Rice Protein Blend", qty: "1 kg Tub", tip: "Ensures 160g+ daily target is met effortlessly" },
          { name: "Vitamin B12 (Methylcobalamin 1500mcg)", qty: "1 Strip", tip: "Non-negotiable for nerve sheath & blood health" },
          { name: "Magnesium Glycinate (300mg)", qty: "1 Bottle", tip: "Calms nervous system for deep restorative sleep" }
        ]}
      ]
    };

    function generateGroceryList() {
      const container = document.getElementById('groceryGridContainer');
      if (!container) return;

      const currentDiet = document.querySelector('.diet-btn.active')?.innerText.toLowerCase().includes('vegetarian') ? 'vegetarian' : 'omnivore';
      const list = GROCERY_DATA[currentDiet] || GROCERY_DATA.omnivore;

      container.innerHTML = '';
      list.forEach((category, cIdx) => {
        const card = document.createElement('div');
        card.className = 'grocery-cat-card';

        let itemsHtml = '';
        category.items.forEach((item, iIdx) => {
          const id = `groc_${cIdx}_${iIdx}`;
          itemsHtml += `
            <div class="grocery-item-row" id="row_${id}">
              <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1;">
                <input type="checkbox" onchange="toggleGroceryCheck('${id}')" id="${id}">
                <span style="font-weight: 600;">${item.name}</span>
              </label>
              <span style="font-size: 0.78rem; font-weight: 800; color: var(--cyan); background: rgba(56, 189, 248, 0.1); padding: 2px 8px; border-radius: 4px;">
                ${item.qty}
              </span>
            </div>
            <div style="font-size: 0.72rem; color: var(--text-dim); padding-left: 24px; margin-bottom: 4px;">${item.tip}</div>
          `;
        });

        card.innerHTML = `
          <div class="grocery-cat-title">${category.cat}</div>
          ${itemsHtml}
        `;
        container.appendChild(card);
      });
    }

    function toggleGroceryCheck(id) {
      const cb = document.getElementById(id);
      const row = document.getElementById(`row_${id}`);
      if (cb && row) {
        if (cb.checked) {
          row.classList.add('checked');
          SoundFX.playBeep(880, 'sine', 0.05, 0.05);
        } else {
          row.classList.remove('checked');
        }
      }
    }

    function copyGroceryList() {
      const currentDiet = document.querySelector('.diet-btn.active')?.innerText.toLowerCase().includes('vegetarian') ? 'vegetarian' : 'omnivore';
      const list = GROCERY_DATA[currentDiet] || GROCERY_DATA.omnivore;
      
      let txt = `🛒 AETHOS 365 PRO • 7-DAY SUPERMARKET GROCERY LIST\nTarget: 160g+ Protein | 2,420 kcal Recomposition\n=========================================\n\n`;
      list.forEach(cat => {
        txt += `${cat.cat.toUpperCase()}\n`;
        cat.items.forEach(it => {
          txt += `• [ ] ${it.name} - ${it.qty} (${it.tip})\n`;
        });
        txt += `\n`;
      });

      navigator.clipboard.writeText(txt).then(() => {
        alert("📋 7-Day Grocery List copied to clipboard! You can paste it into WhatsApp, Google Keep, or Notes.");
      }).catch(() => {
        prompt("Copy your grocery list below:", txt);
      });
    }

    function printGroceryList() {
      window.print();
    }

    function checkProtocolBanner() {
      if (typeof window !== 'undefined' && window.location && window.location.protocol === 'file:') {
        const bar = document.createElement('div');
        bar.id = 'fileProtocolNotice';
        bar.style.cssText = 'background: linear-gradient(90deg, #1e1b4b, #312e81); border-bottom: 1.5px solid #6366f1; padding: 10px 16px; color: #e0e7ff; font-size: 0.82rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; z-index: 99999; position: sticky; top: 0; box-shadow: 0 4px 15px rgba(0,0,0,0.5);';
        bar.innerHTML = `
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 1.15rem;">⚡</span>
            <span><strong>Running from local file (file://):</strong> Browsers block YouTube referrer headers on local disk files, which triggers <em>Error 153</em> on embedded videos. For 100% working inline embeds, use your active server:</span>
          </div>
          <div style="display: flex; gap: 8px; align-items: center;">
            <a href="http://localhost:3000/home_gym_zero_to_hero.html" style="background: var(--cyan); color: #000; padding: 5px 14px; border-radius: 6px; font-weight: 800; text-decoration: none; font-size: 0.78rem; box-shadow: 0 0 12px rgba(0,242,254,0.4);">
              🚀 Open http://localhost:3000
            </a>
            <button onclick="this.parentElement.parentElement.remove()" style="background: transparent; border: none; color: #94a3b8; font-size: 1.15rem; cursor: pointer; padding: 0 4px;" title="Dismiss">✕</button>
          </div>
        `;
        if (document.body) {
          document.body.prepend(bar);
        }
      }
    }

    // Initialize App & Offline Engines on Startup
    checkProtocolBanner();
    initPhotoDB().then(() => {
      updatePhotoUIForDay(1);
      setupBeforeAfterSlider();
    });
    renderWarmupGuidesDrawer();
    renderCooldownGuidesDrawer();
    renderActiveDay(1);
    switchDiet('omnivore');
    renderMetricsTable();
    calculateMacros();
    calculate1RM();
    renderVolumeChart();
    generateGroceryList();
    checkAchievements();
    initVoices();
    renderHeatmapGrid();
  </script>
</body>
