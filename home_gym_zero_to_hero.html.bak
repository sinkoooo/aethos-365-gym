          <div id="ytMusicEmbedContainer" style="position: relative; padding-bottom: 45%; height: 0; background: #000; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12);">
            <iframe id="gymYtMusicPlayerIframe" src="https://www.youtube-nocookie.com/embed/s5kD4xohZtM?enablejsapi=1&autoplay=0&rel=0&modestbranding=1" title="Gym YouTube Music Player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"></iframe>
          </div>

          <!-- Current Station Label & Info -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; font-size: 0.75rem; color: #94a3b8; flex-wrap: wrap; gap: 6px;">
            <span>Current Stream: <strong id="ytMusicCurrentLabel" style="color: #fff;">🔥 Gym Phonk & Shred</strong></span>
            <span style="color: var(--emerald); font-weight: 700;">● Auto-Ducking Connected</span>
          </div>
        </div>

        <!-- LOAD LOCAL AUDIO FILES -->
        <div style="background: rgba(255,255,255,0.04); border: 1px dashed rgba(255,255,255,0.15); border-radius: var(--radius-sm); padding: 12px 16px; margin-top: 12px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <div>
            <div style="font-size: 0.84rem; font-weight: 700; color: #fff;">📁 Play Your Own Workout MP3s</div>
            <div style="font-size: 0.74rem; color: var(--text-muted);">Select songs from your device. Also auto-ducks for Voice Coach.</div>
          </div>
          <label style="background: rgba(255,255,255,0.08); border: 1px solid var(--border); color: #fff; padding: 6px 14px; border-radius: 6px; font-size: 0.78rem; font-weight: 700; cursor: pointer;">
            Choose Files
            <input type="file" accept="audio/*" multiple style="display:none;" onchange="GymMusic.handleLocalFiles(event)">
          </label>
        </div>

        <!-- SMART SYNERGY EXPLANATION -->
        <div style="background: rgba(0, 242, 254, 0.05); border-left: 3px solid var(--cyan); padding: 10px 14px; border-radius: 0 6px 6px 0; margin-top: 14px; font-size: 0.78rem; color: #cbd5e1; line-height: 1.45;">
          <strong>⚡ Smart Voice Coach Priority:</strong> You never have to pause your music. When the Voice Coach speaks rep cues or rest timers finish, background beats automatically duck down to 18% and fade smoothly back up so instructions are 100% audible.
        </div>

      </div>
    </div>
  </div>

  <!-- MODAL: VOICE COACH & SOUND SETTINGS -->
  <div id="voiceModal" class="app-modal" onclick="closeModalOnBackdrop(event, 'voiceModal')">
    <div class="modal-box" style="max-width: 500px;">
      <div class="modal-header">
        <div class="modal-title">🔊 Audio Voice Coach Setup</div>
        <button class="modal-close" onclick="closeModal('voiceModal')">&times;</button>
      </div>
      <div class="modal-body">
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 18px;">
          Configure your personal AI audio coach. Announces your workout targets, counts down rest periods, and provides real-time biomechanical cues.
        </p>

        <div class="voice-control-group">
          <label>Coach Voice</label>
          <select id="voiceSelect" onchange="saveVoiceSettings()">
            <option value="">Default System Voice</option>
          </select>
        </div>

        <div class="voice-control-group">
          <label>Speech Speed (<span id="voiceRateVal">1.05x</span>)</label>
          <input type="range" id="voiceRateInput" min="0.7" max="1.4" step="0.05" value="1.05" oninput="saveVoiceSettings()">
        </div>

        <div class="voice-control-group">
          <label>Voice Pitch (<span id="voicePitchVal">1.0</span>)</label>
          <input type="range" id="voicePitchInput" min="0.7" max="1.3" step="0.05" value="1.0" oninput="saveVoiceSettings()">
        </div>

        <div style="display: flex; gap: 10px; margin-top: 20px;">
          <button onclick="testVoiceCoach()" style="flex: 1; background: var(--cyan); color: #000; font-weight: 800; border: none; padding: 10px; border-radius: 6px; cursor: pointer;">
            ▶ Test Coach Voice
          </button>
          <button onclick="closeModal('voiceModal')" style="background: var(--bg-card); color: #fff; border: 1px solid var(--border); padding: 10px 16px; border-radius: 6px; cursor: pointer;">
            Done
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: PHOTO CAPTURE & UPLOAD STUDIO -->
  <div id="photoModal" class="app-modal" onclick="closeModalOnBackdrop(event, 'photoModal')">
    <div class="modal-box" style="max-width: 620px;">
      <div class="modal-header">
        <div class="modal-title">📸 Workout Transformation Photo Studio</div>
        <button class="modal-close" onclick="closeModal('photoModal')">&times;</button>
      </div>
      <div class="modal-body">
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 16px;">
          Document your physical journey for <strong style="color: #fff;" id="photoModalDayTitle">Day 1</strong>. Photos are stamped with date & day metrics and saved directly to your offline browser database.
        </p>

        <!-- Dropzone / Live Preview Area -->
        <div id="photoPreviewContainer" style="position: relative; width: 100%; min-height: 280px; max-height: 420px; background: rgba(0,0,0,0.4); border: 2px dashed rgba(56, 189, 248, 0.4); border-radius: var(--radius-lg); overflow: hidden; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
          <img id="photoModalImgPreview" src="" alt="Workout Preview" style="width: 100%; height: 100%; max-height: 420px; object-fit: contain; display: none;">
          <div id="photoWatermarkTag" style="display: none; position: absolute; bottom: 12px; left: 12px; background: rgba(11, 17, 32, 0.85); backdrop-filter: blur(8px); border: 1px solid var(--cyan); padding: 5px 12px; border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; font-weight: 800; color: #fff;">
            AETHOS 365 • DAY <span id="watermarkDay">1</span>
          </div>
          <div id="photoPlaceholderText" style="text-align: center; padding: 20px;">
            <div style="font-size: 3rem; margin-bottom: 8px;">📷</div>
            <strong style="color: #fff; display: block; font-size: 1rem;">No Photo Selected Yet</strong>
            <span style="font-size: 0.82rem; color: var(--text-dim);">Snap with camera or upload from files</span>
          </div>
        </div>

        <!-- Note Input -->
        <div style="margin-bottom: 16px;">
          <label style="font-size: 0.76rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Workout Notes / Reflection (Optional)</label>
          <input type="text" id="photoNoteInput" placeholder="e.g. Felt great on incline pushups! Good pump." style="width: 100%; background: var(--bg-card); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 6px; font-size: 0.85rem;">
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button onclick="triggerCameraInput()" class="btn-photo-action" style="flex: 1; justify-content: center;">
            📷 Snap Camera
          </button>
          <button onclick="triggerGalleryInput()" class="btn-photo-action" style="flex: 1; justify-content: center;">
            📁 Pick From File
          </button>
          <button id="btnSaveDayPhoto" onclick="saveDayPhoto()" style="flex: 1.2; background: linear-gradient(135deg, var(--emerald), #059669); color: #000; font-weight: 800; border: none; padding: 10px 18px; border-radius: 6px; font-size: 0.85rem; cursor: pointer; display: none;">
            💾 Save For Day <span id="btnSaveDayNum">1</span> (+75 XP)
          </button>
        </div>
      </div>
    </div>
  </div>
  <input type="file" id="photoCameraInput" accept="image/*" capture="environment" style="display: none;" onchange="handlePhotoSelected(event)">
  <input type="file" id="photoGalleryInput" accept="image/*" style="display: none;" onchange="handlePhotoSelected(event)">

  <!-- MODAL: MILESTONE CELEBRATION FANFARE -->
  <div id="milestoneCelebrationModal" class="app-modal" onclick="closeModalOnBackdrop(event, 'milestoneCelebrationModal')">
    <div class="modal-box" style="max-width: 520px; text-align: center; border-color: var(--amber); box-shadow: 0 0 50px rgba(251, 191, 36, 0.35);">
      <div class="modal-body" style="padding: 32px 24px;">
        <div style="font-size: 4rem; animation: cellPulse 1.5s infinite alternate;" id="celebIcon">🏆</div>
        <span class="rarity-pill rarity-legendary" id="celebRarity" style="margin-top: 10px; display: inline-block;">Legendary Achievement</span>
        <h2 style="font-size: 1.6rem; color: #fff; margin: 12px 0 6px;" id="celebTitle">Centurion (100 Days)</h2>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; max-width: 400px; margin: 0 auto 16px;" id="celebDesc">
          You have conquered 100 total workouts. You are now officially in the top 5% of home trainees worldwide.
        </p>
        <div style="background: rgba(251, 191, 36, 0.15); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px; padding: 10px; display: inline-block; font-weight: 800; color: var(--amber); font-size: 0.95rem; margin-bottom: 20px;">
          ⚡ Reward Claimed: <span id="celebXp">+750 XP</span>
        </div>
        <div>
          <button onclick="closeModal('milestoneCelebrationModal')" style="background: linear-gradient(135deg, var(--amber), #d97706); color: #000; font-weight: 800; border: none; padding: 11px 28px; border-radius: 8px; font-size: 0.95rem; cursor: pointer; box-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">
            Awesome! Keep Conquering
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: ACTIVE LIVE WORKOUT SESSION HUD PLAYER -->
  <div id="liveSessionModal" class="app-modal" onclick="closeModalOnBackdrop(event, 'liveSessionModal')">
    <div class="modal-box" style="max-width: 840px; background: linear-gradient(150deg, rgba(20, 31, 58, 0.98) 0%, rgba(13, 21, 40, 0.98) 100%); border: 1.5px solid rgba(0, 242, 254, 0.4); box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 50px rgba(0, 242, 254, 0.25);">
      <div class="modal-header" style="background: linear-gradient(135deg, rgba(28, 42, 78, 0.95) 0%, rgba(18, 28, 52, 0.95) 100%); border-bottom: 1px solid rgba(56, 189, 248, 0.3);">
        <div>
          <span style="font-size: 0.72rem; color: var(--emerald); font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">● ACTIVE LIVE HUD</span>
          <div class="modal-title" id="liveModalHeading">Day 1: Foundation Session</div>
        </div>
        <button class="modal-close" onclick="closeLiveSession()">&times;</button>
      </div>
      <div class="modal-body" style="padding-top: 12px;">
        
        <!-- LIVE CLOCK & BURN COUNTER -->
        <div class="hud-timer-bar" style="background: linear-gradient(135deg, rgba(0, 242, 254, 0.1) 0%, rgba(168, 85, 247, 0.1) 100%); border: 1px solid rgba(56, 189, 248, 0.35); box-shadow: 0 8px 25px rgba(0,0,0,0.35);">
          <div>
            <div style="font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase;">Workout Duration</div>
            <div class="hud-clock" id="liveSessionClock">00:00</div>
          </div>
          <div class="hud-cals">
            <span>🔥</span> <span id="liveSessionBurn">0 kcal</span>
          </div>
          <div>
            <div style="font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase;">Active Movement</div>
            <div style="font-size: 0.95rem; font-weight: 700; color: #fff;" id="liveExerciseCounter">Exercise 1 of 5</div>
          </div>
          <button onclick="finishLiveWorkoutSession()" style="background: rgba(244, 63, 94, 0.2); border: 1px solid rgba(244, 63, 94, 0.4); color: #fda4af; padding: 8px 16px; border-radius: 6px; font-weight: 800; font-size: 0.8rem; cursor: pointer;">
            🏁 Finish Session
          </button>
        </div>

        <!-- HUD WORKOUT MUSIC CONTROLLER -->
        <div style="background: rgba(13, 21, 40, 0.8); border: 1px solid rgba(0, 242, 254, 0.28); border-radius: 8px; padding: 7px 14px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 0.9rem;">🎵</span>
            <span style="font-size: 0.8rem; font-weight: 800; color: #fff;" id="hudMusicTitle">⚡ Cyber Heavy Pump</span>
            <span class="music-ducking-pill" id="hudMusicDuckingBadge">🔉 Ducking for Coach</span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <button onclick="GymMusic.prevTrack()" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border); color: #fff; width: 28px; height: 28px; border-radius: 50%; font-size: 0.72rem; cursor: pointer;" title="Previous Track">⏮</button>
            <button onclick="GymMusic.togglePlay()" id="btnHudMusicToggle" style="background: var(--cyan); border: none; color: #000; font-weight: 800; padding: 5px 14px; border-radius: 99px; font-size: 0.76rem; cursor: pointer;">▶ Play</button>
            <button onclick="GymMusic.nextTrack()" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border); color: #fff; width: 28px; height: 28px; border-radius: 50%; font-size: 0.72rem; cursor: pointer;" title="Next Track">⏭</button>
            <button onclick="openModal('musicModal')" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border); color: var(--cyan); padding: 5px 10px; border-radius: 4px; font-size: 0.72rem; cursor: pointer;">⚙️ Channels</button>
          </div>
        </div>

        <!-- ACTIVE EXERCISE CARD -->
        <div class="hud-exercise-active" id="liveExerciseCard" style="background: linear-gradient(145deg, rgba(26, 40, 74, 0.9) 0%, rgba(16, 25, 48, 0.9) 100%); border: 1.5px solid rgba(0, 242, 254, 0.4); box-shadow: 0 10px 35px rgba(0, 242, 254, 0.18);">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <h2 style="font-size: 1.35rem; color: #fff;" id="liveExName">Incline Push-Ups (Hands on Table/Desk)</h2>
            <span style="font-size: 0.75rem; color: var(--cyan); background: rgba(56, 189, 248, 0.1); padding: 4px 10px; border-radius: 99px; font-weight: 700;" id="liveExTarget">3 Sets • 10–12 Reps • 60s Rest</span>
          </div>
          <p style="font-size: 0.84rem; color: var(--text-muted); margin-top: 6px;" id="liveExCue">Keep core braced like a plank. Lead with your chest, not your hips.</p>

          <!-- Rep Cadence Metronome Pulse -->
          <div style="background: linear-gradient(135deg, rgba(16, 25, 48, 0.9) 0%, rgba(10, 16, 32, 0.9) 100%); padding: 14px 18px; border-radius: 10px; margin-top: 14px; border: 1px solid rgba(251, 191, 36, 0.35); box-shadow: inset 0 0 20px rgba(0,0,0,0.35);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.78rem; color: var(--amber); font-weight: 700;">⏱️ Rep Tempo Cadence (3-0-1-0)</span>
              <button onclick="toggleLiveTempo()" id="btnLiveTempo" style="background: var(--bg-card); border: 1px solid var(--border); color: #fff; font-size: 0.75rem; padding: 4px 10px; border-radius: 4px; cursor: pointer;">
                ▶ Start Tempo Audio
              </button>
            </div>
            <div class="hud-tempo-bar">
              <div class="hud-tempo-fill" id="liveTempoFill"></div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--text-dim);" id="liveTempoLabel">
              <span>Lowering (3s)</span>
              <span>Pause (0s)</span>
              <span>Push (1s)</span>
              <span>Squeeze (0s)</span>
            </div>
          </div>

          <!-- SET LOGGING TABLE -->
          <table class="hud-set-table">
            <thead>
              <tr>
                <th>Set</th>
                <th>Target</th>
                <th>Weight (kg)</th>
                <th>Reps</th>
                <th>RPE</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="liveSetRows">
              <!-- Dynamically populated -->
            </tbody>
          </table>

          <div style="display: flex; justify-content: space-between; margin-top: 18px;">
            <button onclick="prevLiveExercise()" id="btnPrevLiveEx" style="background: linear-gradient(135deg, rgba(28, 42, 75, 0.9) 0%, rgba(19, 28, 50, 0.9) 100%); border: 1px solid rgba(99, 133, 180, 0.4); color: #fff; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: all 0.2s;">
              ◀ Previous Movement
            </button>
            <button onclick="nextLiveExercise()" id="btnNextLiveEx" style="background: linear-gradient(135deg, #00f2fe, #38bdf8); color: #000; border: none; padding: 10px 24px; border-radius: 8px; font-weight: 800; font-size: 0.9rem; cursor: pointer; box-shadow: 0 0 22px rgba(0, 242, 254, 0.45); transition: all 0.2s;">
              Next Movement ▶
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- FLOATING QUICK ACTION DOCK (ALWAYS IN REACH, ZERO SCROLL HUNTING) -->
  <div class="floating-quick-dock" id="floatingQuickDock">
    <button class="floating-dock-btn" onclick="openPhotoModal(currentDay)" title="Snap or upload workout photo">
      📸 Photo
    </button>
    <button class="floating-dock-btn" onclick="scrollToWorkoutSection('warmupBox')" title="Jump to Warm-Up">
      🔥 Warm-Up
    </button>
    <button class="floating-dock-btn" onclick="startLiveWorkoutSession()" title="Enter live session HUD">
      ▶ Live HUD
    </button>
    <button class="floating-dock-btn primary" id="floatBtnMarkDay" onclick="toggleCurrentDayCompletion()" title="Mark Day Complete">
      <span id="floatMarkIcon">✓</span> <span id="floatMarkText">Complete Day</span>
    </button>
  </div>

  <script>
    // ==========================================
    // CORE APPLICATION ENGINE & DATA STATE
    // ==========================================

    let currentDay = 1;
    let completedDays = new Set(JSON.parse(localStorage.getItem('gym_365_completed') || '[]'));
    let loggedSetData = JSON.parse(localStorage.getItem('gym_set_logs') || '{}');
    let loggedMetrics = JSON.parse(localStorage.getItem('gym_metrics_logs') || '[]');
    let waterLog = JSON.parse(localStorage.getItem('gym_water_log') || '{}');
    let dailyReadiness = JSON.parse(localStorage.getItem('gym_readiness_log') || '{}');
    let userProgressions = JSON.parse(localStorage.getItem('gym_progressions') || '{}');
    let voiceSettings = JSON.parse(localStorage.getItem('gym_voice_settings') || '{"rate":1.05,"pitch":1.0,"voiceURI":""}');
    let photosLoggedDays = new Set(JSON.parse(localStorage.getItem('gym_photos_logged_days') || '[]'));
    let warmupDoneDays = new Set(JSON.parse(localStorage.getItem('gym_warmup_done') || '[]'));
    let cooldownDoneDays = new Set(JSON.parse(localStorage.getItem('gym_cooldown_done') || '[]'));
    let unlockedMilestones = new Set(JSON.parse(localStorage.getItem('gym_unlocked_milestones') || '[]'));
    let currentMilestoneFilter = 'all';
    let currentWorkoutStage = 'workout';
    let currentCockpitTab = 'tempo';
    let matrixViewMonth = 1;
    let photoDB = null;
    let selectedPhotoDataUrl = null;
    let availableVoices = [];
    let webcamStream = null;

    // View Switcher
    function switchView(viewId) {
      document.querySelectorAll('.view-tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.app-view').forEach(view => view.classList.remove('active'));

      const activeBtn = Array.from(document.querySelectorAll('.view-tab-btn')).find(b => b.getAttribute('onclick')?.includes(viewId));
      if (activeBtn) activeBtn.classList.add('active');

      const target = document.getElementById(viewId);
      if (target) target.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (viewId === 'milestonesView') {
        renderMilestonesHub(currentMilestoneFilter);
      } else if (viewId === 'photosView') {
        renderPhotoGallery();
      } else if (viewId === 'analyticsView') {
        renderVolumeChart();
      }
    }

    // ==========================================
    // WORKOUT NAVIGATION & MISSION CHECKLIST
    // ==========================================
    function scrollToWorkoutSection(id) {
      if (!document.getElementById('workoutView')?.classList.contains('active')) {
        switchView('workoutView');
      }
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        el.style.transition = 'box-shadow 0.3s ease, border-color 0.3s ease';
        el.style.borderColor = 'var(--cyan)';
        el.style.boxShadow = '0 0 25px rgba(0, 242, 254, 0.4)';
        setTimeout(() => {
          el.style.borderColor = '';
          el.style.boxShadow = '';
        }, 1500);
      }
    }

    function scrollToWaterTracker() {
      if (!document.getElementById('workoutView')?.classList.contains('active')) {
        switchView('workoutView');
      }
      const el = document.getElementById('waterTrackerRow');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const parent = el.closest('.readiness-strip') || el.parentElement;
        if (parent) {
          parent.style.transition = 'box-shadow 0.3s ease, border-color 0.3s ease';
          parent.style.borderColor = 'var(--cyan)';
          parent.style.boxShadow = '0 0 25px rgba(0, 242, 254, 0.4)';
          setTimeout(() => {
            parent.style.borderColor = '';
            parent.style.boxShadow = '';
          }, 1800);
        }
      }
    }

    function updateMissionChecklist() {
      const dayBadge = document.getElementById('missionDayBadge');
      if (dayBadge) dayBadge.innerText = `DAY ${currentDay}`;

      const isDayDone = completedDays.has(currentDay);

      // 1. Warm-Up Status
      const chipWarmup = document.getElementById('chipWarmup');
      const chipWarmupStatus = document.getElementById('chipWarmupStatus');
      const isWarmupDone = isDayDone || warmupDoneDays.has(currentDay);
      if (isWarmupDone) {
        chipWarmup?.classList.add('done');
        if (chipWarmupStatus) chipWarmupStatus.innerText = '✓ Completed';
      } else {
        chipWarmup?.classList.remove('done');
        if (chipWarmupStatus) chipWarmupStatus.innerText = '5 Mins Ready';
      }

      // 2. Workout Sets Status
      const chipWorkout = document.getElementById('chipWorkout');
      const chipWorkoutStatus = document.getElementById('chipWorkoutStatus');
      const plan = getDayPlan(currentDay);
      let totalSets = 0;
      let loggedSets = 0;
      if (plan && plan.exercises) {
        plan.exercises.forEach(item => {
          totalSets += item.sets;
          for (let s = 1; s <= item.sets; s++) {
            const key = `d${currentDay}_ex${item.key}_s${s}`;
            if (loggedSetData[key] && loggedSetData[key].done) loggedSets++;
          }
        });
      }
      if (loggedSets > 0 && loggedSets >= totalSets) {
        chipWorkout?.classList.add('done');
        if (chipWorkoutStatus) chipWorkoutStatus.innerText = `✓ All ${loggedSets} Sets Done`;
      } else if (loggedSets > 0) {
        chipWorkout?.classList.remove('done');
        if (chipWorkoutStatus) chipWorkoutStatus.innerText = `${loggedSets}/${totalSets} Sets Logged`;
      } else {
        chipWorkout?.classList.remove('done');
        if (chipWorkoutStatus) chipWorkoutStatus.innerText = `${totalSets} Sets Ready`;
      }

      // 3. Day Photo Status
      const chipPhoto = document.getElementById('chipPhoto');
      const chipPhotoStatus = document.getElementById('chipPhotoStatus');
      if (photosLoggedDays.has(currentDay)) {
        chipPhoto?.classList.add('done');
        if (chipPhotoStatus) chipPhotoStatus.innerText = '✓ Photo Logged';
      } else {
        chipPhoto?.classList.remove('done');
        if (chipPhotoStatus) chipPhotoStatus.innerText = 'Pending (+75 XP)';
      }

      // 4. Cool-Down Status
      const chipCooldown = document.getElementById('chipCooldown');
      const chipCooldownStatus = document.getElementById('chipCooldownStatus');
      const isCooldownDone = isDayDone || cooldownDoneDays.has(currentDay);
      if (isCooldownDone) {
        chipCooldown?.classList.add('done');
        if (chipCooldownStatus) chipCooldownStatus.innerText = '✓ Completed';
      } else {
        chipCooldown?.classList.remove('done');
        if (chipCooldownStatus) chipCooldownStatus.innerText = '5 Mins Mobility';
      }

      // 5. Water Status
      const chipWater = document.getElementById('chipWater');
      const chipWaterStatus = document.getElementById('chipWaterStatus');
      const cups = waterLog[currentDay] || 0;
      if (cups >= 8) {
        chipWater?.classList.add('done');
        if (chipWaterStatus) chipWaterStatus.innerText = '✓ 3.2L Target Hit';
      } else {
        chipWater?.classList.remove('done');
        if (chipWaterStatus) chipWaterStatus.innerText = `${cups} / 8 Glasses (${(cups * 0.4).toFixed(1)}L)`;
      }

      // 6. Active Quest Status
      const chipQuest = document.getElementById('chipQuest');
      const chipQuestStatus = document.getElementById('chipQuestStatus');
      const nextQuest = ACHIEVEMENTS.find(a => !unlockedMilestones.has(a.id)) || ACHIEVEMENTS[0];
      if (chipQuestStatus && nextQuest) {
        chipQuestStatus.innerText = `${nextQuest.icon} ${nextQuest.title}`;
      }
    }

    // Fullscreen Toggle
    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    // Audio SFX synthesis using Web Audio API
    function playAudioTone(freq, type = 'sine', duration = 0.2) {
      if (typeof SoundFX !== 'undefined' && SoundFX && SoundFX.playBeep) {
        SoundFX.playBeep(freq, type, duration, 0.15);
        return;
      }
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    // Meal Blueprints Data
    const MEAL_PLANS = {
      omnivore: [
