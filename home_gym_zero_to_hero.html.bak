    function switchDiet(dietKey) {
      document.querySelectorAll('.diet-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = Array.from(document.querySelectorAll('.diet-btn')).find(b => b.getAttribute('onclick')?.includes(dietKey));
      if (activeBtn) activeBtn.classList.add('active');

      const container = document.getElementById('mealTimelineContainer');
      container.innerHTML = '';

      const plan = MEAL_PLANS[dietKey] || MEAL_PLANS['omnivore'];
      plan.forEach(meal => {
        let itemsHtml = '';
        meal.items.forEach(it => { itemsHtml += `<li>${it}</li>`; });

        container.innerHTML += `
          <div class="meal-card">
            <div class="meal-timing">${meal.timing}</div>
            <div class="meal-name">${meal.name}</div>
            <ul class="meal-items-list">${itemsHtml}</ul>
            <div class="meal-macros-badge">Target: ${meal.macros}</div>
          </div>
        `;
      });
    }

