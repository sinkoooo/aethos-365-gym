<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>ZENITH 365 | Precision Home Gym & Longevity Operating System</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#0b1120">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="icon-192.png">
  <link rel="icon" type="image/png" href="icon-192.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0b1120;
      --bg-mesh: radial-gradient(circle at 12% 10%, rgba(0, 242, 254, 0.22) 0%, transparent 45%),
                 radial-gradient(circle at 88% 12%, rgba(168, 85, 247, 0.24) 0%, transparent 48%),
                 radial-gradient(circle at 50% 45%, rgba(16, 185, 129, 0.15) 0%, transparent 52%),
                 radial-gradient(circle at 15% 85%, rgba(255, 51, 102, 0.18) 0%, transparent 48%),
                 radial-gradient(circle at 85% 90%, rgba(251, 191, 36, 0.18) 0%, transparent 48%),
                 #0b1120;
      --bg-surface: rgba(20, 31, 58, 0.82);
      --bg-card: rgba(26, 40, 74, 0.78);
      --bg-card-hover: rgba(36, 56, 102, 0.9);
      --border: rgba(99, 133, 180, 0.32);
      --border-focus: #00f2fe;
      --cyan: #00f2fe;
      --cyan-glow: rgba(0, 242, 254, 0.35);
      --emerald: #10b981;
      --emerald-glow: rgba(16, 185, 129, 0.35);
      --amber: #fbbf24;
      --amber-glow: rgba(251, 191, 36, 0.35);
      --rose: #ff3366;
      --rose-glow: rgba(255, 51, 102, 0.35);
      --purple: #c084fc;
      --purple-glow: rgba(192, 132, 252, 0.35);
      --electric-blue: #3b82f6;
      --text: #f8fafc;
      --text-muted: #cbd5e1;
      --text-dim: #94a3b8;
      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 26px;
      --shadow-glow: 0 10px 30px -10px rgba(0, 242, 254, 0.3);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg-mesh);
      background-attachment: fixed;
      background-color: var(--bg-dark);
      color: var(--text);
      line-height: 1.6;
      padding-bottom: 120px;
      overflow-x: hidden;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 18px;
    }

    /* TOP HEADER */
    .top-header {
      background: rgba(14, 21, 38, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(56, 189, 248, 0.25);
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.45);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 12px 0;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-logo {
      width: 44px;
      height: 44px;
      background: linear-gradient(145deg, rgba(20, 31, 58, 0.95) 0%, rgba(13, 21, 40, 0.98) 100%);
      border: 1.5px solid rgba(0, 242, 254, 0.35);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.25), inset 0 0 10px rgba(0, 242, 254, 0.1);
      transition: all 0.25s ease;
      flex-shrink: 0;
    }

    .brand-logo:hover {
      border-color: var(--cyan);
      box-shadow: 0 0 30px rgba(0, 242, 254, 0.45), inset 0 0 14px rgba(0, 242, 254, 0.2);
      transform: translateY(-1px) scale(1.03);
    }

    .brand-text h1 {
      font-size: 1.28rem;
      font-weight: 900;
      letter-spacing: 0.02em;
      line-height: 1.15;
      background: linear-gradient(90deg, #ffffff 0%, #e0f2fe 35%, #38bdf8 70%, #c084fc 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 20px rgba(56, 189, 248, 0.25);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .brand-accent {
      background: linear-gradient(90deg, var(--cyan), var(--emerald));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-weight: 900;
    }

    .brand-text span {
      font-size: 0.72rem;
      color: #94a3b8;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      font-weight: 700;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .nav-pill-btn {
      background: linear-gradient(135deg, rgba(28, 42, 75, 0.75) 0%, rgba(19, 28, 50, 0.75) 100%);
      border: 1px solid rgba(99, 133, 180, 0.3);
      color: #e2e8f0;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      backdrop-filter: blur(8px);
    }

    .nav-pill-btn:hover {
      color: #fff;
      border-color: var(--cyan);
      background: linear-gradient(135deg, rgba(38, 58, 102, 0.9) 0%, rgba(28, 42, 75, 0.9) 100%);
      box-shadow: 0 0 16px rgba(0, 242, 254, 0.35);
      transform: translateY(-1px);
    }

    /* VIEW SWITCHER - WRAPS NATURALLY WITH ZERO HORIZONTAL SCROLLING */
    .view-switcher-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 16px 0 8px;
    }

    .view-tab-btn {
      background: linear-gradient(135deg, rgba(22, 34, 60, 0.82) 0%, rgba(14, 22, 40, 0.82) 100%);
      border: 1px solid rgba(99, 133, 180, 0.3);
      color: #94a3b8;
      padding: 10px 20px;
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .view-tab-btn:hover {
      color: #fff;
      border-color: var(--cyan);
      box-shadow: 0 0 18px rgba(0, 242, 254, 0.25);
    }

    .view-tab-btn.active {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.25) 0%, rgba(168, 85, 247, 0.25) 100%);
      border: 1.5px solid var(--cyan);
      color: #ffffff;
      box-shadow: 0 0 25px rgba(0, 242, 254, 0.4), inset 0 0 15px rgba(0, 242, 254, 0.15);
      text-shadow: 0 0 10px rgba(0, 242, 254, 0.7);
    }

    .app-view {
      display: none;
      animation: fadeIn 0.25s ease-in-out;
    }

    .app-view.active { display: block; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* HUD METRIC BAR */
    .hero-dashboard {
      padding: 16px 0 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
    }

    .hud-card {
      background: linear-gradient(135deg, rgba(26, 40, 72, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
      transition: all 0.25s ease;
    }

    .hud-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--purple));
    }

    .hud-card:nth-child(2)::before {
      background: linear-gradient(90deg, var(--emerald), var(--cyan));
    }

    .hud-card:nth-child(3)::before {
      background: linear-gradient(90deg, var(--purple), var(--rose));
    }

    .hud-card:nth-child(4)::before {
      background: linear-gradient(90deg, var(--amber), var(--rose));
    }

    .hud-card:hover {
      border-color: rgba(0, 242, 254, 0.55);
      box-shadow: 0 12px 35px rgba(0, 242, 254, 0.22);
      transform: translateY(-3px);
    }

    .hud-title {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-dim);
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
    }

    .hud-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.6rem;
      font-weight: 800;
      color: #fff;
      line-height: 1.1;
      text-shadow: 0 0 14px rgba(255, 255, 255, 0.2);
    }

    .hud-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* DAILY READINESS / AUTOREGULATION BAR */
    .readiness-strip {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.12) 0%, rgba(139, 92, 246, 0.1) 50%, rgba(16, 185, 129, 0.08) 100%);
      border: 1px solid rgba(56, 189, 248, 0.35);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3), inset 0 0 15px rgba(0, 242, 254, 0.05);
      border-radius: var(--radius-md);
      padding: 14px 20px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }

    .readiness-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .readiness-btns {
      display: flex;
      gap: 8px;
    }

    .btn-energy {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-energy.active-high { background: rgba(16, 185, 129, 0.2); border-color: var(--emerald); color: #34d399; }
    .btn-energy.active-norm { background: rgba(56, 189, 248, 0.2); border-color: var(--cyan); color: #38bdf8; }
    .btn-energy.active-low  { background: rgba(245, 158, 11, 0.2); border-color: var(--amber); color: #fbbf24; }

    /* WATER LOGGING DOCK */
    .water-row {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .water-cup {
      width: 26px;
      height: 28px;
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      cursor: pointer;
      user-select: none;
      transition: all 0.2s;
    }

    .water-cup.filled {
      background: rgba(56, 189, 248, 0.25);
      border-color: var(--cyan);
      color: var(--cyan);
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.3);
    }

    /* DAY CONTROLLER DOCK */
    .day-dock {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 14px 20px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }

    .day-nav-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-nav-day {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-nav-day:hover {
      border-color: var(--cyan);
      background: var(--bg-card-hover);
    }

    .day-display-box {
      background: linear-gradient(135deg, rgba(16, 25, 48, 0.95) 0%, rgba(10, 16, 32, 0.95) 100%);
      border: 1.5px solid var(--cyan);
      border-radius: var(--radius-sm);
      padding: 6px 14px;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 0 16px rgba(0, 242, 254, 0.35);
    }

    .day-display-box span {
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--cyan);
    }

    .day-display-box input {
      background: transparent;
      border: none;
      color: #fff;
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.25rem;
      font-weight: 800;
      width: 55px;
      text-align: center;
      outline: none;
    }

    .slider-track {
      flex: 1;
      min-width: 180px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .slider-track input {
      width: 100%;
      accent-color: var(--cyan);
      cursor: pointer;
    }

    .day-dock-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn-complete-day {
      background: linear-gradient(135deg, #059669, #10b981);
      color: #fff;
      border: none;
      padding: 9px 18px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .btn-complete-day.completed {
      background: #1f2937;
      color: #94a3b8;
      border: 1px solid var(--border);
    }

    /* 5-DAY ADVANCE EQUIPMENT RADAR */
    .equipment-radar {
      display: none;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(239, 68, 68, 0.08));
      border: 2px solid var(--amber);
      border-radius: var(--radius-lg);
      padding: 20px;
      margin-bottom: 24px;
      animation: alertPulse 2s infinite alternate;
    }

    @keyframes alertPulse {
      from { box-shadow: 0 0 10px rgba(245, 158, 11, 0.2); }
      to { box-shadow: 0 0 25px rgba(245, 158, 11, 0.45); }
    }

    .radar-tag {
      background: var(--amber);
      color: #000;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: inline-block;
      margin-bottom: 8px;
    }

    .radar-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 6px;
    }

    .radar-desc {
      color: #cbd5e1;
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .radar-specs {
      background: rgba(0,0,0,0.35);
      border-left: 3px solid var(--amber);
      padding: 10px 14px;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      margin-top: 10px;
      font-size: 0.88rem;
    }

    .radar-btn {
      margin-top: 14px;
      background: var(--amber);
      color: #000 !important;
      text-decoration: none;
      font-weight: 800;
      font-size: 0.82rem;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    /* WORKOUT LAYOUT */
    .workout-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 24px;
    }

    @media (max-width: 992px) {
      .workout-layout { grid-template-columns: 1fr; }
    }

    .workout-main {
      background: linear-gradient(135deg, rgba(20, 31, 58, 0.82) 0%, rgba(13, 21, 40, 0.82) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(56, 189, 248, 0.28);
      border-radius: var(--radius-xl);
      padding: 26px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(56, 189, 248, 0.1);
    }

    .workout-header {
      border-bottom: 1px solid rgba(99, 133, 180, 0.3);
      padding-bottom: 18px;
      margin-bottom: 22px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 12px;
    }

    .workout-day-heading {
      font-size: 1.6rem;
      font-weight: 800;
      color: #fff;
      text-shadow: 0 0 15px rgba(255,255,255,0.2);
    }

    .workout-meta-line {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .badge-phase {
      font-size: 0.72rem;
      font-weight: 800;
      padding: 5px 12px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 0 12px rgba(0,0,0,0.3);
    }

    .bp-1 { background: rgba(0, 242, 254, 0.18); color: var(--cyan); border: 1.5px solid var(--cyan); box-shadow: 0 0 12px rgba(0, 242, 254, 0.35); }
    .bp-2 { background: rgba(16, 185, 129, 0.18); color: var(--emerald); border: 1.5px solid var(--emerald); box-shadow: 0 0 12px rgba(16, 185, 129, 0.35); }
    .bp-3 { background: rgba(192, 132, 252, 0.18); color: var(--purple); border: 1.5px solid var(--purple); box-shadow: 0 0 12px rgba(192, 132, 252, 0.35); }
    .bp-4 { background: rgba(251, 191, 36, 0.18); color: var(--amber); border: 1.5px solid var(--amber); box-shadow: 0 0 12px rgba(251, 191, 36, 0.35); }

    /* WARMUP GUIDED BANNER */
    .warmup-launch-box {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.12) 0%, rgba(168, 85, 247, 0.1) 100%);
      border: 1px dashed rgba(0, 242, 254, 0.45);
      border-radius: var(--radius-md);
      padding: 16px 20px;
      margin-bottom: 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }

    .btn-launch-warmup {
      background: linear-gradient(135deg, var(--cyan), #2563eb);
      color: #000 !important;
      font-weight: 800;
      border: none;
      padding: 8px 18px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
      box-shadow: 0 0 15px rgba(0, 242, 254, 0.4);
    }

    .btn-launch-warmup:hover {
      filter: brightness(1.2);
      transform: translateY(-1px);
    }

    /* MOBILITY TECHNIQUE & FOLLOW-ALONG HUD STYLES */
    .pillar-tag {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      padding: 2px 7px;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .pillar-warmup {
      background: rgba(0, 242, 254, 0.15);
      color: var(--cyan);
      border: 1px solid rgba(0, 242, 254, 0.3);
    }
    .pillar-cooldown {
      background: rgba(16, 185, 129, 0.15);
      color: var(--emerald);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .mobility-chips-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .mobility-chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #94a3b8;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 99px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .mobility-chip:hover {
      background: rgba(0, 242, 254, 0.12);
      border-color: var(--cyan);
      color: #fff;
    }
    .mobility-chip.active {
      background: rgba(0, 242, 254, 0.2);
      border-color: var(--cyan);
      color: var(--cyan);
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
    }
    .mobility-chip.cooldown-chip:hover {
      background: rgba(16, 185, 129, 0.12);
      border-color: var(--emerald);
      color: #fff;
    }
    .mobility-chip.cooldown-chip.active {
      background: rgba(16, 185, 129, 0.2);
      border-color: var(--emerald);
      color: var(--emerald);
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
    }

    .btn-toggle-guides {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      color: #cbd5e1;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .btn-toggle-guides:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--cyan);
      color: #fff;
    }

    /* ACTIVE FOLLOW-ALONG HUD PLAYER */
    .warmup-player-hud,
    .cooldown-player-hud {
      background: linear-gradient(145deg, rgba(20, 31, 58, 0.95) 0%, rgba(13, 21, 40, 0.98) 100%);
      border: 1.5px solid rgba(0, 242, 254, 0.45);
      border-radius: var(--radius-md);
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 242, 254, 0.15);
      animation: fadeIn 0.3s ease;
    }
    .cooldown-player-hud {
      border-color: rgba(16, 185, 129, 0.45);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(16, 185, 129, 0.15);
    }

    .player-clock-circle {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(0, 242, 254, 0.08);
      border: 2.5px solid var(--cyan);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      font-size: 1.35rem;
      color: var(--cyan);
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.35);
      flex-shrink: 0;
    }
    .cooldown-player-hud .player-clock-circle {
      border-color: var(--emerald);
      color: var(--emerald);
      background: rgba(16, 185, 129, 0.08);
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
    }

    /* BREATHING & CADENCE PACER */
    .breathing-cadence-box {
      background: rgba(10, 16, 32, 0.7);
      border: 1px solid rgba(251, 191, 36, 0.3);
      border-radius: 8px;
      padding: 12px 16px;
      margin: 14px 0;
    }
    .breathing-bar-track {
      width: 100%;
      height: 10px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 99px;
      overflow: hidden;
      margin: 8px 0;
      position: relative;
    }
    .breathing-bar-fill {
      height: 100%;
      width: 50%;
      background: linear-gradient(90deg, var(--cyan), var(--emerald));
      border-radius: 99px;
      transition: width 1s linear;
    }

    /* TECHNIQUE DRAWER & CARDS */
    .technique-guides-drawer {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 22px;
      animation: fadeIn 0.3s ease;
    }

    .technique-card {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.85) 0%, rgba(16, 26, 50, 0.85) 100%);
      border: 1px solid rgba(99, 133, 180, 0.3);
      border-left: 4px solid var(--cyan);
      border-radius: var(--radius-md);
      padding: 18px 22px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      transition: all 0.2s ease;
    }
    .technique-card.cooldown-card {
      border-left-color: var(--emerald);
    }
    .technique-card:hover {
      border-color: rgba(0, 242, 254, 0.5);
      transform: translateY(-1px);
    }

    .tech-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 12px;
    }

    .tech-badge-pill {
      font-size: 0.72rem;
      font-weight: 700;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.25);
      color: var(--cyan);
      padding: 3px 9px;
      border-radius: 99px;
    }

    .tech-why-callout {
      background: rgba(0, 242, 254, 0.06);
      border-left: 3px solid var(--cyan);
      padding: 10px 14px;
      border-radius: 0 6px 6px 0;
      font-size: 0.84rem;
      color: #cbd5e1;
      line-height: 1.45;
      margin-bottom: 14px;
    }
    .tech-why-callout.cooldown-callout {
      background: rgba(16, 185, 129, 0.06);
      border-left-color: var(--emerald);
    }

    .tech-phases-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 12px;
      margin-bottom: 14px;
    }

    .tech-phase-box {
      background: rgba(13, 21, 40, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 12px 14px;
    }

    .tech-phase-title {
      font-size: 0.84rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .tech-cues-list {
      margin: 0;
      padding-left: 18px;
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.45;
    }

    .tech-mistakes-box {
      background: rgba(244, 63, 94, 0.08);
      border: 1px solid rgba(244, 63, 94, 0.25);
      border-radius: 8px;
      padding: 12px 14px;
      margin-top: 10px;
    }

    .tech-mistake-item {
      font-size: 0.78rem;
      margin-bottom: 6px;
      line-height: 1.4;
    }
    .tech-mistake-item:last-child {
      margin-bottom: 0;
    }

    /* ZENITH BEATS & WORKOUT SOUNDTRACK STUDIO */
    .header-music-pill {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: linear-gradient(135deg, rgba(20, 31, 58, 0.9) 0%, rgba(13, 21, 40, 0.95) 100%);
      border: 1px solid rgba(0, 242, 254, 0.35);
      border-radius: 99px;
      padding: 5px 12px 5px 10px;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }
    .header-music-pill:hover {
      border-color: var(--cyan);
      box-shadow: 0 0 16px rgba(0, 242, 254, 0.3);
      transform: translateY(-1px);
    }
    .header-music-pill.playing {
      border-color: var(--cyan);
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.15) 0%, rgba(13, 21, 40, 0.95) 100%);
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.35);
    }
    .music-pill-info {
      display: flex;
      flex-direction: column;
      text-align: left;
    }
    .music-pill-title {
      font-size: 0.76rem;
      font-weight: 800;
      color: #fff;
      white-space: nowrap;
      max-width: 140px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .music-pill-status {
      font-size: 0.65rem;
      color: var(--cyan);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .btn-music-mini-toggle {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--cyan);
      color: #0b1120;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 900;
      cursor: pointer;
      transition: transform 0.2s ease;
      flex-shrink: 0;
    }
    .btn-music-mini-toggle:hover {
      transform: scale(1.1);
    }
    .btn-music-mini-toggle.playing {
      background: var(--emerald);
      color: #000;
    }

    /* Equalizer Wave Animation */
    .audio-eq-bars {
      display: inline-flex;
      align-items: flex-end;
      gap: 2.5px;
      height: 16px;
      margin-right: 2px;
    }
    .audio-bar {
      width: 3px;
      height: 5px;
      background: var(--cyan);
      border-radius: 2px;
      transition: height 0.15s ease;
    }
    .audio-bar.animating:nth-child(1) { animation: eqBounce 0.6s infinite ease-in-out alternate; }
    .audio-bar.animating:nth-child(2) { animation: eqBounce 0.4s 0.15s infinite ease-in-out alternate; }
    .audio-bar.animating:nth-child(3) { animation: eqBounce 0.7s 0.05s infinite ease-in-out alternate; }
    .audio-bar.animating:nth-child(4) { animation: eqBounce 0.5s 0.2s infinite ease-in-out alternate; }
    @keyframes eqBounce {
      0% { height: 4px; }
      50% { height: 16px; }
      100% { height: 6px; }
    }

    /* Music Modal & Channel Cards */
    .music-genre-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin: 16px 0;
    }
    .music-genre-card {
      background: rgba(13, 21, 40, 0.75);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      padding: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: left;
      position: relative;
    }
    .music-genre-card:hover {
      border-color: rgba(0, 242, 254, 0.4);
      background: rgba(20, 31, 58, 0.85);
      transform: translateY(-2px);
    }
    .music-genre-card.active {
      border-color: var(--cyan);
      background: rgba(0, 242, 254, 0.08);
      box-shadow: 0 0 18px rgba(0, 242, 254, 0.25);
    }
    .music-genre-card[data-track="youtube_music"].active {
      border-color: #ef4444;
      background: rgba(239, 68, 68, 0.12);
      box-shadow: 0 0 18px rgba(239, 68, 68, 0.3);
    }
    .btn-yt-preset {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #e2e8f0;
      padding: 4px 11px;
      border-radius: 99px;
      font-size: 0.73rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-yt-preset:hover, .btn-yt-preset.active {
      background: rgba(239, 68, 68, 0.25);
      border-color: rgba(239, 68, 68, 0.65);
      color: #fff;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
    }
    .music-tag-pill {
      font-size: 0.65rem;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(0, 242, 254, 0.15);
      color: var(--cyan);
      border: 1px solid rgba(0, 242, 254, 0.3);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .music-ducking-pill {
      display: none;
      align-items: center;
      gap: 5px;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--amber);
      background: rgba(251, 191, 36, 0.12);
      border: 1px solid rgba(251, 191, 36, 0.3);
      padding: 3px 9px;
      border-radius: 99px;
      animation: pulse 1s infinite alternate;
    }

    /* EXERCISE CARDS FLOW */
    .exercise-cards-flow {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .pro-ex-card {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.78) 0%, rgba(16, 26, 50, 0.78) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(99, 133, 180, 0.28);
      border-left: 4px solid var(--cyan);
      border-radius: var(--radius-lg);
      padding: 22px;
      box-shadow: 0 10px 28px -5px rgba(0, 0, 0, 0.4), 0 0 20px -10px rgba(0, 242, 254, 0.2);
      transition: all 0.25s ease;
    }

    .pro-ex-card:hover {
      border-color: rgba(0, 242, 254, 0.55);
      border-left: 4px solid var(--cyan);
      box-shadow: 0 14px 35px rgba(0, 242, 254, 0.25);
      transform: translateY(-2px);
    }

    .ex-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .ex-title-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .ex-title-text {
      font-size: 1.15rem;
      font-weight: 700;
      color: #fff;
    }

    .ex-target-pill {
      font-size: 0.72rem;
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(255,255,255,0.06);
      color: var(--text-muted);
    }

    .ex-target-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--emerald);
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.25);
      padding: 4px 10px;
      border-radius: 6px;
      white-space: nowrap;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .ex-visual-grid {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 18px;
      margin-bottom: 16px;
    }

    @media (max-width: 768px) {
      .ex-visual-grid { grid-template-columns: 1fr; }
    }

    .ex-crop-viewport {
      width: 100%;
      height: 165px;
      background-image: url('home_workout_guide.jpg');
      background-size: 300% 200%;
      background-repeat: no-repeat;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      box-shadow: inset 0 0 15px rgba(0,0,0,0.6);
    }

    .crop-box-squat      { background-position: 0% 18%; }
    .crop-incline-pushup { background-position: 50% 18%; }
    .crop-glute-bridge   { background-position: 100% 18%; }
    .crop-door-row       { background-position: 0% 86%; }
    .crop-dead-bug       { background-position: 50% 86%; }
    .crop-reverse-lunge  { background-position: 100% 86%; }

    .ex-cues-panel {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
      background: rgba(0,0,0,0.3);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      font-size: 0.85rem;
      border-left: 3px solid var(--cyan);
    }

    .ex-cues-panel strong {
      color: var(--cyan);
      display: block;
      margin-bottom: 2px;
    }

    .set-logging-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 14px;
      background: rgba(0,0,0,0.2);
      border-radius: var(--radius-sm);
      overflow: hidden;
    }

    .set-logging-table th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-dim);
      padding: 8px 12px;
      text-align: left;
      background: rgba(255,255,255,0.02);
    }

    .set-logging-table td {
      padding: 8px 12px;
      border-top: 1px solid rgba(255,255,255,0.05);
      font-size: 0.85rem;
    }

    .log-input {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: #fff;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      width: 76px;
      padding: 4px 6px;
      border-radius: 4px;
      text-align: center;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .log-input:focus {
      border-color: var(--cyan);
      box-shadow: 0 0 8px rgba(0, 242, 254, 0.3);
    }

    .log-input.log-input-reps {
      width: 98px;
      min-width: 92px;
      font-size: 0.85rem;
      padding: 4px 6px;
      letter-spacing: -0.2px;
      font-weight: 600;
      color: #38bdf8;
    }

    .log-input.log-input-wt {
      width: 78px;
      min-width: 72px;
    }

    .btn-check-set {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 5px 10px;
      border-radius: 4px;
      font-size: 0.78rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s;
    }

    .btn-check-set.done {
      background: rgba(16, 185, 129, 0.18);
      border-color: var(--emerald);
      color: #34d399;
      font-weight: 700;
    }

    /* SIDEBAR TOOLS */
    .sidebar-pane {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .side-widget {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px;
    }

    .widget-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .widget-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* TEMPO METRONOME PACER WIDGET */
    .tempo-pacer-box {
      background: linear-gradient(145deg, rgba(20, 31, 58, 0.9) 0%, rgba(13, 21, 40, 0.9) 100%);
      border-radius: var(--radius-md);
      padding: 16px;
      text-align: center;
      border: 1px solid rgba(56, 189, 248, 0.3);
      box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.35);
    }

    .tempo-circle {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 3px solid var(--cyan);
      margin: 10px auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: transform 0.4s ease, border-color 0.4s ease;
    }

    .tempo-circle.down { transform: scale(0.85); border-color: var(--amber); }
    .tempo-circle.hold { transform: scale(0.85); border-color: var(--rose); }
    .tempo-circle.up   { transform: scale(1.1);  border-color: var(--emerald); }

    .btn-tempo-start {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      width: 100%;
      margin-top: 10px;
    }

    .mirror-box {
      width: 100%;
      height: 200px;
      background: linear-gradient(135deg, rgba(16, 25, 48, 0.95), rgba(10, 16, 32, 0.95));
      border-radius: var(--radius-md);
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(56, 189, 248, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.15);
    }

    .mirror-box video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }

    .mirror-placeholder {
      color: var(--text-dim);
      font-size: 0.78rem;
      text-align: center;
      padding: 16px;
    }

    .btn-mirror-toggle {
      background: var(--cyan);
      color: #000 !important;
      font-weight: 700;
      border: none;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.78rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      width: 100%;
      justify-content: center;
    }

    .heatmap-visual {
      background: linear-gradient(145deg, rgba(20, 31, 58, 0.9) 0%, rgba(13, 21, 40, 0.9) 100%);
      border-radius: var(--radius-md);
      padding: 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      border: 1px solid rgba(56, 189, 248, 0.28);
      box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.35);
    }

    .heatmap-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .muscle-tag {
      font-size: 0.7rem;
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .mt-active { background: rgba(56, 189, 248, 0.2); color: var(--cyan); border: 1px solid rgba(56, 189, 248, 0.4); }
    .mt-secondary { background: rgba(168, 85, 247, 0.2); color: var(--purple); border: 1px solid rgba(168, 85, 247, 0.4); }

    /* NUTRITION & ESSENTIALS */
    .pro-section-card {
      background: linear-gradient(145deg, rgba(20, 31, 58, 0.85) 0%, rgba(13, 21, 40, 0.85) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(56, 189, 248, 0.28);
      border-radius: var(--radius-xl);
      padding: 26px;
      margin-bottom: 24px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 25px rgba(56, 189, 248, 0.08);
    }

    .pro-section-head {
      margin-bottom: 20px;
      border-bottom: 1px solid rgba(99, 133, 180, 0.3);
      padding-bottom: 16px;
    }

    .pro-section-head h2 {
      font-size: 1.45rem;
      font-weight: 800;
      color: #fff;
    }

    .diet-switcher {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .diet-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .diet-btn.active {
      background: var(--cyan);
      color: #000;
      border-color: var(--cyan);
      box-shadow: 0 0 18px rgba(0, 242, 254, 0.4);
    }

    .meal-timeline {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }

    .meal-card {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(99, 133, 180, 0.3);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
      transition: all 0.25s ease;
    }

    .meal-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald), var(--cyan));
    }

    .meal-card:hover {
      border-color: rgba(16, 185, 129, 0.55);
      box-shadow: 0 12px 30px rgba(16, 185, 129, 0.22);
      transform: translateY(-2px);
    }

    .meal-timing {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--cyan);
      font-weight: 800;
      margin-bottom: 4px;
    }

    .meal-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }

    .meal-items-list {
      list-style: none;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .meal-items-list li {
      padding: 4px 0;
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }

    .meal-items-list li::before {
      content: '•';
      color: var(--emerald);
      font-weight: bold;
    }

    .meal-macros-badge {
      display: inline-block;
      margin-top: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--emerald);
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.25);
      padding: 3px 8px;
      border-radius: 4px;
    }

    .supp-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-top: 16px;
    }

    .supp-card {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.82) 0%, rgba(16, 25, 48, 0.82) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(99, 133, 180, 0.3);
      border-radius: var(--radius-md);
      padding: 18px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
      transition: all 0.25s ease;
    }

    .supp-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--amber), var(--purple));
    }

    .supp-card:hover {
      border-color: rgba(251, 191, 36, 0.55);
      box-shadow: 0 12px 30px rgba(251, 191, 36, 0.22);
      transform: translateY(-2px);
    }

    .supp-tier {
      font-size: 0.7rem;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 4px;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 6px;
    }

    .tier-gold { background: rgba(245, 158, 11, 0.2); color: var(--amber); border: 1px solid rgba(245, 158, 11, 0.4); }
    .tier-green { background: rgba(16, 185, 129, 0.2); color: var(--emerald); border: 1px solid rgba(16, 185, 129, 0.4); }

    .essentials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    .essential-box {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.82) 0%, rgba(16, 25, 48, 0.82) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(99, 133, 180, 0.3);
      border-radius: var(--radius-md);
      padding: 20px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
      transition: all 0.25s ease;
    }

    .essential-box::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--purple));
    }

    .essential-box:hover {
      border-color: rgba(0, 242, 254, 0.45);
      box-shadow: 0 12px 30px rgba(0, 242, 254, 0.18);
      transform: translateY(-2px);
    }

    .essential-box h3 {
      font-size: 1.08rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dos-donts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 12px;
      font-size: 0.82rem;
    }

    .do-col {
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: 6px;
      padding: 8px 10px;
      color: #34d399;
    }

    .dont-col {
      background: rgba(244, 63, 94, 0.08);
      border: 1px solid rgba(244, 63, 94, 0.25);
      border-radius: 6px;
      padding: 8px 10px;
      color: #fb7185;
    }

    /* FLOATING TIMER */
    .floating-timer {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: linear-gradient(145deg, rgba(22, 34, 62, 0.95) 0%, rgba(14, 21, 40, 0.95) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1.5px solid var(--cyan);
      border-radius: var(--radius-lg);
      padding: 14px 20px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 242, 254, 0.3);
      display: flex;
      align-items: center;
      gap: 16px;
      z-index: 99;
    }

    .timer-digits {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--cyan);
      min-width: 75px;
      text-shadow: 0 0 12px rgba(0, 242, 254, 0.5);
    }

    .timer-actions {
      display: flex;
      gap: 6px;
    }

    .t-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: #fff;
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.15s;
    }

    .t-btn:hover {
      background: var(--cyan);
      color: #000;
      font-weight: 700;
      box-shadow: 0 0 12px rgba(0, 242, 254, 0.4);
    }

    /* MODALS */
    .app-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(4, 7, 15, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .app-modal.active { display: flex; }

    .modal-box {
      background: linear-gradient(160deg, rgba(22, 34, 64, 0.96) 0%, rgba(14, 22, 42, 0.96) 100%);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border: 1.5px solid rgba(56, 189, 248, 0.35);
      border-radius: var(--radius-xl);
      max-width: 920px;
      width: 100%;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(0, 242, 254, 0.2);
    }

    .modal-header {
      padding: 18px 24px;
      background: linear-gradient(135deg, rgba(28, 42, 78, 0.92) 0%, rgba(18, 28, 52, 0.92) 100%);
      border-bottom: 1px solid rgba(56, 189, 248, 0.25);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-title {
      font-size: 1.25rem;
      font-weight: 800;
    }

    .modal-close {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.8rem;
      cursor: pointer;
      line-height: 1;
    }

    .modal-body {
      padding: 24px;
      overflow-y: auto;
      flex: 1;
    }

    .cal-grid-365 {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(38px, 1fr));
      gap: 6px;
    }

    .cal-cell {
      aspect-ratio: 1;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      user-select: none;
      transition: all 0.15s;
      position: relative;
    }

    .cal-cell:hover {
      border-color: var(--cyan);
      transform: scale(1.1);
      z-index: 2;
    }

    .cal-cell.selected {
      border-color: var(--cyan);
      box-shadow: 0 0 10px var(--cyan);
    }

    .cal-cell.completed {
      background: rgba(16, 185, 129, 0.25);
      border-color: var(--emerald);
      color: #34d399;
    }

    .cal-cell.has-alert::after {
      content: '';
      position: absolute;
      top: 3px;
      right: 3px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--amber);
    }

    .badge-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .trophy-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      align-items: center;
      gap: 14px;
      opacity: 0.45;
      transition: all 0.2s;
    }

    .trophy-card.unlocked {
      opacity: 1;
      border-color: var(--amber);
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(14, 19, 31, 0.9));
    }

    .trophy-icon {
      font-size: 2.2rem;
      line-height: 1;
    }

    /* 365-DAY CONSISTENCY MATRIX */
    .consistency-heatmap-card {
      background: linear-gradient(135deg, rgba(22, 34, 62, 0.85) 0%, rgba(14, 23, 44, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(56, 189, 248, 0.28);
      border-radius: var(--radius-lg);
      padding: 18px 22px;
      margin-bottom: 22px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }

    .heatmap-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .heatmap-legend {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.74rem;
      color: var(--text-muted);
      flex-wrap: wrap;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 3px;
      display: inline-block;
    }

    .dot-done   { background: linear-gradient(135deg, #00f2fe, #10b981); box-shadow: 0 0 10px rgba(16, 185, 129, 0.8); }
    .dot-rec    { background: linear-gradient(135deg, #38bdf8, #818cf8); box-shadow: 0 0 8px rgba(56, 189, 248, 0.6); }
    .dot-alert  { background: linear-gradient(135deg, #fbbf24, #f97316); box-shadow: 0 0 8px rgba(251, 191, 36, 0.8); }
    .dot-future { background: rgba(255,255,255,0.08); border: 1px solid rgba(99, 133, 180, 0.28); }

    .heatmap-scroll-area {
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: thin;
      scrollbar-color: rgba(0, 242, 254, 0.4) rgba(15, 23, 42, 0.6);
      -webkit-overflow-scrolling: touch;
    }
    .heatmap-scroll-area::-webkit-scrollbar {
      height: 6px;
    }
    .heatmap-scroll-area::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
      border-radius: 99px;
    }
    .heatmap-scroll-area::-webkit-scrollbar-thumb {
      background: linear-gradient(90deg, var(--cyan), var(--emerald));
      border-radius: 99px;
    }
    .heatmap-months-row {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      width: 806px;
      margin-bottom: 6px;
      font-size: 0.68rem;
      font-weight: 800;
      color: #64748b;
      letter-spacing: 0.5px;
    }
    .heatmap-months-row span {
      text-align: left;
    }

    .heatmap-grid-52 {
      display: grid;
      grid-template-rows: repeat(7, 12px);
      grid-auto-flow: column;
      grid-auto-columns: 12px;
      gap: 3.5px;
      width: max-content;
    }

    .h-cell {
      width: 12px;
      height: 12px;
      border-radius: 2.5px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.04);
      cursor: pointer;
      transition: transform 0.15s, outline 0.15s, box-shadow 0.15s;
      position: relative;
    }

    .h-cell:hover {
      transform: scale(1.6);
      z-index: 10;
      outline: 1.5px solid var(--cyan);
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.6);
    }

    .h-cell.done {
      background: linear-gradient(135deg, #00f2fe, #10b981);
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
      border-color: rgba(16, 185, 129, 0.4);
    }

    .h-cell.rec {
      background: linear-gradient(135deg, #38bdf8, #818cf8);
      box-shadow: 0 0 6px rgba(56, 189, 248, 0.5);
      border-color: rgba(56, 189, 248, 0.4);
    }

    .h-cell.alert {
      background: linear-gradient(135deg, #fbbf24, #f97316);
      box-shadow: 0 0 6px rgba(251, 191, 36, 0.7);
      border-color: rgba(251, 191, 36, 0.4);
    }

    .h-cell.active-day {
      outline: 2px solid #fbbf24;
      outline-offset: 1px;
      box-shadow: 0 0 14px rgba(251, 191, 36, 0.9);
      animation: cellPulse 1.8s infinite alternate;
    }

    /* COOLDOWN GUIDED BANNER */
    .cooldown-launch-box {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(56, 189, 248, 0.06));
      border: 1px dashed rgba(16, 185, 129, 0.35);
      border-radius: var(--radius-md);
      padding: 14px 18px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn-launch-cooldown {
      background: var(--emerald);
      color: #000 !important;
      font-weight: 800;
      border: none;
      padding: 7px 16px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .btn-launch-cooldown:hover {
      filter: brightness(1.15);
      transform: translateY(-1px);
    }

    /* EXERCISE PROGRESSION SELECTOR PILLS */
    .progression-pills {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      flex-wrap: wrap;
    }

    .prog-label {
      font-size: 0.72rem;
      color: var(--text-dim);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .prog-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 3px 9px;
      border-radius: 4px;
      font-size: 0.74rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }

    .prog-btn:hover {
      color: #fff;
      border-color: var(--border-focus);
    }

    .prog-btn.active-std {
      background: rgba(56, 189, 248, 0.18);
      border-color: var(--cyan);
      color: var(--cyan);
      font-weight: 700;
    }

    .prog-btn.active-easy {
      background: rgba(245, 158, 11, 0.18);
      border-color: var(--amber);
      color: var(--amber);
      font-weight: 700;
    }

    .prog-btn.active-hard {
      background: rgba(244, 63, 94, 0.18);
      border-color: var(--rose);
      color: var(--rose);
      font-weight: 700;
    }

    /* TDEE & MACRO CALCULATOR */
    .macro-calc-box {
      background: linear-gradient(145deg, rgba(20, 31, 58, 0.85) 0%, rgba(13, 21, 40, 0.85) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: var(--radius-xl);
      padding: 24px;
      margin-bottom: 24px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35), 0 0 30px rgba(0, 242, 254, 0.1);
    }

    .calc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 20px;
    }

    .calc-input-group label {
      display: block;
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }

    .calc-input-group select,
    .calc-input-group input {
      width: 100%;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: #fff;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.95rem;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      outline: none;
      transition: border-color 0.2s;
    }

    .calc-input-group select:focus,
    .calc-input-group input:focus {
      border-color: var(--cyan);
    }

    .goal-chip {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 99px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .goal-chip:hover {
      border-color: var(--cyan);
      color: #fff;
    }
    .goal-chip.active {
      background: rgba(0, 242, 254, 0.15);
      border-color: var(--cyan);
      color: var(--cyan);
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
    }

    .macro-stat-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 14px;
      margin: 20px 0;
    }

    .macro-stat-card {
      background: linear-gradient(135deg, rgba(26, 40, 74, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(99, 133, 180, 0.3);
      border-radius: var(--radius-md);
      padding: 16px 14px;
      text-align: center;
      position: relative;
      overflow: hidden;
      transition: all 0.25s ease;
    }

    .macro-stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }

    .macro-card-cals::before { background: linear-gradient(90deg, #00f2fe, #38bdf8); }
    .macro-card-cals { border-color: rgba(0, 242, 254, 0.35); box-shadow: 0 4px 20px rgba(0, 242, 254, 0.15); }

    .macro-card-prot::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .macro-card-prot { border-color: rgba(16, 185, 129, 0.35); box-shadow: 0 4px 20px rgba(16, 185, 129, 0.15); }

    .macro-card-carbs::before { background: linear-gradient(90deg, #c084fc, #a855f7); }
    .macro-card-carbs { border-color: rgba(192, 132, 252, 0.35); box-shadow: 0 4px 20px rgba(192, 132, 252, 0.15); }

    .macro-card-fats::before { background: linear-gradient(90deg, #fbbf24, #f59e0b); }
    .macro-card-fats { border-color: rgba(251, 191, 36, 0.35); box-shadow: 0 4px 20px rgba(251, 191, 36, 0.15); }

    .macro-card-water::before { background: linear-gradient(90deg, #38bdf8, #2563eb); }
    .macro-card-water { border-color: rgba(56, 189, 248, 0.35); box-shadow: 0 4px 20px rgba(56, 189, 248, 0.15); }

    .macro-stat-card:hover {
      transform: translateY(-2px);
    }

    .m-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.4rem;
      font-weight: 800;
      color: #fff;
    }

    .m-label {
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 4px;
    }

    .macro-bar-wrap {
      background: rgba(0,0,0,0.3);
      border-radius: 6px;
      overflow: hidden;
      height: 10px;
      display: flex;
      margin: 12px 0 6px;
    }

    .macro-bar-p { background: var(--emerald); }
    .macro-bar-c { background: var(--cyan); }
    .macro-bar-f { background: var(--amber); }

    /* 12-MONTH MASTER ROADMAP STYLES */
    .roadmap-hero {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.15) 0%, rgba(168, 85, 247, 0.15) 50%, rgba(16, 185, 129, 0.1) 100%);
      border: 1px solid rgba(56, 189, 248, 0.35);
      border-radius: var(--radius-xl);
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.4), inset 0 0 25px rgba(0, 242, 254, 0.08);
    }

    .roadmap-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }

    .month-card {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(99, 133, 180, 0.3);
      border-radius: var(--radius-lg);
      padding: 22px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    }

    .month-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--purple));
    }

    .month-card:nth-child(even)::before {
      background: linear-gradient(90deg, var(--amber), var(--emerald));
    }

    .month-card:hover {
      border-color: rgba(0, 242, 254, 0.55);
      box-shadow: 0 14px 35px rgba(0, 242, 254, 0.22);
      transform: translateY(-3px);
    }

    .month-card.current-active-month {
      border: 1.5px solid var(--cyan);
      box-shadow: 0 0 25px rgba(0, 242, 254, 0.35);
    }

    .month-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }

    .month-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 4px;
      text-transform: uppercase;
    }

    .mb-zero { background: rgba(56, 189, 248, 0.15); color: var(--cyan); border: 1px solid rgba(56, 189, 248, 0.3); }
    .mb-equip { background: rgba(245, 158, 11, 0.15); color: var(--amber); border: 1px solid rgba(245, 158, 11, 0.3); }
    .mb-master { background: rgba(16, 185, 129, 0.15); color: var(--emerald); border: 1px solid rgba(16, 185, 129, 0.3); }

    .month-card h3 {
      font-size: 1.12rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 6px;
    }

    .month-equip-box {
      background: rgba(0,0,0,0.3);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      margin: 10px 0;
      font-size: 0.84rem;
      border-left: 3px solid var(--cyan);
    }

    .month-bio-adaptation {
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin: 8px 0 14px;
    }

    .btn-jump-month {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      width: 100%;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-jump-month:hover {
      background: var(--cyan);
      color: #000;
      font-weight: 800;
    }

    .savings-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 14px;
      font-size: 0.88rem;
    }

    .savings-table th {
      background: rgba(255,255,255,0.03);
      padding: 10px 14px;
      text-align: left;
      color: var(--text-dim);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .savings-table td {
      padding: 12px 14px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    /* VOICE COACH SETTINGS MODAL */
    .voice-control-group {
      margin-bottom: 16px;
    }

    .voice-control-group label {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .voice-control-group select,
    .voice-control-group input[type="range"] {
      width: 100%;
    }

    .voice-control-group select {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: #fff;
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 0.9rem;
    }

    /* PRINT STYLES - PRISTINE A4 WORKOUT CHEAT SHEET */
    @media print {
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      body {
        background: #fff !important;
        color: #000 !important;
        font-family: Arial, sans-serif !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .top-header, .view-switcher-bar, .readiness-strip, .day-dock,
      .sidebar-pane, .floating-timer, .app-modal, .warmup-launch-box,
      .cooldown-launch-box, .consistency-heatmap-card, .equipment-radar,
      .ex-crop-viewport, .btn-mirror-toggle, .btn-check-set, .progression-pills,
      a[href*="youtube.com"] {
        display: none !important;
      }
      .app-view {
        display: block !important;
      }
      #nutritionView, #essentialsView, #roadmapView {
        display: none !important;
      }
      .container {
        max-width: 100% !important;
        padding: 0 !important;
      }
      .workout-layout {
        display: block !important;
      }
      .workout-main {
        background: #fff !important;
        border: none !important;
        padding: 0 !important;
        box-shadow: none !important;
      }
      .workout-header {
        border-bottom: 2px solid #000 !important;
        margin-bottom: 14px !important;
        padding-bottom: 10px !important;
      }
      .workout-day-heading {
        color: #000 !important;
        font-size: 1.4rem !important;
      }
      .workout-meta-line {
        color: #444 !important;
        font-size: 0.85rem !important;
      }
      .badge-phase {
        border: 1px solid #000 !important;
        color: #000 !important;
        background: #eee !important;
      }
      .pro-ex-card {
        background: #fff !important;
        border: 1px solid #bbb !important;
        border-radius: 6px !important;
        padding: 12px !important;
        margin-bottom: 14px !important;
        page-break-inside: avoid !important;
      }
      .ex-title-text {
        color: #000 !important;
        font-size: 1.1rem !important;
      }
      .ex-target-pill {
        background: #eee !important;
        color: #333 !important;
        border: 1px solid #ccc !important;
      }
      .ex-target-badge {
        background: #f0f0f0 !important;
        color: #000 !important;
        border: 1px solid #333 !important;
        font-weight: bold !important;
      }
      .ex-visual-grid {
        display: block !important;
        margin-bottom: 8px !important;
      }
      .ex-cues-panel {
        background: #f8f9fa !important;
        border-left: 3px solid #000 !important;
        color: #222 !important;
        padding: 8px 10px !important;
        font-size: 0.82rem !important;
      }
      .ex-cues-panel strong {
        color: #000 !important;
      }
      .set-logging-table {
        width: 100% !important;
        border: 1px solid #ccc !important;
        background: #fff !important;
        margin-top: 8px !important;
      }
      .set-logging-table th {
        background: #eee !important;
        color: #000 !important;
        border: 1px solid #ccc !important;
        padding: 6px 10px !important;
      }
      .set-logging-table td {
        border: 1px solid #ccc !important;
        color: #000 !important;
        padding: 6px 10px !important;
      }
      .log-input {
        border: 1px solid #999 !important;
        background: #fff !important;
        color: #000 !important;
        width: 70px !important;
      }
      .log-input.log-input-reps {
        width: 92px !important;
      }
      .print-page-header {
        display: block !important;
        border-bottom: 2px solid #000;
        padding-bottom: 8px;
        margin-bottom: 12px;
      }
      .print-tick-box {
        display: inline-block;
        width: 12px;
        height: 12px;
        border: 1.5px solid #000;
        margin-right: 6px;
        vertical-align: middle;
      }
      .print-water-row {
        display: flex !important;
        gap: 8px;
        margin: 10px 0;
      }
      .print-water-box {
        width: 24px;
        height: 24px;
        border: 1px solid #000;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
      }
    }

    /* ==========================================
       PRO UPGRADE: COMMERCIAL SELLABLE STYLES
       ========================================== */
    .btn-live-session {
      background: linear-gradient(135deg, #10b981, #059669);
      color: #fff;
      font-weight: 800;
      font-size: 0.92rem;
      border: none;
      padding: 10px 20px;
      border-radius: var(--radius-md);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
      transition: all 0.25s ease;
      letter-spacing: 0.3px;
    }
    .btn-live-session:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 28px rgba(16, 185, 129, 0.6);
      background: linear-gradient(135deg, #34d399, #10b981);
    }

    .hud-timer-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 12px 18px;
      margin-bottom: 18px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .hud-clock {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--cyan);
      letter-spacing: 1px;
    }
    .hud-cals {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--amber);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .hud-exercise-active {
      background: var(--bg-card);
      border: 1px solid var(--border-focus);
      border-radius: var(--radius-lg);
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: 0 0 25px rgba(56, 189, 248, 0.12);
    }
    .hud-tempo-bar {
      height: 8px;
      background: rgba(255,255,255,0.08);
      border-radius: 99px;
      overflow: hidden;
      margin: 12px 0 8px;
      position: relative;
    }
    .hud-tempo-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--cyan), var(--emerald));
      transition: width 0.1s linear;
    }
    .hud-set-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }
    .hud-set-table th {
      font-size: 0.72rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 8px 10px;
      text-align: left;
    }
    .hud-set-table td {
      padding: 8px 10px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    .btn-hud-set {
      background: var(--emerald);
      color: #000;
      font-weight: 800;
      border: none;
      padding: 7px 14px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.78rem;
      transition: all 0.2s;
    }
    .btn-hud-set:hover {
      background: #34d399;
      transform: scale(1.02);
    }
    .btn-hud-set.completed {
      background: rgba(16, 185, 129, 0.2);
      color: #a7f3d0;
      cursor: default;
    }

    /* 1RM Strength Intelligence */
    .strength-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
      margin-top: 16px;
    }
    .strength-card {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(99, 133, 180, 0.3);
      border-radius: var(--radius-md);
      padding: 20px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
      transition: all 0.25s ease;
    }
    .strength-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--emerald));
    }
    .strength-card:hover {
      border-color: rgba(0, 242, 254, 0.5);
      box-shadow: 0 12px 30px rgba(0, 242, 254, 0.2);
      transform: translateY(-2px);
    }
    .strength-tier-meter {
      height: 8px;
      background: rgba(255,255,255,0.07);
      border-radius: 99px;
      margin: 12px 0 6px;
      overflow: hidden;
      position: relative;
    }
    .strength-tier-fill {
      height: 100%;
      background: linear-gradient(90deg, #38bdf8, #10b981, #f59e0b, #a855f7);
      border-radius: 99px;
      transition: width 0.6s ease;
    }
    .tier-badge-pill {
      font-size: 0.72rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .tier-novice { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
    .tier-intermediate { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .tier-advanced { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .tier-elite { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }

    /* Smart Grocery Checklist */
    .grocery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
      margin-top: 14px;
    }
    .grocery-cat-card {
      background: linear-gradient(145deg, rgba(26, 40, 74, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(56, 189, 248, 0.28);
      border-radius: var(--radius-md);
      padding: 18px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
      transition: all 0.25s ease;
    }
    .grocery-cat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald), var(--cyan));
    }
    .grocery-cat-card:hover {
      border-color: rgba(16, 185, 129, 0.5);
      box-shadow: 0 12px 30px rgba(16, 185, 129, 0.2);
      transform: translateY(-2px);
    }
    .grocery-cat-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--cyan);
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding-bottom: 8px;
    }
    .grocery-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 7px 0;
      font-size: 0.84rem;
      border-bottom: 1px solid rgba(255,255,255,0.03);
    }
    .grocery-item-row.checked span {
      text-decoration: line-through;
      color: var(--text-dim);
    }

    /* ==========================================
       MILESTONE GAMIFICATION & LEVEL PROGRESSION
       ========================================== */
    .user-level-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, rgba(28, 42, 75, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      border: 1.5px solid rgba(0, 242, 254, 0.4);
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 0 15px rgba(0, 242, 254, 0.15);
    }
    .user-level-pill:hover {
      border-color: var(--cyan);
      box-shadow: 0 0 22px rgba(0, 242, 254, 0.35);
      transform: translateY(-1px);
    }
    .lvl-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      font-weight: 800;
      color: #000;
      background: linear-gradient(135deg, var(--cyan), #38bdf8);
      padding: 3px 8px;
      border-radius: 6px;
      letter-spacing: 0.5px;
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
    }
    .lvl-progress-wrap {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 110px;
    }
    .lvl-info {
      font-size: 0.72rem;
      font-weight: 700;
      color: #cbd5e1;
      display: flex;
      justify-content: space-between;
    }
    .lvl-bar {
      height: 5px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 99px;
      overflow: hidden;
    }
    .lvl-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--cyan), var(--emerald));
      border-radius: 99px;
      transition: width 0.5s ease;
    }

    /* ACTIVE MILESTONE QUEST BANNER */
    .milestone-quest-banner {
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.14) 0%, rgba(0, 242, 254, 0.12) 50%, rgba(16, 185, 129, 0.1) 100%);
      border: 1.5px solid rgba(168, 85, 247, 0.35);
      border-radius: var(--radius-md);
      padding: 14px 20px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3), inset 0 0 20px rgba(168, 85, 247, 0.08);
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: all 0.25s ease;
    }
    .milestone-quest-banner:hover {
      border-color: rgba(168, 85, 247, 0.6);
      box-shadow: 0 10px 35px rgba(168, 85, 247, 0.25);
      transform: translateY(-1px);
    }
    .milestone-quest-banner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, #c084fc, #00f2fe, #10b981);
    }
    .quest-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .quest-badge-icon {
      font-size: 2rem;
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.25), rgba(0, 242, 254, 0.15));
      border: 1.5px solid rgba(168, 85, 247, 0.4);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
    }
    .quest-title-wrap h4 {
      font-size: 1rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .quest-title-wrap p {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .quest-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      min-width: 200px;
    }
    .quest-progress-track {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 99px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .quest-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--purple), var(--cyan));
      border-radius: 99px;
      transition: width 0.6s ease;
    }

    /* MILESTONES HUB VIEW STYLES */
    .milestone-hub-hero {
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.18) 0%, rgba(0, 242, 254, 0.12) 50%, rgba(251, 191, 36, 0.1) 100%);
      border: 1px solid rgba(168, 85, 247, 0.35);
      border-radius: var(--radius-xl);
      padding: 30px;
      margin-bottom: 24px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }
    .milestone-rank-circle {
      width: 105px;
      height: 105px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(192, 132, 252, 0.2), rgba(0, 242, 254, 0.2));
      border: 3px solid var(--purple);
      box-shadow: 0 0 30px rgba(192, 132, 252, 0.45), inset 0 0 20px rgba(0, 242, 254, 0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .milestone-filters {
      display: flex;
      gap: 10px;
      margin: 20px 0;
      flex-wrap: wrap;
    }
    .milestone-filter-btn {
      background: linear-gradient(135deg, rgba(26, 40, 74, 0.85) 0%, rgba(16, 25, 48, 0.85) 100%);
      border: 1px solid rgba(99, 133, 180, 0.3);
      color: #94a3b8;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .milestone-filter-btn:hover {
      color: #fff;
      border-color: var(--cyan);
    }
    .milestone-filter-btn.active {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.25) 0%, rgba(168, 85, 247, 0.25) 100%);
      border-color: var(--cyan);
      color: #fff;
      box-shadow: 0 0 18px rgba(0, 242, 254, 0.35);
    }
    .milestone-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 18px;
      margin-bottom: 30px;
    }
    .milestone-holo-card {
      background: linear-gradient(145deg, rgba(24, 38, 70, 0.85) 0%, rgba(15, 24, 46, 0.85) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1.5px solid rgba(99, 133, 180, 0.25);
      border-radius: var(--radius-md);
      padding: 20px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
    }
    .milestone-holo-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #64748b, #475569);
    }
    .milestone-holo-card.unlocked {
      border-color: rgba(251, 191, 36, 0.5);
      box-shadow: 0 10px 30px rgba(251, 191, 36, 0.15), 0 0 20px rgba(251, 191, 36, 0.08);
    }
    .milestone-holo-card.unlocked::before {
      background: linear-gradient(90deg, var(--amber), var(--emerald));
    }
    .milestone-holo-card.unlocked .holo-icon-wrap {
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(16, 185, 129, 0.2));
      border-color: var(--amber);
      box-shadow: 0 0 20px rgba(251, 191, 36, 0.35);
    }
    .milestone-holo-card:hover {
      transform: translateY(-3px);
      border-color: var(--cyan);
      box-shadow: 0 14px 35px rgba(0, 242, 254, 0.25);
    }
    .holo-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }
    .holo-icon-wrap {
      font-size: 2.2rem;
      width: 58px;
      height: 58px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.04);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.25s ease;
    }
    .rarity-pill {
      font-size: 0.68rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .rarity-common { background: rgba(148, 163, 184, 0.15); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.3); }
    .rarity-rare { background: rgba(56, 189, 248, 0.15); color: var(--cyan); border: 1px solid rgba(56, 189, 248, 0.3); }
    .rarity-epic { background: rgba(192, 132, 252, 0.18); color: var(--purple); border: 1px solid rgba(192, 132, 252, 0.35); }
    .rarity-legendary { background: rgba(251, 191, 36, 0.18); color: var(--amber); border: 1px solid rgba(251, 191, 36, 0.35); }
    .rarity-mythic { background: linear-gradient(135deg, rgba(255, 51, 102, 0.25), rgba(168, 85, 247, 0.25)); color: #fda4af; border: 1px solid rgba(255, 51, 102, 0.4); }

    /* ==========================================
       POST-WORKOUT PHOTO LOG & GALLERY
       ========================================== */
    .photo-dock {
      background: linear-gradient(145deg, rgba(20, 31, 58, 0.85) 0%, rgba(13, 21, 40, 0.85) 100%);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: var(--radius-md);
      padding: 16px 20px;
      margin-bottom: 20px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
    }
    .photo-dock-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .photo-thumb-mini {
      width: 52px;
      height: 52px;
      border-radius: 8px;
      object-fit: cover;
      border: 1.5px solid var(--cyan);
      box-shadow: 0 0 12px rgba(0, 242, 254, 0.35);
      cursor: pointer;
    }
    .btn-photo-action {
      background: linear-gradient(135deg, rgba(38, 58, 102, 0.9) 0%, rgba(28, 42, 75, 0.9) 100%);
      border: 1px solid rgba(56, 189, 248, 0.35);
      color: #fff;
      font-weight: 700;
      font-size: 0.82rem;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .btn-photo-action:hover {
      border-color: var(--cyan);
      box-shadow: 0 0 16px rgba(0, 242, 254, 0.3);
      transform: translateY(-1px);
    }
    .photo-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
      margin-top: 16px;
    }
    .photo-gallery-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      overflow: hidden;
      position: relative;
      transition: all 0.25s ease;
      box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }
    .photo-gallery-card:hover {
      transform: translateY(-2px);
      border-color: var(--cyan);
      box-shadow: 0 12px 30px rgba(0, 242, 254, 0.25);
    }
    .photo-gallery-img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
      cursor: pointer;
    }
    .photo-card-info {
      padding: 10px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(14, 21, 38, 0.92);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    /* BEFORE & AFTER SPLIT COMPARISON SLIDER */
    .ba-slider-container {
      position: relative;
      width: 100%;
      max-width: 600px;
      height: 380px;
      margin: 20px auto;
      overflow: hidden;
      border-radius: var(--radius-lg);
      border: 2px solid var(--cyan);
      box-shadow: 0 0 35px rgba(0, 242, 254, 0.25);
      user-select: none;
    }
    .ba-img-before, .ba-img-after {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .ba-before-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 50%;
      height: 100%;
      overflow: hidden;
      z-index: 2;
      border-right: 2px solid #fff;
    }
    .ba-slider-bar {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 4px;
      background: #fff;
      z-index: 10;
      cursor: ew-resize;
      box-shadow: 0 0 15px rgba(0,0,0,0.8);
    }
    .ba-slider-knob {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--cyan);
      color: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.9rem;
      box-shadow: 0 0 15px rgba(0, 242, 254, 0.7);
    }

    /* ==========================================
       INLINE EXERCISE VIDEO PLAYER
       ========================================== */
    .ex-video-dock {
      margin-top: 12px;
    }
    .btn-inline-video {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%);
      border: 1px solid rgba(239, 68, 68, 0.35);
      color: #fda4af;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: 6px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .btn-inline-video:hover {
      background: rgba(239, 68, 68, 0.25);
      border-color: #f43f5e;
      color: #fff;
      box-shadow: 0 0 16px rgba(244, 63, 94, 0.35);
    }
    .inline-video-wrap {
      position: relative;
      margin-top: 12px;
      margin-bottom: 12px;
      border-radius: var(--radius-md);
    }
    .inline-player-box {
      background: rgba(10, 16, 30, 0.96);
      border: 1.5px solid rgba(0, 242, 254, 0.45);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.65), 0 0 25px rgba(0, 242, 254, 0.2);
      animation: fadeInVideo 0.25s ease-out;
    }
    @keyframes fadeInVideo {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .inline-player-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 9px 14px;
      background: rgba(15, 23, 42, 0.95);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      gap: 10px;
      flex-wrap: wrap;
    }
    .inline-player-title {
      font-size: 0.82rem;
      color: #cbd5e1;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 62%;
    }
    .inline-player-title strong {
      color: #fff;
      font-weight: 800;
    }
    .inline-player-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .btn-player-link {
      background: rgba(244, 63, 94, 0.16);
      color: #fda4af;
      border: 1px solid rgba(244, 63, 94, 0.35);
      padding: 4px 10px;
      border-radius: 5px;
      font-size: 0.74rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      transition: all 0.2s;
    }
    .btn-player-link:hover {
      background: rgba(244, 63, 94, 0.38);
      color: #fff;
      border-color: rgba(244, 63, 94, 0.7);
    }
    .btn-player-close {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.25);
      padding: 4px 10px;
      border-radius: 5px;
      font-size: 0.74rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-player-close:hover {
      background: rgba(244, 63, 94, 0.85);
      border-color: rgba(244, 63, 94, 1);
    }
    .inline-player-viewport {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
      height: 0;
      background: #000;
      overflow: hidden;
    }
    .inline-player-viewport iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
    .inline-player-footer {
      padding: 7px 14px;
      font-size: 0.74rem;
      color: #94a3b8;
      background: rgba(15, 23, 42, 0.85);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      text-align: center;
    }
    /* Legacy fallback */
    .inline-video-wrap > iframe {
      width: 100%;
      border-radius: var(--radius-md);
    }
    .btn-close-video {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(0, 0, 0, 0.75);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 4px;
      padding: 4px 10px;
      font-size: 0.75rem;
      font-weight: 800;
      cursor: pointer;
      z-index: 10;
    }
    /* ==========================================
       ZERO-SCROLL COMMAND CENTER & COCKPIT HUD
       ========================================== */
    .mission-checklist-card {
      background: linear-gradient(135deg, rgba(20, 31, 58, 0.95) 0%, rgba(13, 21, 40, 0.95) 100%);
      border: 1.5px solid rgba(0, 242, 254, 0.35);
      border-radius: var(--radius-md);
      padding: 14px 18px;
      margin-bottom: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), inset 0 0 15px rgba(0, 242, 254, 0.08);
    }
    .mission-checklist-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 8px;
    }
    .mission-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
      letter-spacing: 0.3px;
    }
    .mission-chips-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px;
    }
    .mission-chip {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.2s ease;
    }
    .mission-chip:hover {
      background: rgba(0, 242, 254, 0.1);
      border-color: var(--cyan);
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2);
    }
    .mission-chip.done {
      background: rgba(16, 185, 129, 0.12);
      border-color: rgba(16, 185, 129, 0.4);
    }
    .mission-chip.done .chip-status {
      color: var(--emerald);
      font-weight: 800;
    }
    .chip-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .chip-icon {
      font-size: 1.25rem;
    }
    .chip-label {
      font-size: 0.8rem;
      font-weight: 700;
      color: #fff;
      display: block;
    }
    .chip-status {
      font-size: 0.72rem;
      color: var(--amber);
      font-weight: 700;
    }

    /* STEP-BY-STEP STAGE NAVIGATOR */
    .stage-nav-strip {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      flex-wrap: wrap;
      background: rgba(11, 17, 32, 0.85);
      padding: 6px;
      border-radius: var(--radius-md);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .stage-nav-btn {
      flex: 1;
      min-width: 140px;
      background: transparent;
      border: 1px solid transparent;
      color: #94a3b8;
      padding: 9px 12px;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .stage-nav-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
    }
    .stage-nav-btn.active {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.2) 0%, rgba(168, 85, 247, 0.2) 100%);
      border-color: var(--cyan);
      color: #fff;
      box-shadow: 0 0 16px rgba(0, 242, 254, 0.3);
    }

    /* COMPACT MONTHLY CONSISTENCY MATRIX (ZERO HORIZONTAL SCROLL) */
    .month-selector-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
      gap: 8px;
    }
    .month-nav-btn {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
      padding: 5px 12px;
      border-radius: 4px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .month-nav-btn:hover {
      border-color: var(--cyan);
      color: var(--cyan);
    }
    .month-grid-responsive {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 6px;
    }
    @media (max-width: 640px) {
      .month-grid-responsive {
        grid-template-columns: repeat(6, 1fr);
      }
      .set-logging-table th, .set-logging-table td {
        padding: 6px 6px;
        font-size: 0.78rem;
      }
      .log-input.log-input-reps {
        width: 88px;
        min-width: 82px;
        font-size: 0.82rem;
        padding: 4px 4px;
      }
      .log-input.log-input-wt {
        width: 68px;
        min-width: 62px;
        font-size: 0.82rem;
        padding: 4px 4px;
      }
      .ex-crop-viewport {
        max-width: 280px;
        margin: 0 auto 10px auto;
      }
    }
    .m-day-cell {
      aspect-ratio: 1 / 1;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
      font-size: 0.78rem;
      font-weight: 700;
      color: #94a3b8;
      position: relative;
    }
    .m-day-cell:hover {
      transform: scale(1.08);
      border-color: var(--cyan);
      color: #fff;
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
      z-index: 2;
    }
    .m-day-cell.active-day {
      border: 2px solid var(--amber) !important;
      box-shadow: 0 0 14px rgba(251, 191, 36, 0.6);
      color: #fff;
    }
    .m-day-cell.done {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.35), rgba(16, 185, 129, 0.35));
      border-color: var(--emerald);
      color: #fff;
    }
    .m-day-cell.alert {
      border-color: var(--amber);
      background: rgba(251, 191, 36, 0.15);
    }
    .m-day-cell.rec {
      border-color: var(--cyan);
      background: rgba(56, 189, 248, 0.12);
    }

    /* TABBED SIDEBAR COCKPIT */
    .cockpit-tabs-header {
      display: flex;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(11, 17, 32, 0.9);
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      overflow: hidden;
    }
    .cockpit-tab-item {
      flex: 1;
      padding: 9px 8px;
      text-align: center;
      font-size: 0.75rem;
      font-weight: 700;
      color: #94a3b8;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      border-bottom: 2px solid transparent;
    }
    .cockpit-tab-item:hover {
      color: #fff;
    }
    .cockpit-tab-item.active {
      color: var(--cyan);
      border-bottom-color: var(--cyan);
      background: rgba(0, 242, 254, 0.08);
    }

    /* FLOATING BOTTOM QUICK ACTION DOCK */
    .floating-quick-dock {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(14, 21, 38, 0.9);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1.5px solid rgba(0, 242, 254, 0.4);
      border-radius: 99px;
      padding: 6px 14px;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 242, 254, 0.25);
      z-index: 1000;
      transition: all 0.25s ease;
    }
    .floating-dock-btn {
      background: transparent;
      border: none;
      color: #fff;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 99px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .floating-dock-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      transform: translateY(-1px);
    }
    .floating-dock-btn.primary {
      background: linear-gradient(135deg, var(--emerald), #059669);
      color: #000;
      font-weight: 800;
      box-shadow: 0 0 14px rgba(16, 185, 129, 0.4);
    }
  </style>
</head>
<body>

  <!-- TOP PROFESSIONAL HEADER -->
  <header class="top-header">
    <div class="container header-inner">
      <div class="brand-wrap">
        <div class="brand-logo" aria-label="ZENITH 365 Emblem" title="ZENITH 365: Precision Home Gym & Longevity OS">
          <svg width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="zenithGrad1" x1="4" y1="3" x2="28" y2="29" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00f2fe"/>
                <stop offset="50%" stop-color="#38bdf8"/>
                <stop offset="100%" stop-color="#a855f7"/>
              </linearGradient>
              <linearGradient id="zenithFacetL" x1="4" y1="12" x2="16" y2="29" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.32"/>
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.08"/>
              </linearGradient>
              <linearGradient id="zenithFacetR" x1="28" y1="12" x2="16" y2="29" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#a855f7" stop-opacity="0.32"/>
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.08"/>
              </linearGradient>
              <filter id="zenithGlow" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="1.2" result="blur"/>
                <feComposite in="SourceGraphic" in2="blur" operator="over"/>
              </filter>
            </defs>
            <!-- Left & Right Prism Facets -->
            <polygon points="16,3 4,12 16,29" fill="url(#zenithFacetL)"/>
            <polygon points="16,3 28,12 16,29" fill="url(#zenithFacetR)"/>
            <!-- Outer Geometric Prism Outline -->
            <path d="M16 3L28 12L16 29L4 12Z" stroke="url(#zenithGrad1)" stroke-width="1.8" stroke-linejoin="round"/>
            <!-- Inner Facet Spine & Dynamic Cross Axis -->
            <line x1="16" y1="3" x2="16" y2="29" stroke="url(#zenithGrad1)" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="4" y1="12" x2="28" y2="12" stroke="url(#zenithGrad1)" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="1.5 1.5"/>
            <!-- Radiant Apex Star Core -->
            <polygon points="16,1.5 17.5,4.5 20.5,6 17.5,7.5 16,10.5 14.5,7.5 11.5,6 14.5,4.5" fill="#ffffff" filter="url(#zenithGlow)"/>
          </svg>
        </div>
        <div class="brand-text">
          <h1>ZENITH <span class="brand-accent">365</span></h1>
          <span>Precision Home Gym &amp; Longevity OS</span>
        </div>
      </div>

      <div class="header-actions">
        <!-- Live Level & XP Progress Pill -->
        <div class="user-level-pill" onclick="switchView('milestonesView')" title="Trainee Level & Experience. Click to open Milestones Hub.">
          <span class="lvl-badge" id="headerLvlBadge">LVL 1</span>
          <div class="lvl-progress-wrap">
            <div class="lvl-info"><span id="headerLvlTitle">Initiate</span> <span id="headerXpVal">0 / 250 XP</span></div>
            <div class="lvl-bar"><div class="lvl-fill" id="headerXpFill" style="width: 0%;"></div></div>
          </div>
        </div>

        <!-- Live Gym Beats Music Cockpit -->
        <div class="header-music-pill" id="headerMusicPill" onclick="openModal('musicModal')" title="Open Workout Beats & Sound Lab">
          <div class="audio-eq-bars" id="musicEqBars">
            <span class="audio-bar"></span>
            <span class="audio-bar"></span>
            <span class="audio-bar"></span>
            <span class="audio-bar"></span>
          </div>
          <div class="music-pill-info">
            <span class="music-pill-title" id="musicPillTitle">⚡ Cyber Pump (128 BPM)</span>
            <span class="music-pill-status" id="musicPillStatus">Workout Beats</span>
          </div>
          <button class="btn-music-mini-toggle" onclick="event.stopPropagation(); GymMusic.togglePlay();" id="btnMusicMiniToggle" title="Play/Pause Beats">
            ▶
          </button>
        </div>

        <button class="nav-pill-btn" onclick="openModal('musicModal')" style="border-color: rgba(0, 242, 254, 0.35); color: var(--cyan);" title="Soundtracks, genres & tempo controls">
          🎵 Beats Studio
        </button>

        <!-- Preserved DOM IDs for JS backward compatibility -->
        <span id="unlockedBadgesCount" style="display:none;">0/28</span>
        <span id="loggedPhotosCount" style="display:none;">0</span>
        <button class="nav-pill-btn" onclick="openModal('calendarModal')">
          📅 365 Calendar
        </button>
        <button class="nav-pill-btn" onclick="openModal('metricsModal')">
          ⚖️ Weight & Body Log
        </button>
        <button class="nav-pill-btn" onclick="printWorkoutSheet()" title="Print pristine A4 daily workout sheet">
          🖨️ Print Sheet
        </button>
        <button class="nav-pill-btn" onclick="openModal('voiceModal')" title="Configure Audio Coach voice & rate">
          🔊 Voice Coach
        </button>
        <button class="nav-pill-btn" onclick="toggleFullscreen()" title="Kiosk Mode">
          ⛶ Kiosk
        </button>
        <button class="nav-pill-btn" onclick="exportDataJSON()" title="Export your workout data">
          💾 Backup
        </button>
        <button class="nav-pill-btn" onclick="triggerImportJSON()" title="Restore workout data from backup file">
          📂 Import
        </button>
        <input type="file" id="importFileInput" accept=".json" style="display:none" onchange="handleFileImport(event)">
      </div>
    </div>
  </header>

  <!-- VIEW SWITCHER TABS -->
  <nav class="container">
    <div class="view-switcher-bar">
      <button class="view-tab-btn active" onclick="switchView('workoutView')">
        🏋️ Today's Workout Engine
      </button>
      <button class="view-tab-btn" onclick="switchView('milestonesView')">
        🏆 Milestones & Level Hub
      </button>
      <button class="view-tab-btn" onclick="switchView('photosView')">
        📸 Workout Photos & Transformation
      </button>
      <button class="view-tab-btn" onclick="switchView('analyticsView')">
        📊 Strength Standards & 1RM
      </button>
      <button class="view-tab-btn" onclick="switchView('nutritionView')">
        🥗 Nutrition & Smart Grocery
      </button>
      <button class="view-tab-btn" onclick="switchView('roadmapView')">
        🗺️ 12-Month Master Roadmap
      </button>
      <button class="view-tab-btn" onclick="switchView('essentialsView')">
        🎒 Gym Essentials & Rules
      </button>
    </div>
  </nav>

  <!-- ==========================================
       VIEW 1: TODAY'S WORKOUT ENGINE
       ========================================== -->
  <div id="workoutView" class="app-view active">
    
    <!-- HUD METRICS -->
    <section class="container">
      <div class="hero-dashboard">
        <div class="hud-card">
          <div class="hud-title">Year Progress <span id="pctCompleted">0.0%</span></div>
          <div class="hud-val" id="statCompleted">0 / 365</div>
          <div class="hud-sub">Days Logged</div>
        </div>
        <div class="hud-card">
          <div class="hud-title">Current Habit Streak</div>
          <div class="hud-val" id="statStreak">0 Days</div>
          <div class="hud-sub" id="streakSub">Start with Day 1</div>
        </div>
        <div class="hud-card">
          <div class="hud-title">Current Training Level</div>
          <div class="hud-val" id="statPhase" style="font-size: 1.3rem;">Phase 1</div>
          <div class="hud-sub" id="statPhaseDesc">Neural & Joint Foundation</div>
        </div>
        <div class="hud-card">
          <div class="hud-title">Equipment Status</div>
          <div class="hud-val" id="statEquip" style="font-size: 1.25rem;">Zero Gear ($0)</div>
          <div class="hud-sub" id="statEquipSub">Living room bodyweight</div>
        </div>
      </div>
    </section>

    <!-- 365-DAY CONSISTENCY MATRIX -->
    <section class="container">
      <div class="consistency-heatmap-card">
        <div class="heatmap-header">
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <span style="font-weight: 800; font-size: 0.92rem; color: #fff;">📊 365-Day Consistency Matrix</span>
            <span style="font-size: 0.75rem; color: var(--emerald); font-weight: 700;" id="heatmapStreakSummary">0 / 365 Days Logged</span>
          </div>
          <div class="heatmap-legend">
            <span class="legend-item"><span class="legend-dot dot-done"></span> Done</span>
            <span class="legend-item"><span class="legend-dot dot-rec"></span> Recovery</span>
            <span class="legend-item"><span class="legend-dot dot-alert"></span> Upgrade Radar</span>
            <span class="legend-item"><span class="legend-dot dot-future"></span> Pending</span>
          </div>
        </div>

        <div class="heatmap-scroll-area" id="heatmapScrollArea">
          <div class="heatmap-months-row">
            <span>M1</span><span>M2</span><span>M3</span><span>M4</span><span>M5</span><span>M6</span><span>M7</span><span>M8</span><span>M9</span><span>M10</span><span>M11</span><span>M12</span>
          </div>
          <div class="heatmap-grid-52" id="heatmapGrid52">
            <!-- 365 cells rendered by JS -->
          </div>
        </div>
      </div>
    </section>

    <!-- ACTIVE MILESTONE QUEST BANNER -->
    <section class="container">
      <div class="milestone-quest-banner" onclick="switchView('milestonesView')" title="Click to view all Milestones & Tiers" style="cursor: pointer;">
        <div class="quest-left">
          <div class="quest-icon" id="questIcon">🔥</div>
          <div class="quest-title-wrap">
            <h4><span id="questTitle">Active Milestone Quest</span> <span class="rarity-pill rarity-rare" id="questRarity">Rare</span></h4>
            <p id="questDesc">Loading milestone target...</p>
          </div>
        </div>
        <div class="quest-right">
          <div style="display: flex; justify-content: space-between; width: 100%; font-size: 0.78rem; font-weight: 700;">
            <span style="color: var(--cyan);" id="questProgressText">0 / 7 Days</span>
            <span style="color: var(--amber);" id="questXpReward">+150 XP</span>
          </div>
          <div class="quest-progress-track">
            <div class="quest-progress-bar" id="questProgressBar" style="width: 0%;"></div>
          </div>
          <button class="nav-pill-btn" onclick="event.stopPropagation(); switchView('milestonesView')" style="margin-top: 4px; padding: 4px 10px; font-size: 0.75rem; border-color: rgba(168,85,247,0.4); color: var(--purple);">
            View 28 Milestones Hub ↗
          </button>
        </div>
      </div>
    </section>

    <!-- DAILY READINESS AUTOREGULATION & WATER DOCK -->
    <section class="container">
      <div class="readiness-strip">
        <div class="readiness-title">
          <span>⚡ Daily Energy & Autoregulation:</span>
          <div class="readiness-btns">
            <button class="btn-energy" id="btnEnergyHigh" onclick="setReadiness('high')">⚡ High (100%)</button>
            <button class="btn-energy active-norm" id="btnEnergyNorm" onclick="setReadiness('norm')">🔋 Normal (80%)</button>
            <button class="btn-energy" id="btnEnergyLow" onclick="setReadiness('low')">😴 Sore/Low (Autoscale)</button>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 0.8rem; color: var(--cyan); font-weight: 700;">💧 Water (3.2L Target):</span>
          <div class="water-row" id="waterTrackerRow">
            <!-- 8 Water Glasses (400ml each) rendered by JS -->
          </div>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE DAY CONTROLLER DOCK -->
    <section class="container">
      <div class="day-dock">
        <div class="day-nav-controls">
          <button class="btn-nav-day" onclick="changeDay(-1)">◀ Prev</button>
          <div class="day-display-box">
            <span>DAY</span>
            <input type="number" id="dayInput" min="1" max="365" value="1" onchange="onDayInputChange(this.value)">
            <span style="color: var(--text-dim); font-size: 0.8rem;">/ 365</span>
          </div>
          <button class="btn-nav-day" onclick="changeDay(1)">Next ▶</button>
        </div>

        <div class="slider-track">
          <input type="range" id="daySlider" min="1" max="365" value="1" oninput="onSliderChange(this.value)">
        </div>

        <div class="day-dock-actions">
          <button class="btn-live-session" onclick="startLiveWorkoutSession()" title="Enter distraction-free active workout session player with rep tempo metronome and auto-rest timer">
            ▶ Live Session HUD
          </button>
          <label style="font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px; cursor: pointer;">
            <input type="checkbox" id="voiceCoachToggle" checked> 🔊 Audio Coach
          </label>
          <button class="btn-complete-day" id="btnMarkDay" onclick="toggleCurrentDayCompletion()">
            <span id="markIcon">✓</span> <span id="markText">Complete Day</span>
          </button>
        </div>
      </div>
    </section>

    <!-- TODAY'S MISSION CHECKLIST HUD (Zero-Scroll Feature Hub) -->
    <section class="container">
      <div class="mission-checklist-card">
        <div class="mission-checklist-header">
          <div class="mission-title">
            <span>⚡ TODAY'S TRAINING MISSION CHECKLIST</span>
            <span style="font-size: 0.72rem; color: var(--cyan); background: rgba(0,242,254,0.12); border: 1px solid rgba(0,242,254,0.3); padding: 2px 8px; border-radius: 99px; font-weight: 800;" id="missionDayBadge">DAY 1</span>
          </div>
          <span style="font-size: 0.75rem; color: var(--text-dim);">Tap any pillar below to jump directly to it — never miss an action!</span>
        </div>
        <div class="mission-chips-grid">
          <div class="mission-chip" id="chipWarmup" onclick="scrollToWorkoutSection('warmupBox')">
            <div class="chip-left">
              <span class="chip-icon">🔥</span>
              <div>
                <span class="chip-label">Joint Warm-Up</span>
                <span class="chip-status" id="chipWarmupStatus">5 Mins Ready</span>
              </div>
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">▼</span>
          </div>

          <div class="mission-chip" id="chipWorkout" onclick="scrollToWorkoutSection('workoutHeader')">
            <div class="chip-left">
              <span class="chip-icon">🏋️</span>
              <div>
                <span class="chip-label">Main Exercises</span>
                <span class="chip-status" id="chipWorkoutStatus">0 Sets Logged</span>
              </div>
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">▼</span>
          </div>

          <div class="mission-chip" id="chipPhoto" onclick="scrollToWorkoutSection('dayPhotoDock')">
            <div class="chip-left">
              <span class="chip-icon">📸</span>
              <div>
                <span class="chip-label">Day Photo Studio</span>
                <span class="chip-status" id="chipPhotoStatus">Pending (+75 XP)</span>
              </div>
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">▼</span>
          </div>

          <div class="mission-chip" id="chipCooldown" onclick="scrollToWorkoutSection('cooldownBox')">
            <div class="chip-left">
              <span class="chip-icon">🧊</span>
              <div>
                <span class="chip-label">Joint Cool-Down</span>
                <span class="chip-status" id="chipCooldownStatus">5 Mins Mobility</span>
              </div>
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">▼</span>
          </div>

          <div class="mission-chip" id="chipWater" onclick="scrollToWaterTracker()">
            <div class="chip-left">
              <span class="chip-icon">💧</span>
              <div>
                <span class="chip-label">Hydration Target</span>
                <span class="chip-status" id="chipWaterStatus">0 / 8 Glasses</span>
              </div>
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">💧</span>
          </div>

          <div class="mission-chip" id="chipQuest" onclick="switchView('milestonesView')">
            <div class="chip-left">
              <span class="chip-icon">🏆</span>
              <div>
                <span class="chip-label">Active Quest</span>
                <span class="chip-status" id="chipQuestStatus">Next Trophy</span>
              </div>
            </div>
            <span style="font-size: 0.8rem; color: var(--text-dim);">↗</span>
          </div>
        </div>
      </div>
    </section>

    <!-- MAIN WORKOUT & SIDEBAR LAYOUT -->
    <main class="container">

      <!-- 5-DAY ADVANCE EQUIPMENT RADAR -->
      <div id="equipmentRadar" class="equipment-radar">
        <span class="radar-tag" id="radarDaysLeft">⚠️ 5 DAYS LEFT</span>
        <div class="radar-title" id="radarTitle">Equipment Upgrade Required</div>
        <div class="radar-desc" id="radarDesc">Details...</div>
        <div class="radar-specs" id="radarSpecs">Specs...</div>
        <a href="#" target="_blank" rel="noopener noreferrer" class="radar-btn" id="radarBuyLink">
          🛒 Search & Procure on Amazon ↗
        </a>
      </div>

      <div class="workout-layout">
        
        <!-- Primary Workout Column -->
        <div class="workout-main">
          
          <!-- PRINT PAGE EXCLUSIVE HEADER -->
          <div class="print-page-header" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
              <div>
                <h1 style="font-size: 1.45rem; margin: 0; font-weight: 800;">ZENITH 365 • DAILY WORKOUT LOG</h1>
                <p style="font-size: 0.82rem; color: #555; margin: 2px 0 0;">Precision Home Longevity Training • Biomechanics</p>
              </div>
              <div style="text-align: right; font-size: 0.82rem;">
                <strong>Date:</strong> ________________ &nbsp;|&nbsp; <strong>Weight:</strong> ______ kg
              </div>
            </div>
            <div class="print-water-row">
              <strong>Water Intake (400ml):</strong>
              <span class="print-water-box">1</span>
              <span class="print-water-box">2</span>
              <span class="print-water-box">3</span>
              <span class="print-water-box">4</span>
              <span class="print-water-box">5</span>
              <span class="print-water-box">6</span>
              <span class="print-water-box">7</span>
              <span class="print-water-box">8</span>
              <span style="margin-left: 20px;"><strong>Habits:</strong> [ ] 145g+ Protein &nbsp; [ ] 7.5h Sleep &nbsp; [ ] 10-Min Mobility</span>
            </div>
          </div>

          <!-- SECTION 1: GUIDED JOINT WARM-UP -->
          <div id="stageWrapWarmup" style="margin-bottom: 24px;">
            <div class="warmup-launch-box" id="warmupBox" style="flex-direction: column; align-items: stretch; gap: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                <div style="flex: 1; min-width: 260px;">
                  <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                    <strong style="color: var(--cyan); font-size: 1.05rem;">🔥 5-Minute Guided Joint Lubrication Warm-Up</strong>
                    <span class="pillar-tag pillar-warmup">Joint Integrity & Spine Priming</span>
                  </div>
                  <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0; line-height: 1.4;" id="warmupStatus">
                    Crucial before loading weight. Lubricates synovial fluid, articulates spinal vertebrae, activates dormant glutes, and primes shoulder rotator cuffs.
                  </p>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                  <button class="btn-toggle-guides" type="button" onclick="toggleWarmupGuidesDrawer()" id="btnWarmupGuidesToggle">
                    📖 Step-by-Step Form & Video Guides <span id="warmupGuideChevron">▾</span>
                  </button>
                  <button class="btn-launch-warmup" onclick="startGuidedWarmup()" id="btnWarmupLaunch">
                    ▶ Start Follow-Along Warm-Up
                  </button>
                </div>
              </div>

              <!-- Movement Quick-Jump Chips -->
              <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 10px;">
                <div style="font-size: 0.73rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 6px;">
                  Quick Form Guide & Video Breakdown:
                </div>
                <div class="mobility-chips-row" id="warmupChipsRow">
                  <button type="button" class="mobility-chip" onclick="showWarmupMovementDetail(0)">1. Cat-Cow Spine Waves</button>
                  <button type="button" class="mobility-chip" onclick="showWarmupMovementDetail(1)">2. Bird-Dog Core</button>
                  <button type="button" class="mobility-chip" onclick="showWarmupMovementDetail(2)">3. World's Greatest Stretch</button>
                  <button type="button" class="mobility-chip" onclick="showWarmupMovementDetail(3)">4. Shoulder Dislocates</button>
                  <button type="button" class="mobility-chip" onclick="showWarmupMovementDetail(4)">5. Glute Bridges</button>
                </div>
              </div>
            </div>

            <!-- Follow-Along Active Player HUD -->
            <div id="warmupActivePlayer" class="warmup-player-hud" style="display: none; margin-top: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                  <div class="player-clock-circle" id="warmupClockCircle">
                    <span id="warmupPlayerSec" style="font-size: 1.45rem;">60</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600;">SECONDS</span>
                  </div>
                  <div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 3px;">
                      <span class="pillar-tag pillar-warmup" id="warmupStepBadge">STEP 1 OF 5</span>
                      <span style="font-size: 0.75rem; color: var(--text-muted);" id="warmupPlayerTarget">Entire Spine & Deep Core</span>
                    </div>
                    <div style="font-size: 1.15rem; font-weight: 800; color: #fff;" id="warmupPlayerTitle">Cat-Cow Spine Waves</div>
                  </div>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button type="button" class="btn-photo-action" onclick="toggleWarmupPause()" id="btnWarmupPlayerPause" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                    ⏸ Pause
                  </button>
                  <button type="button" class="btn-photo-action" onclick="skipWarmupStep()" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                    ⏭ Next Movement
                  </button>
                  <button type="button" class="btn-photo-action" onclick="stopGuidedWarmup()" style="background: rgba(244,63,94,0.15); border-color: rgba(244,63,94,0.3); color: #fda4af;">
                    ✕ Close
                  </button>
                </div>
              </div>

              <!-- Breathing Cadence Visualizer -->
              <div class="breathing-cadence-box" style="margin-top: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem;">
                  <strong style="color: var(--amber); display: flex; align-items: center; gap: 6px;">
                    <span id="warmupBreathPhase">🫁 INHALE • EXTENDING SPINAL WAVE</span>
                  </strong>
                  <span style="color: var(--text-muted); font-family: 'JetBrains Mono';" id="warmupBreathSec">4s</span>
                </div>
                <div class="breathing-bar-track">
                  <div class="breathing-bar-fill" id="warmupBreathFill" style="width: 50%;"></div>
                </div>
                <div style="font-size: 0.8rem; color: #cbd5e1; line-height: 1.4;" id="warmupLiveCue">
                  Belly drops slowly, tailbone tilts up, chest beams forward through arms. Do not bend elbows.
                </div>
              </div>
            </div>

            <!-- Technique Guides Drawer (Expandable) -->
            <div id="warmupGuidesDrawer" class="technique-guides-drawer" style="display: none; margin-top: 14px;">
              <!-- Populated by JavaScript with rich breakdown cards -->
            </div>
          </div>

          <!-- SECTION 2: MAIN EXERCISES -->
          <div id="stageWrapWorkout" style="margin-bottom: 24px;">
            <div class="workout-header" id="workoutHeader">
              <div>
                <div class="workout-day-heading">
                  <span id="dayTitlePrefix">Day 1</span>: <span id="workoutTitle">Workout A: Foundation Push & Squat</span>
                </div>
                <div class="workout-meta-line" id="workoutMeta">
                  Month 1 • Week 1 • Duration: 35–40 mins • Joint Priority: High
                </div>
              </div>
              <span class="badge-phase bp-1" id="phaseTag">Phase 1: Body Base</span>
            </div>

            <div class="exercise-cards-flow" id="exerciseCardsFlow">
              <!-- Populated by JavaScript -->
            </div>
          </div>

          <!-- SECTION 3: DAY PHOTO DOCK -->
          <div id="stageWrapPhoto" style="margin-bottom: 20px;">
            <div class="photo-dock" id="dayPhotoDock">
              <div class="photo-dock-left">
                <img id="dayPhotoThumb" class="photo-thumb-mini" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='50' height='50' viewBox='0 0 50 50'><rect width='50' height='50' fill='%23131d36'/><text x='50%25' y='55%25' text-anchor='middle' fill='%2364748b' font-size='20'>📸</text></svg>" alt="Workout photo preview" onclick="openPhotoModal(currentDay)" title="Click to view/upload photo">
                <div>
                  <div style="font-weight: 800; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 8px;">
                    <span>📸 Day <span id="photoDockDay">1</span> Post-Workout Photo</span>
                    <span id="photoDockStatus" style="font-size: 0.72rem; padding: 2px 8px; border-radius: 4px; background: rgba(148,163,184,0.15); color: #94a3b8;">Pending Photo</span>
                  </div>
                  <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 3px;" id="photoDockNote">
                    Snap or upload a post-workout physique/exercise selfie. Stored securely offline in your private browser database.
                  </p>
                </div>
              </div>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <button class="btn-photo-action" onclick="openPhotoModal(currentDay)">
                  📸 Upload / Snap Photo (+75 XP)
                </button>
                <button class="btn-photo-action" onclick="switchView('photosView')" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);">
                  🖼️ Transformation Gallery
                </button>
              </div>
            </div>
          </div>

          <!-- SECTION 4: GUIDED COOLDOWN -->
          <div id="stageWrapCooldown" style="margin-bottom: 24px;">
            <div class="cooldown-launch-box" id="cooldownBox" style="flex-direction: column; align-items: stretch; gap: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                <div style="flex: 1; min-width: 260px;">
                  <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                    <strong style="color: var(--emerald); font-size: 1.05rem;">🧊 5-Minute Guided Post-Workout Cool-Down & Joint Reset</strong>
                    <span class="pillar-tag pillar-cooldown">Parasympathetic Recovery & Decompression</span>
                  </div>
                  <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0; line-height: 1.4;" id="cooldownStatus">
                    Crucial for nervous system downregulation. Flushes metabolic waste, restores hip/shoulder capsule mobility, decompresses lumbar discs, and shifts body into growth mode.
                  </p>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                  <button class="btn-toggle-guides" type="button" onclick="toggleCooldownGuidesDrawer()" id="btnCooldownGuidesToggle">
                    📖 Step-by-Step Form & Video Guides <span id="cooldownGuideChevron">▾</span>
                  </button>
                  <button class="btn-launch-cooldown" onclick="startGuidedCooldown()" id="btnCooldownLaunch">
                    ▶ Start Follow-Along Cool-Down
                  </button>
                </div>
              </div>

              <!-- Movement Quick-Jump Chips -->
              <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 10px;">
                <div style="font-size: 0.73rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 6px;">
                  Quick Form Guide & Video Breakdown:
                </div>
                <div class="mobility-chips-row" id="cooldownChipsRow">
                  <button type="button" class="mobility-chip cooldown-chip" onclick="showCooldownMovementDetail(0)">1. 90/90 Hip Rotations</button>
                  <button type="button" class="mobility-chip cooldown-chip" onclick="showCooldownMovementDetail(1)">2. Child's Pose Lat Reach</button>
                  <button type="button" class="mobility-chip cooldown-chip" onclick="showCooldownMovementDetail(2)">3. Doorframe Chest Opener</button>
                  <button type="button" class="mobility-chip cooldown-chip" onclick="showCooldownMovementDetail(3)">4. Supine Figure-4 Stretch</button>
                  <button type="button" class="mobility-chip cooldown-chip" onclick="showCooldownMovementDetail(4)">5. Diaphragmatic Box Breathing</button>
                </div>
              </div>
            </div>

            <!-- Follow-Along Active Player HUD -->
            <div id="cooldownActivePlayer" class="cooldown-player-hud" style="display: none; margin-top: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                  <div class="player-clock-circle" id="cooldownClockCircle">
                    <span id="cooldownPlayerSec" style="font-size: 1.45rem;">60</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600;">SECONDS</span>
                  </div>
                  <div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 3px;">
                      <span class="pillar-tag pillar-cooldown" id="cooldownStepBadge">STEP 1 OF 5</span>
                      <span style="font-size: 0.75rem; color: var(--text-muted);" id="cooldownPlayerTarget">Hip Rotators & Pelvis</span>
                    </div>
                    <div style="font-size: 1.15rem; font-weight: 800; color: #fff;" id="cooldownPlayerTitle">90/90 Hip Capsule Rotations</div>
                  </div>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button type="button" class="btn-photo-action" onclick="toggleCooldownPause()" id="btnCooldownPlayerPause" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                    ⏸ Pause
                  </button>
                  <button type="button" class="btn-photo-action" onclick="skipCooldownStep()" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                    ⏭ Next Movement
                  </button>
                  <button type="button" class="btn-photo-action" onclick="stopGuidedCooldown()" style="background: rgba(244,63,94,0.15); border-color: rgba(244,63,94,0.3); color: #fda4af;">
                    ✕ Close
                  </button>
                </div>
              </div>

              <!-- Breathing Cadence Visualizer -->
              <div class="breathing-cadence-box" style="margin-top: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem;">
                  <strong style="color: var(--emerald); display: flex; align-items: center; gap: 6px;">
                    <span id="cooldownBreathPhase">🫁 INHALE • EXPAND DIAPHRAGM</span>
                  </strong>
                  <span style="color: var(--text-muted); font-family: 'JetBrains Mono';" id="cooldownBreathSec">4s</span>
                </div>
                <div class="breathing-bar-track">
                  <div class="breathing-bar-fill" id="cooldownBreathFill" style="width: 50%; background: linear-gradient(90deg, var(--emerald), var(--cyan));"></div>
                </div>
                <div style="font-size: 0.8rem; color: #cbd5e1; line-height: 1.4;" id="cooldownLiveCue">
                  Breathe slowly and deeply through your diaphragm. Sink your hips deeper with each relaxed exhale.
                </div>
              </div>
            </div>

            <!-- Technique Guides Drawer (Expandable) -->
            <div id="cooldownGuidesDrawer" class="technique-guides-drawer" style="display: none; margin-top: 14px;">
              <!-- Populated by JavaScript with rich breakdown cards -->
            </div>

            <div style="text-align: right; margin-top: 14px;">
              <button onclick="toggleCurrentDayCompletion()" class="btn-photo-action" style="background: linear-gradient(135deg, var(--emerald), #059669); color: #000; font-weight: 800; font-size: 0.95rem; padding: 10px 22px;">
                ✓ Complete Day Workout
              </button>
            </div>
          </div>

        </div>

        <!-- Sidebar Tools: Dedicated Cockpit Widgets -->
        <aside class="sidebar-pane">
          <!-- Tempo Pacer Widget -->
          <div class="side-widget">
            <div class="widget-head">
              <div class="widget-title">⏱️ Rep Cadence Pacer</div>
              <span style="font-size: 0.72rem; color: var(--amber); font-weight: 700;">TEMPO 3-1-1</span>
            </div>
            <div class="tempo-pacer-box">
              <div style="font-size: 0.78rem; color: var(--text-muted);">Eliminate rushing. Match the visual pulse:</div>
              <div class="tempo-circle" id="tempoCircle">
                <span style="font-size: 1.1rem; font-weight: 800;" id="tempoAction">READY</span>
                <span style="font-size: 0.75rem; font-family: 'JetBrains Mono';" id="tempoSec">0s</span>
              </div>
              <button class="btn-tempo-start" id="btnTempo" onclick="toggleTempoPacer()">
                Start 3-1-1 Tempo Guide
              </button>
            </div>
          </div>

          <!-- Muscle Heatmap Tool Widget -->
          <div class="side-widget">
            <div class="widget-head">
              <div class="widget-title">🧬 Targeted Muscle Heatmap</div>
              <span style="font-size: 0.72rem; color: var(--cyan); font-weight: 700;" id="heatmapMode">TODAY'S ACTIVATION</span>
            </div>
            <div class="heatmap-visual">
              <svg width="180" height="200" viewBox="0 0 100 130">
                <circle cx="50" cy="14" r="8" fill="#1e293b" />
                <rect x="47" y="22" width="6" height="5" fill="#1e293b" />
                <path id="heat-chest" d="M36 28 Q50 36 64 28 L62 42 Q50 48 38 42 Z" fill="#1e293b" />
                <path id="heat-lats" d="M33 28 L30 48 Q50 56 70 48 L67 28 Q50 32 33 28 Z" fill="#1e293b" />
                <rect id="heat-abs" x="42" y="44" width="16" height="20" rx="3" fill="#1e293b" />
                <path id="heat-glutes" d="M38 65 Q50 72 62 65 L66 78 Q50 82 34 78 Z" fill="#1e293b" />
                <path id="heat-quads" d="M38 78 L36 102 L47 100 L48 78 Z" fill="#1e293b" />
                <path id="heat-quads-r" d="M62 78 L64 102 L53 100 L52 78 Z" fill="#1e293b" />
                <rect id="heat-calves" x="38" y="104" width="7" height="18" rx="2" fill="#1e293b" />
                <rect id="heat-calves-r" x="55" y="104" width="7" height="18" rx="2" fill="#1e293b" />
                <circle id="heat-delts-l" cx="30" cy="30" r="5" fill="#1e293b" />
                <circle id="heat-delts-r" cx="70" cy="30" r="5" fill="#1e293b" />
              </svg>
              <div class="heatmap-tags" id="heatmapTagsContainer">
                <span class="muscle-tag mt-active">Quads</span>
                <span class="muscle-tag mt-active">Chest</span>
                <span class="muscle-tag mt-secondary">Core</span>
              </div>
            </div>
          </div>

          <!-- Live Webcam Mirror Widget -->
          <div class="side-widget">
            <div class="widget-head">
              <div class="widget-title">📷 Live Form-Check Mirror</div>
              <span style="font-size: 0.72rem; color: var(--emerald); font-weight: 700;">DIGITAL GYM MIRROR</span>
            </div>
            <div class="mirror-box" id="mirrorContainer">
              <video id="webcamVideo" autoplay playsinline muted></video>
              <div class="mirror-placeholder" id="mirrorPlaceholder">
                Click below to activate your webcam. Use it as a digital gym mirror to check your spine alignment and squat depth in real-time.
              </div>
            </div>
            <button class="btn-mirror-toggle" onclick="toggleWebcam()">
              Toggle Live Camera Mirror
            </button>
          </div>
        </aside>

      </div>
    </main>

  </div>

  <!-- ==========================================
       VIEW: MILESTONES & LEVEL HUB
       ========================================== -->
  <div id="milestonesView" class="app-view">
    <main class="container">
      
      <!-- HERO HUB -->
      <div class="milestone-hub-hero">
        <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
          <div class="milestone-rank-circle">
            <span style="font-size: 1.8rem; font-weight: 900; color: #fff;" id="hubRankLvl">LVL 1</span>
            <span style="font-size: 0.72rem; color: var(--cyan); font-weight: 800; text-transform: uppercase;" id="hubRankTitle">Initiate</span>
          </div>
          <div>
            <h2 style="font-size: 1.6rem; font-weight: 900; margin: 0; background: linear-gradient(135deg, #fff 0%, #cbd5e1 50%, var(--cyan) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
              Trainee Milestone & Tier Hub
            </h2>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; max-width: 550px;">
              28 Unlockable Discipline & Strength Milestones across Habit Streaks, Tonnage, Transformation Photography, and Movement Mastery. Earn XP to ascend through 20 warrior tiers.
            </p>
          </div>
        </div>

        <div style="min-width: 260px; background: rgba(14, 21, 38, 0.75); border: 1px solid rgba(168, 85, 247, 0.35); border-radius: var(--radius-md); padding: 16px;">
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 800; margin-bottom: 6px;">
            <span style="color: var(--amber);">⚡ Experience Points (XP)</span>
            <span id="hubXpFraction" style="color: #fff;">0 / 250 XP</span>
          </div>
          <div class="lvl-bar" style="height: 10px; margin-bottom: 8px;">
            <div class="lvl-fill" id="hubXpFill" style="width: 0%;"></div>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted);">
            <span>Milestones Unlocked: <strong style="color: var(--cyan);" id="hubUnlockedCount">0 / 28</strong></span>
            <span id="hubNextLvlNeeded">250 XP to LVL 2</span>
          </div>
        </div>
      </div>

      <!-- FILTER TABS -->
      <div class="milestone-filters">
        <button class="milestone-filter-btn active" onclick="filterMilestones('all', this)">All Milestones (28)</button>
        <button class="milestone-filter-btn" onclick="filterMilestones('streak', this)">🔥 Habit & Streaks (7)</button>
        <button class="milestone-filter-btn" onclick="filterMilestones('volume', this)">🏋️ Volume & Tonnage (7)</button>
        <button class="milestone-filter-btn" onclick="filterMilestones('photo', this)">📸 Visual & Photos (7)</button>
        <button class="milestone-filter-btn" onclick="filterMilestones('mastery', this)">🏆 Mastery & Form (7)</button>
      </div>

      <!-- 28 HOLOGRAPHIC MILESTONE CARDS GRID -->
      <div class="milestone-cards-grid" id="milestonesGridContainer">
        <!-- Rendered by JavaScript -->
      </div>

    </main>
  </div>

  <!-- ==========================================
       VIEW: WORKOUT PHOTOS & TRANSFORMATION STUDIO
       ========================================== -->
  <div id="photosView" class="app-view">
    <main class="container">
      
      <!-- HERO TRANSFORMATION -->
      <div class="milestone-hub-hero" style="background: linear-gradient(135deg, rgba(56, 189, 248, 0.15) 0%, rgba(16, 185, 129, 0.12) 50%, rgba(20, 31, 58, 0.3) 100%); border-color: rgba(56, 189, 248, 0.35);">
        <div>
          <h2 style="font-size: 1.6rem; font-weight: 900; margin: 0; color: #fff;">
            📸 Workout Photography & Transformation Lab
          </h2>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; max-width: 600px;">
            Document your day-by-day physical evolution. High-resolution photos are stored locally in your browser's private offline database (IndexedDB) with zero external cloud leaks.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button class="btn-photo-action" onclick="openPhotoModal(currentDay)" style="font-size: 0.9rem; padding: 10px 18px;">
            📸 Upload Today's Photo (Day <span id="photoHeroDay">1</span>)
          </button>
        </div>
      </div>

      <!-- BEFORE / AFTER INTERACTIVE COMPARISON SLIDER -->
      <div class="side-widget" style="margin-bottom: 24px;">
        <div class="widget-head">
          <div class="widget-title">⚡ Interactive Before vs. After Split Slider</div>
          <span style="font-size: 0.78rem; color: var(--cyan); font-weight: 700;">DRAG TO REVEAL TRANSFORMATION</span>
        </div>
        
        <div class="ba-slider-container" id="baSliderContainer">
          <!-- After Image (Full width background) -->
          <img class="ba-img-after" id="baImgAfter" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='380' viewBox='0 0 600 380'><rect width='600' height='380' fill='%230f172a'/><text x='50%25' y='50%25' dominant-baseline='middle' text-anchor='middle' fill='%2338bdf8' font-size='20' font-family='sans-serif' font-weight='bold'>Upload workout photos to unlock comparison</text></svg>" alt="After Transformation">
          
          <!-- Before Image (Clipped container) -->
          <div class="ba-before-wrap" id="baBeforeWrap">
            <img class="ba-img-before" id="baImgBefore" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='380' viewBox='0 0 600 380'><rect width='600' height='380' fill='%231e293b'/><text x='50%25' y='50%25' dominant-baseline='middle' text-anchor='middle' fill='%2394a3b8' font-size='20' font-family='sans-serif' font-weight='bold'>Day 1 Baseline</text></svg>" alt="Before Baseline">
          </div>
          
          <!-- Draggable Divider Bar -->
          <div class="ba-slider-bar" id="baSliderBar">
            <div class="ba-slider-knob">◀ ▶</div>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; max-width: 600px; margin: 8px auto 0; font-size: 0.78rem; color: var(--text-muted);">
          <span>Baseline: <strong id="baLabelBefore" style="color: #fff;">Day 1</strong></span>
          <span>Latest: <strong id="baLabelAfter" style="color: var(--cyan);">Pending</strong></span>
        </div>
      </div>

      <!-- GALLERY TIMELINE -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: #fff; margin: 0;">
          🖼️ Timeline Photo Vault (<span id="galleryCount">0 Photos</span>)
        </h3>
        <span style="font-size: 0.78rem; color: var(--text-muted);">High-Fidelity IndexedDB Offline Storage</span>
      </div>

      <div class="photo-gallery-grid" id="photoGalleryGrid">
        <!-- Rendered by JavaScript -->
      </div>

    </main>
  </div>

  <!-- ==========================================
       VIEW: ANALYTICS & STRENGTH INTELLIGENCE
       ========================================== -->
  <div id="analyticsView" class="app-view">
    <main class="container">
      
      <!-- HERO ANALYTICS STATS -->
      <div class="hero-dashboard" style="padding-top: 14px;">
        <div class="hud-card">
          <div class="hud-title">Total Cumulative Tonnage</div>
          <div class="hud-val" id="statTotalVolume" style="color: var(--cyan);">0 kg</div>
          <div class="hud-sub">Mechanical Work Lifted</div>
        </div>
        <div class="hud-card">
          <div class="hud-title">Completed Workouts</div>
          <div class="hud-val" id="statCompletedSessions" style="color: var(--emerald);">0</div>
          <div class="hud-sub">Sessions In The Books</div>
        </div>
        <div class="hud-card">
          <div class="hud-title">Overall Strength Tier</div>
          <div class="hud-val" id="statOverallTier" style="color: var(--amber); font-size: 1.3rem;">Novice</div>
          <div class="hud-sub">Longevity Strength Standard</div>
        </div>
        <div class="hud-card">
          <div class="hud-title">Consistency Rating</div>
          <div class="hud-val" id="statConsistencyRating" style="color: var(--purple);">100%</div>
          <div class="hud-sub">Habit Adherence Score</div>
        </div>
      </div>

      <!-- 1RM & STRENGTH STANDARDS CALCULATOR -->
      <div class="pro-section-card" style="margin-top: 20px;">
        <div class="pro-section-head">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <h2>⚡ 1RM Strength Intelligence & Bodyweight Standards</h2>
            <span style="font-size: 0.75rem; color: var(--cyan); font-weight: 700; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); padding: 4px 10px; border-radius: 6px;">
              Epley & Brzycki Scientific E1RM Engine
            </span>
          </div>
          <p>Determine your true neuromuscular strength capacity. Enter the maximum load and reps achieved to see your Estimated 1-Rep Max (E1RM) and where you rank against global longevity standards for an 82 kg male.</p>
        </div>

        <div style="background: var(--bg-card); padding: 18px; border-radius: var(--radius-md); border: 1px solid var(--border); margin-bottom: 20px;">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px;">
            <div>
              <label style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 6px;">Benchmark Movement</label>
              <select id="calc1rmExercise" style="width: 100%; background: var(--bg-surface); border: 1px solid var(--border); padding: 9px 12px; color: #fff; border-radius: 6px;" onchange="calculate1RM()">
                <option value="pushup">Push-Up / Floor Press (Chest & Triceps)</option>
                <option value="pullup">Pull-Up / Inverted Row (Lats & Biceps)</option>
                <option value="squat">Goblet Squat / Split Squat (Quads & Glutes)</option>
                <option value="deadlift">Romanian Deadlift / Doorframe Row (Posterior Chain)</option>
                <option value="overhead">Overhead Dumbbell/Band Press (Deltoids)</option>
              </select>
            </div>
            <div>
              <label style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 6px;">Weight / Added Load (kg)</label>
              <input type="number" id="calc1rmWeight" min="0" max="250" step="0.5" value="50" style="width: 100%; background: var(--bg-surface); border: 1px solid var(--border); padding: 9px 12px; color: #fff; border-radius: 6px;" oninput="calculate1RM()">
            </div>
            <div>
              <label style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 6px;">Reps Completed (1–15)</label>
              <input type="number" id="calc1rmReps" min="1" max="20" step="1" value="10" style="width: 100%; background: var(--bg-surface); border: 1px solid var(--border); padding: 9px 12px; color: #fff; border-radius: 6px;" oninput="calculate1RM()">
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.06); flex-wrap: wrap; gap: 12px;">
            <div>
              <div style="font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase;">Calculated Estimated 1RM:</div>
              <div style="font-size: 2.2rem; font-weight: 800; color: var(--cyan); font-family: 'JetBrains Mono';" id="calc1rmResult">66.7 kg</div>
            </div>
            <div>
              <div style="font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; margin-bottom: 4px;">Strength Classification:</div>
              <span class="tier-badge-pill tier-intermediate" id="calc1rmBadge">Intermediate (0.8x Bodyweight)</span>
            </div>
            <div>
              <div style="font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase;">Next Tier Requirement:</div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--amber);" id="calc1rmNextTier">+15.3 kg to Advanced</div>
            </div>
          </div>

          <div class="strength-tier-meter" style="margin-top: 16px;">
            <div class="strength-tier-fill" id="calc1rmMeter" style="width: 55%;"></div>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--text-dim); margin-top: 4px;">
            <span>Untrained</span>
            <span>Novice</span>
            <span>Intermediate</span>
            <span>Advanced</span>
            <span>Elite</span>
          </div>
        </div>

        <!-- 4 Core Lifts Standards Matrix -->
        <h3 style="font-size: 1rem; color: #fff; margin: 24px 0 10px;">🏆 82kg Trainee 4-Pillar Strength Standards</h3>
        <div class="strength-grid">
          <div class="strength-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <strong>Floor Press / Push-Up</strong>
              <span class="tier-badge-pill tier-novice">Goal: 82 kg</span>
            </div>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 6px;">Pectoralis, Anterior Deltoid, Triceps. Target: 1.0x Bodyweight for Joint Longevity.</p>
            <div class="strength-tier-meter"><div class="strength-tier-fill" style="width: 65%;"></div></div>
            <div style="font-size: 0.75rem; color: var(--text-dim); display: flex; justify-content: space-between;">
              <span>Novice: 50kg</span><span>Intermediate: 70kg</span><span>Advanced: 95kg</span>
            </div>
          </div>
          <div class="strength-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <strong>Pull-Up / Bodyweight Row</strong>
              <span class="tier-badge-pill tier-intermediate">Goal: 95 kg</span>
            </div>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 6px;">Latissimus Dorsi, Rhomboids, Biceps. Target: 8 Full-Hang Dead-Stop Pull-Ups.</p>
            <div class="strength-tier-meter"><div class="strength-tier-fill" style="width: 50%;"></div></div>
            <div style="font-size: 0.75rem; color: var(--text-dim); display: flex; justify-content: space-between;">
              <span>Novice: 60kg</span><span>Intermediate: 82kg</span><span>Advanced: 105kg</span>
            </div>
          </div>
          <div class="strength-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <strong>Split Squat / Goblet Squat</strong>
              <span class="tier-badge-pill tier-advanced">Goal: 100 kg</span>
            </div>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 6px;">Quadriceps, Glutes, Patellar Tendon. Target: 1.25x Bodyweight.</p>
            <div class="strength-tier-meter"><div class="strength-tier-fill" style="width: 75%;"></div></div>
            <div style="font-size: 0.75rem; color: var(--text-dim); display: flex; justify-content: space-between;">
              <span>Novice: 65kg</span><span>Intermediate: 85kg</span><span>Advanced: 110kg</span>
            </div>
          </div>
          <div class="strength-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <strong>Romanian Deadlift (Hinge)</strong>
              <span class="tier-badge-pill tier-intermediate">Goal: 120 kg</span>
            </div>
